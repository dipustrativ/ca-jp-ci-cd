<?php
/**
 * Copyright © CarpetAvenue. All rights reserved.
 *
 * Lightweight category product grid — visual parity with the reference
 * carpetavenue theme, without its custom modules (ThemeHelper, QtyHelper,
 * DynamicSimilarProducts, Core\URL). Uses only core Catalog APIs.
 *
 * @var $block \Magento\Catalog\Block\Product\ListProduct
 * @var $escaper \Magento\Framework\Escaper
 */
// phpcs:disable Magento2.Templates.ThisInTemplate.FoundThis

use Magento\Catalog\Pricing\Price\FinalPrice;
use Magento\Catalog\Pricing\Price\RegularPrice;

$_productCollection = $block->getLoadedProductCollection();
$_helper = $this->helper(Magento\Catalog\Helper\Output::class);

// "Sold" caption is only meaningful for products that actually manage stock —
// a Manage Stock = No product is never really sold out.
$qtyHelper = $this->helper(CarpetAvenue\Productify\Helper\QtyHelper::class);

// Hover second-image (parity with product widget)
$hoverHelper = $this->helper(CarpetAvenue\Core\Helper\Product::class);
$hoverImageMapper = [];
if ($hoverHelper->isEnableListHoverImage()) {
    // This page's ids only — getAllIds() drops the LIMIT and returns the whole
    // category, so the media-gallery join ran over every product.
    $hoverImageMapper = $hoverHelper->getProductSecondImage(array_keys($_productCollection->getItems()), false);
}
?>
<?php if (!$_productCollection->count()) : ?>
    <div class="message info empty">
        <span><?= $block->escapeHtml(__('We can\'t find products matching the selection.')) ?></span>
    </div>
<?php else : ?>
    <?= $block->getToolbarHtml() ?>
    <?= $block->getAdditionalHtml() ?>
    <?php
    if ($block->getMode() == 'grid') {
        $viewMode = 'grid';
        $imageDisplayArea = 'category_page_grid';
        $showDescription = false;
        $templateType = \Magento\Catalog\Block\Product\ReviewRendererInterface::SHORT_VIEW;
    } else {
        $viewMode = 'list';
        $imageDisplayArea = 'category_page_list';
        $showDescription = true;
        $templateType = \Magento\Catalog\Block\Product\ReviewRendererInterface::FULL_VIEW;
    }
    $pos = $block->getPositioned();
    ?>
    <div class="products wrapper <?= /* @noEscape */ $viewMode ?> products-<?= /* @noEscape */ $viewMode ?>">
        <ol class="products list items product-items">
            <?php /** @var \Magento\Catalog\Model\Product $_product */ ?>
            <?php foreach ($_productCollection as $_product) : ?>
                <li class="item product product-item">
                    <div class="product-item-info" data-container="product-<?= /* @noEscape */ $viewMode ?>">
                        <?php
                        $productImage = $block->getImage($_product, $imageDisplayArea, ['class' => 'product-image-photo']);
                        $productUrl = $_product->getProductUrl();
                        if ($pos != null) {
                            $position = ' style="left:' . $productImage->getWidth() . 'px;'
                                . 'top:' . $productImage->getHeight() . 'px;"';
                        }

                        /* Discount flag — regular vs final price */
                        $_priceInfo = $_product->getPriceInfo();
                        $regularPrice = $_priceInfo->getPrice(RegularPrice::PRICE_CODE)->getAmount()->getValue();
                        $finalPrice = $_priceInfo->getPrice(FinalPrice::PRICE_CODE)->getAmount()->getValue();
                        ?>
                        <?php if ($regularPrice && $regularPrice > $finalPrice) : ?>
                            <?php $discountPercentage = round(100 * (1 - ($finalPrice / $regularPrice)), 0); ?>
                            <div class="product-item__flag--discount"><?= '-' . (int) $discountPercentage . '%' ?></div>
                        <?php endif; ?>

                        <?php $hoverSrc = $hoverImageMapper[$_product->getId()] ?? ''; ?>
                        <a href="<?= $block->escapeUrl($productUrl) ?>"
                           class="product photo product-item-photo<?= $hoverSrc ? ' has-hover-image' : '' ?>"
                           tabindex="-1">
                            <?= $productImage->toHtml() ?>
                            <?php if ($hoverSrc) : ?>
                                <img class="product-image-photo--hover"
                                     src="<?= $block->escapeUrl($hoverSrc) ?>"
                                     loading="lazy" decoding="async" alt="" aria-hidden="true">
                            <?php endif; ?>
                        </a>

                        <div class="product details product-item-details">
                            <strong class="product name product-item-name">
                                <a class="product-item-link"
                                   href="<?= $block->escapeUrl($productUrl) ?>">
                                    <?= /* @noEscape */ $_helper->productAttribute($_product, $_product->getName(), 'name') ?>
                                </a>
                            </strong>

                            <?php
                            // Size line — ∅ for round (shape 20) or square (w == l), else W x L cm
                            $sizeValue = $this->helper(\CarpetAvenue\Productify\Helper\Data::class)->formatSize(
                                $_product->getData('width'),
                                $_product->getData('length'),
                                $_product->getData('shape')
                            );
                            ?>
                            <?php if ($sizeValue) : ?>
                                <div class="size"><?= $block->escapeHtml($sizeValue) ?></div>
                            <?php endif; ?>

                            <?= $block->getReviewsSummaryHtml($_product, $templateType) ?>

                            <?php if ($_product->isSaleable()) : ?>
                                <?= /* @noEscape */ $block->getProductPrice($_product) ?>
                            <?php endif; ?>

                            <?= $block->getProductDetailsHtml($_product) ?>

                            <div class="product-item-inner">
                                <div class="product actions product-item-actions"<?= ($pos && strpos($pos, $viewMode . '-actions')) ? $block->escapeHtmlAttr($position) : '' ?>>
                                    <div data-role="add-to-links"
                                         class="actions-secondary"<?= ($pos && strpos($pos, $viewMode . '-secondary')) ? $block->escapeHtmlAttr($position) : '' ?>>
                                        <?php if ($addToBlock = $block->getChildBlock('addto')) : ?>
                                            <?= $addToBlock->setProduct($_product)->getChildHtml() ?>
                                        <?php endif; ?>
                                    </div>
                                </div>
                            </div>

                            <?php if (!$_product->isSaleable() && $qtyHelper->isManageStock($_product)) : ?>
                                <span class="sold-caption"><?= $block->escapeHtml(__('Sold')) ?></span>
                            <?php endif; ?>
                        </div>
                    </div>
                </li>
            <?php endforeach; ?>
        </ol>
    </div>
    <?= $block->getChildBlock('toolbar')->setIsBottom(true)->toHtml() ?>
    <?php if (!$block->isRedirectToCartEnabled()) : ?>
        <script type="text/x-magento-init">
        {
            "[data-role=tocart-form], .form.map.checkout": {
                "catalogAddToCart": {
                    "product_sku": "<?= $block->escapeJs($_product->getSku()) ?>"
                }
            }
        }
        </script>
    <?php endif; ?>
<?php endif; ?>
