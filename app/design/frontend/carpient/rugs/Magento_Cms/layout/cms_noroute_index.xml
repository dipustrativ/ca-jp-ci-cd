<?xml version="1.0"?>
<!--
/**
 * Copyright © Carpient. All rights reserved.
 *
 * 404 page. Handle is cms_noroute_index (cms/noroute/index) — NOT
 * cms_index_defaultnoroute, which only fires when the configured no-route CMS
 * page is missing or disabled.
 */
-->
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" layout="1column" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceBlock name="page.main.title" remove="true"/>
        <referenceBlock name="breadcrumbs" remove="true"/>
        <!--
            The requested path does not exist, so the language switcher points at
            each store view's home page instead of carrying the dead path over.
        -->
        <referenceBlock name="store_language">
            <arguments>
                <argument name="view_model" xsi:type="object">Carpient\Theme\ViewModel\HomeSwitcherUrlProvider</argument>
            </arguments>
        </referenceBlock>
        <referenceBlock name="store.settings.language">
            <arguments>
                <argument name="view_model" xsi:type="object">Carpient\Theme\ViewModel\HomeSwitcherUrlProvider</argument>
            </arguments>
        </referenceBlock>
        <referenceContainer name="content">
            <!--
                cms_page stays: it is what sets the browser-tab title from the
                per-store-view "no-route" CMS page. Those pages are kept with an
                empty Content field, so the block itself renders nothing and the
                markup below is the whole page.
            -->
            <block class="Magento\Framework\View\Element\Template" name="carpient.notfound" template="Magento_Cms::notfound.phtml"/>
            <!--
                Admin-managed area under the message: create a CMS block with
                identifier "notfound_bottom" (one per store view for other
                languages) and put a widget or anything else in it. Renders
                nothing while that block is missing or disabled.
            -->
            <block class="Magento\Cms\Block\Block" name="carpient.notfound.bottom" after="carpient.notfound">
                <arguments>
                    <argument name="block_id" xsi:type="string">notfound_bottom</argument>
                </arguments>
            </block>
        </referenceContainer>
    </body>
</page>
