 */
// phpcs:disable Magento2.Templates.ThisInTemplate
// phpcs:disable Generic.Files.LineLength.TooLong

$buttonLockManager = $block->getData('button_lock_manager');
$viewModel = $block->getViewModel();
$bannerUrl = $block->getViewFileUrl('images/contact-banner.png');
?>
<div class="carpient-contact">
    <div class="carpient-contact__banner">
        <img class="carpient-contact__banner-img" src="<?= $escaper->escapeUrl($bannerUrl) ?>" alt="" loading="eager" />
        <div class="carpient-contact__banner-inner">
            <h1 class="carpient-contact__title"><?= $escaper->escapeHtml(__('Contact Us')) ?></h1>
        </div>
    </div>

    <div class="carpient-contact__inner">
        <div class="carpient-contact__intro">
            <p><?= $escaper->escapeHtml(__('We are here for you if you need help finding the right rug, need more information about a specific rug, or have anything else rug-related on your mind!')) ?></p>
            <p><?= $escaper->escapeHtml(__('For quick help, we first refer you to our FAQ page, where many common questions are answered.')) ?></p>
            <p><?= $escaper->escapeHtml(__('If you still need help, please fill out this form to reach our customer service. We aim to respond within 24 hours on weekdays.')) ?></p>
        </div>

        <h2 class="carpient-contact__form-title"><?= $escaper->escapeHtml(__('Send a message')) ?></h2>

        <form class="form contact carpient-contact__form"
              action="<?= $escaper->escapeUrl($block->getFormAction()) ?>"
              id="contact-form"
              method="post"
              data-hasrequired="<?= $escaper->escapeHtmlAttr(__('* Required Fields')) ?>"
              data-mage-init='{"validation":{}}'>
            <fieldset class="fieldset">
                <div class="field name required">
                    <label class="label" for="name"><span><?= $escaper->escapeHtml(__('Name')) ?></span></label>
                    <div class="control">
                        <input name="name"
                               id="name"
                               title="<?= $escaper->escapeHtmlAttr(__('Name')) ?>"
                               placeholder="<?= $escaper->escapeHtmlAttr(__('Name')) ?>"
                               value="<?= $escaper->escapeHtmlAttr($viewModel->getUserName()) ?>"
                               class="input-text"
                               type="text"
                               data-validate="{required:true}"/>
                    </div>
                </div>
                <div class="field email required">
                    <label class="label" for="email"><span><?= $escaper->escapeHtml(__('Email')) ?></span></label>
                    <div class="control">
                        <input name="email"
                               id="email"
                               title="<?= $escaper->escapeHtmlAttr(__('Email')) ?>"
                               placeholder="<?= $escaper->escapeHtmlAttr(__('Email')) ?>"
                               value="<?= $escaper->escapeHtmlAttr($viewModel->getUserEmail()) ?>"
                               class="input-text"
                               type="email"
                               data-validate="{required:true, 'validate-email':true}"
                               data-mage-init='{"mage/trim-input":{}}'/>
                    </div>
                </div>
                <div class="field telephone">
                    <label class="label" for="telephone"><span><?= $escaper->escapeHtml(__('Phone')) ?></span></label>
                    <div class="control">
                        <input name="telephone"
                               id="telephone"
                               title="<?= $escaper->escapeHtmlAttr(__('Phone')) ?>"
                               placeholder="<?= $escaper->escapeHtmlAttr(__('Phone')) ?>"
                               value="<?= $escaper->escapeHtmlAttr($viewModel->getUserTelephone()) ?>"
                               class="input-text"
                               type="tel"/>
                    </div>
                </div>
                <div class="field comment required">
                    <label class="label" for="comment"><span><?= $escaper->escapeHtml(__('Message')) ?></span></label>
                    <div class="control">
                        <textarea name="comment"
                                  id="comment"
                                  title="<?= $escaper->escapeHtmlAttr(__('Message')) ?>"
                                  placeholder="<?= $escaper->escapeHtmlAttr(__('Message')) ?>"
                                  class="input-text"
                                  cols="5"
                                  rows="8"
                                  data-validate="{required:true}"><?= $escaper->escapeHtml($viewModel->getUserComment()) ?></textarea>
                    </div>
                </div>
                <?= $block->getChildHtml('form.additional.info') ?>
            </fieldset>
            <div class="actions-toolbar">
                <div class="primary">
                    <input type="hidden" name="hideit" id="hideit" value="" />
                    <button type="submit" title="<?= $escaper->escapeHtmlAttr(__('Send')) ?>" class="action submit primary"
                            id="send2"
                        <?php if ($buttonLockManager?->isDisabled('contact_us_form_submit')): ?>
                            disabled="disabled"
                        <?php endif; ?>>
                        <span><?= $escaper->escapeHtml(__('Send')) ?></span>
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>
<script type="text/x-magento-init">
    {
