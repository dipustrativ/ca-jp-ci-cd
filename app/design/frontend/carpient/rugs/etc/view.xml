<?xml version="1.0"?>
<!--
/**
 * Larger gallery thumbnail so the MagicGallery "Show more" grid (rendered at
 * ~290px) isn't upscaled from 90px and blurred.
 */
-->
<view xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Config/etc/view.xsd">
    <media>
        <images module="Magento_Catalog">
            <image id="product_page_image_small" type="thumbnail">
                <width>350</width>
                <height>350</height>
            </image>
            <!--
                Category grid rug image: natural aspect, no white frame — matches
                carpient.com where each rug fills the card width at its own ratio.
                blank's default (240x300, keep-frame) letterboxes rugs with white
                bars baked into the cached file. frame=false + aspect_ratio keeps
                proportion inside the box; larger box so it stays crisp when the
                card scales it to the full column width.
            -->
            <image id="category_page_grid" type="small_image">
                <!--
                    2x the ~288px display box so cards stay crisp on retina.
                    At 320x420 a tall runner resized to ~213px wide was upscaled
                    on 2x displays and looked blurry.
                -->
                <width>640</width>
                <height>840</height>
                <aspect_ratio>true</aspect_ratio>
                <frame>false</frame>
            </image>
        </images>
    </media>
</view>
