<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <!-- Pass the "cart drawer" setting to the minicart template -->
        <referenceBlock name="minicart">
            <arguments>
                <argument name="cart_config" xsi:type="object">Carpient\Theme\ViewModel\CartConfig</argument>
            </arguments>
        </referenceBlock>
    </body>
</page>
