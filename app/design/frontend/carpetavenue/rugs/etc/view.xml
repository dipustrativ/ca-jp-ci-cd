<view xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Config/etc/view.xsd">
    <media>
        <images module="Magento_Catalog">
            <!-- Cart + minicart cross-sell thumbnail. Matches the reference
                 theme's cart_cross_sell_products-2: frame=false so the rug photo
                 keeps its own aspect ratio instead of being letterboxed into
                 blank's framed 240x300 box. -->
            <image id="cart_cross_sell_products-2" type="small_image">
                <width>365</width>
                <height>280</height>
                <frame>false</frame>
            </image>
            <!-- Related products carousel thumbnails -->
            <image id="related_products_carousel_list" type="thumbnail">
                <width>175</width>
                <height>175</height>
            </image>
            <!-- Portrait rug image on the category product grid (matches reference theme) -->
            <image id="category_page_grid" type="small_image">
                <width>560</width>
                <height>750</height>
            </image>
            <image id="category_page_list" type="small_image">
                <width>560</width>
                <height>750</height>
            </image>
            <!-- Recently-viewed widget. Blank ships 240x300, which gave that grid
                 a squarer image box than every other product card on the site
                 (and a fixed-px padding hack instead of an aspect ratio). Same
                 portrait box as the category grid. -->
            <image id="recently_viewed_products_grid_content_widget" type="small_image">
                <width>560</width>
                <height>750</height>
            </image>
            <!-- Wishlist grid. Core renders the 113px `wishlist_small_image`;
                 carpetavenue.jp uses the same portrait box as the category grid
                 (see Magento_Wishlist/templates/item/column/image.phtml). -->
            <image id="wishlist_thumbnail" type="small_image">
                <width>280</width>
                <height>375</height>
            </image>
            <!-- PDP gallery sizes (matches reference theme; MagicGallery reads product_page_image_medium) -->
            <image id="product_base_image" type="image">
                <width>265</width>
                <height>265</height>
            </image>
            <image id="product_page_image_large" type="image">
                <aspect_ratio>true</aspect_ratio>
                <frame>false</frame>
            </image>
            <image id="product_page_image_medium" type="image">
                <width>1000</width>
                <height>1380</height>
            </image>
            <image id="product_page_image_small" type="thumbnail">
                <width>320</width>
                <height>280</height>
            </image>
            <image id="product_page_main_image" type="image">
                <width>400</width>
                <height>600</height>
            </image>
            <!--
                Colour chips on the PLP tile and the PDP variant selector.
                Declared here — and NOT resized at runtime — because Magento can
                only regenerate a cached derivative whose params come from a
                view.xml entry (ImageResize::getViewImages). A helper call that
                ends in ->resize(w,h) produces a hash nothing can ever recreate:
                once the file is deleted, get.php serves the placeholder forever.

                Stock swatch_image (Magento_Swatches, 30x20) is the wrong aspect
                and far too small for a round chip. These are the dimensions the
                chips have always been built at, so the hash — and therefore every
                URL already stored in carpetavenue_productify_group_product_cache —
                is unchanged; it just becomes regenerable.
            -->
            <image id="productify_variant_swatch" type="swatch_image">
                <width>165</width>
                <height>165</height>
            </image>
        </images>
    </media>
</view>
