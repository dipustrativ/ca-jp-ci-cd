<?xml version="1.0"?>
<!--
/**
 * CMS pages: push breadcrumbs to the end of page.top so they render after the
 * callout widget (the "Flash Sale" all_pages widget also lives in page.top).
 * Without this the default order is breadcrumbs first, callout second — the
 * inverse of every other page. Mirrors catalog_category_view.xml.
 */
-->
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <move element="breadcrumbs" destination="page.top" after="-"/>
    </body>
</page>
