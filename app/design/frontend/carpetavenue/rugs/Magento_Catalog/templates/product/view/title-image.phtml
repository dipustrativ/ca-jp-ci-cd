<?php
/**
 * Category view template
 *
 * @var $block \Magento\Catalog\Block\Category\View
 */

// phpcs:disable Magento2.Templates.ThisInTemplate.FoundThis
// phpcs:disable Magento2.Security.LanguageConstruct.DirectOutput
?>
<?php
$_helper    = $this->helper(Magento\Catalog\Helper\Output::class);
$_category  = $block->getCurrentCategory();

/** @var \CarpetAvenue\Productify\ViewModel\CategoryImages|null $_images */
$_images = $block->getData('category_image_view_model');

// Null whenever the attribute is empty *or* names a file that is no longer in
// pub/media — the banner is then skipped entirely instead of rendering a broken
// image. Mobile falls back to the desktop image when it has none of its own.
$_imgUrl       = $_images !== null ? $_images->getCategoryUrl($_category, 'image') : null;
$_imgMobileUrl = $_images !== null ? $_images->getCategoryUrl($_category, 'mobile_image') : null;
$_imgMobileUrl = $_imgMobileUrl ?? $_imgUrl;

if ($_imgUrl !== null) {
    $_imgHtml = '<div class="category-image cover">'
        . '<picture>'
        . '<source media="(max-width: 767px)" srcset="' . $block->escapeUrl($_imgMobileUrl) . '">'
        . '<img src="'
        . $block->escapeUrl($_imgUrl)
        . '" alt="'
        . $block->escapeHtmlAttr($_category->getName())
        . '" title="'
        . $block->escapeHtmlAttr($_category->getName())
        . '" class="image" />'
        . '</picture>'
        . $block->getChildHtml()
        . '</div>';
    $_imgHtml = $_helper->categoryAttribute($_category, $_imgHtml, 'image');
    /* @noEscape */ echo $_imgHtml;
}
?>
