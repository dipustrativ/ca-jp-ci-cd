<?php
/**
 * Size + SKU line under the product title.
 *
 * ∅ when w == l, else W x L cm — see Data::formatSize
 *
 * @var $block \Magento\Catalog\Block\Product\View
 */
$_product = $block->getProduct();

$sizeValue = $this->helper(\CarpetAvenue\Productify\Helper\Data::class)->formatSize(
    $_product->getData('width'),
    $_product->getData('length'),
    $_product->getData('shape')
);
?>
<div class="size_sku_attribute-wrapper">
    <div class="size-attribute">
        <?= $block->escapeHtml($sizeValue) ?>
    </div>
    <div class="sku-attribute">
        <?= $block->escapeHtml($_product->getSku()) ?>
    </div>
</div>
<style>
    @media (max-width: 800px) {
        .size_sku_attribute-wrapper {
            display: flex;
            justify-content: space-between;
        }
    }
    .size_sku_attribute-wrapper {
        display: flex;
        gap: 50px;
    }

    .sku-attribute {
        font-size: 16px;
        font-weight: 500;
        margin-top: 3px;
    }
</style>
