/** @var \BelVG\GuestWishlist\Block\Wishlist\Item\Column $block */

/** @var \Magento\Wishlist\Model\Item $item */
$item = $block->getItem();
$product = $item->getProduct();

$regularPrice = $product->getPriceInfo()->getPrice(\Magento\Catalog\Pricing\Price\RegularPrice::PRICE_CODE)->getAmount()->getValue();
$finalPrice = $product->getPriceInfo()->getPrice(\Magento\Catalog\Pricing\Price\FinalPrice::PRICE_CODE)->getAmount()->getValue();

if ($regularPrice !== $finalPrice) :
    $discountPercentage = round(100 * (1 - ($finalPrice / $regularPrice)), 0, PHP_ROUND_HALF_UP); ?>
    <div class="product-item__flag--discount"><?= '-' . $block->escapeHtml($discountPercentage) . '%'?></div>
<?php endif; ?>