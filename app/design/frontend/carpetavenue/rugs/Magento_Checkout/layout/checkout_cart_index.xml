<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>

        <!-- Container for elements which needs to break content max-width -->
        <referenceContainer name="page.wrapper">
            <container name="after.main.section"
                       htmlTag="div"
                       htmlClass="content--full-width checkout-cart-index__bottom"
                       after="main.content">
                <container name="after.main.section.container"
                           htmlTag="div"
                           htmlClass="page-main" />
            </container>
        </referenceContainer>

        <!-- Everything that stacks under the cart item list: coupon form, then
             the Trustpilot review list, then the icon-usps trust badges.

             These sit in their own container rather than inside
             checkout.cart.form because the coupon block renders its own
             <form id="discount-coupon-form">, and nested forms are invalid HTML —
             the parser closes .form-cart at that point and everything after it
             spills out of the 65% column (the hidden Clear/Update/Continue
             buttons reappear with it, since their rule is scoped to .form-cart).
             cart.form.after is therefore a sibling of the form, carrying the same
             column width so the blocks still stay inside the left column and
             never span full-width under the sticky cart-summary.

             The coupon needs the move at all because core 2.4.9 nests
             checkout.cart.coupon inside cart.summary, which renders it stacked
             inside the white summary card. Live sits it under the item list:
             Luma adds a cart.discount container and moves the block into it
             (vendor/magento/theme-frontend-luma/Magento_Checkout/layout/checkout_cart_index.xml),
             and we parent Magento/blank so none of that is inherited. The theme's
             .cart-discount LESS was already carried over from live and was dead
             until this container existed to match it. -->
        <referenceContainer name="checkout.cart.container">
            <container name="cart.form.after" htmlTag="div" htmlClass="cart-form-after"
                       after="checkout.cart.form">
                <container name="cart.discount" label="Cart Discount Container"
                           htmlTag="div" htmlClass="cart-discount" />
                <container name="checkout.cart.trustpilot.container"
                           htmlTag="div" htmlClass="cart-trustpilot__wrapper"
                           after="cart.discount">
                    <block class="Magento\Cms\Block\Block" name="trustpilot.cart.horizontal.list">
                        <arguments>
                            <argument xsi:type="string" name="block_id">trustpilot-horizontal-list</argument>
                        </arguments>
                    </block>
                </container>
                <container name="checkout.cart.bottom.container"
                           htmlTag="div" htmlClass="icon-usps__wrapper"
                           after="checkout.cart.trustpilot.container">
                    <block class="Magento\Cms\Block\Block" name="icon.usps">
                        <arguments>
                            <argument xsi:type="string" name="block_id">icon-usps</argument>
                        </arguments>
                    </block>
                </container>
            </container>
        </referenceContainer>
        <move element="checkout.cart.coupon" destination="cart.discount" />

        <!-- Crosssell. Core's Magento_Catalog product/list/items.phtml hardcodes
             the "More Choices:" heading and ignores block_title, so it renders
             the module template instead — same grid, base's heading, the
             dimension line, and no wishlist/compare links. Base sits the block
             under the coupon form inside the left column, not full-width below
             the cart. -->
        <referenceBlock name="checkout.cart.crosssell"
                        template="Evalent_CheckoutModsJP::product/list/cart-crosssell.phtml">
            <arguments>
                <argument xsi:type="string" name="block_title">We recommend the following products:</argument>
                <argument xsi:type="boolean" name="show_cart">true</argument>
            </arguments>
        </referenceBlock>
        <move element="checkout.cart.crosssell" destination="cart.form.after" after="cart.discount"/>

        <!-- NOTE: do not remove="true" this block to hide the "Estimate Shipping
             and Tax" UI. It carries the jsLayout that renders the whole
             block-summary scope, totals included, and cart/shipping.phtml nests
             #block-summary inside #block-shipping — dropping either empties
             .cart-totals and the summary loses every row. The estimate UI is
             hidden in LESS instead; see "Estimate Shipping and Tax" there. -->
        <referenceBlock name="checkout.cart.shipping">
            <container name="checkout.cart.shipping.after"
                       as="after_shipping"
                       label="Shipping Methods After"
                       after="-" />
        </referenceBlock>

        <referenceBlock name="checkout.cart.methods.bottom">
            <container name="checkout.cart.methods.before"
                       as="before_methods"
                       label="Payment Methods Before Checkout Button"
                       before="-" />
        </referenceBlock>

        <referenceBlock name="checkout.cart.empty">
            <container name="shopping.cart.empty.after" as="shopping.cart.table.after" label="Empty Shopping Cart Content After"/>
        </referenceBlock>

        <!-- Remove "Check Out with Multiple Addresses" link -->
        <referenceBlock name="checkout.cart.methods.multishipping" remove="true"/>

        <!-- Remove gift options. This block carries the whole Knockout
             giftOptionsCart component, which renders the per-item
             "Gift Options" (.action-gift) button inside .item-actions as well
             as the order-level form — so dropping it takes the button with it.
             The sales/gift_options/* config does not gate this component, which
             is why the button showed with gift messages left at their default
             off. Live shows no gift options on the cart either. -->
        <referenceBlock name="checkout.cart.order.actions.gift_options" remove="true"/>

    </body>
</page>
