<?xml version="1.0"?>
<!--
/**
 * Copyright © CarpetAvenue. All rights reserved.
 *
 * carpetavenue.jp shows no "Recently Ordered" sidebar block. With wishlist_sidebar
 * already gone (Magento_Theme/layout/default.xml) this empties sidebar.additional on
 * the account pages, so the 40px strip it reserved next to the account nav goes too.
 */
-->
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceBlock name="sale.reorder.sidebar" remove="true"/>
    </body>
</page>
