<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <preference for="Magento\Widget\Block\Adminhtml\Widget\Options" type="Webkul\AjaxContactForm\Block\Widget\Customoptions" />
    <!-- Configure our Logger to use our Handler -->
    <type name="Webkul\AjaxContactForm\Logger\Logger">
        <arguments>
            <argument name="name" xsi:type="string">contactform</argument>
            <argument name="handlers" xsi:type="array">
                <item name="contactform" xsi:type="object">Webkul\AjaxContactForm\Logger\Handler</item>
            </argument>
        </arguments>
    </type>
</config>
