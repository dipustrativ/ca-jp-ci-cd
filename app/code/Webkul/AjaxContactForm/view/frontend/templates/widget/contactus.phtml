$name=$block->getData('name');
$alignment=$block->getData('alignment');
$address=$block->getData('address');
$email=$block->getData('email_to');
$email_to=$block->getData('email_to');
$show_map=$block->getApiVersion();
$customerName = '';
$isShowEmail = $block->isShowEmail();
$customerName = $block->getCustomerName();
$customerEmail = '';
$customerEmail = $block->getCustomerEmail();
if ($show_map == 1) {
    $api=$block->getApiKey();
    $map_coordinates = $block->getApiCoordinate();
    $map_coordinates = explode(',', $map_coordinates);
}
$load_jquery=1;
$show_full_address=$block->getData('show_full_address');
$thanku_msg=$block->getData('thanku_msg');
$mail_url=$block->getAssetUrl('Webkul_AjaxContactForm::mail.php');
$mail_url= $block->getUrl('ajaxcontactform/email/sent', ['_secure' => $block->getRequest()->isSecure()]);
$sentFromStore = $this->getUrl('*/*/*', ['_current' => true, '_use_rewrite' => true]);
$storeCode = $block->getStoreCode();

if ($alignment == 1) {
    $panelid = "panel-left";
    $triggerid = "trigger-left";
} else
    if ($alignment == 2) {
        $panelid = "panel-right";
        $triggerid = "trigger-right";
    } else
        if ($alignment == 3) {
            $panelid = "panel-megamenu";
            $triggerid = "trigger-megamenu";
        } else {
            $panelid = "panel-page";
            $triggerid = "trigger-page";
        }
?>

<?php
$recaptchaSiteKey = $block->getRecaptchaSiteKey();
$recaptchaLang    = $block->getRecaptchaLang() ?: 'en';
$recaptchaText    = $block->getRecaptchaAttribution();
?>

<script src="https://www.google.com/recaptcha/api.js?render=<?= $recaptchaSiteKey ?>&hl=<?= $recaptchaLang ?>"></script>
<script>
    grecaptcha.ready(function() {
        grecaptcha.execute('<?=$block->getRecaptchaSiteKey();?>', {action: 'submit'}).then(function(token) {
            document.getElementById('google-recaptcha-token').value = token;
        });
    });
</script>

<div class="wk-loading-mask-ajax wk-display-none-ajax" id='wk-loading-mask-ajax'>
