                                   id="Username" />
                        </div>
                    </div>
                    <div class="field">
                        <label class="label formtxt"><?= /* @noEscape */ __('Phone Number') ?></label>
                        <div class="control">
                            <input type="tel" class="telephone" name="telephone" id="UserPhone" value="" />
                        </div>
                    </div>
                    <div class="field">
                        <label class="label formtxt"><?= /* @noEscape */ __('Email')?></label>
                        <div class="control">
                            <input type="text" class="email" name="email" id="UserEmail"
                                   value="<?= /* @noEscape */ $customerEmail; ?>" />
                        </div>
                    </div>
                    <div class="field">
                        <label class="label formtxt"><?= /* @noEscape */ __('Comment')?></label>
                        <div class="control">
                            <textarea class="message" id="Usermessage" name="message" placeholder="<?= __("What can we help you with?") ?>"></textarea>
