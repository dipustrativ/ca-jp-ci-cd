<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">

    <!-- ═══════════════════════════════════════════════════════════════════
         Config Scope Hints — flag store-config values overridden at a
         narrower scope. Moved here from CarpetAvenue_Utilities.
         Adminhtml-only: the store-config form is the sole consumer.
         ═══════════════════════════════════════════════════════════════════ -->
    <type name="Magento\Framework\Data\Form\Element\Fieldset">
        <plugin name="carpetavenue_developify_config_scope_hints"
                type="CarpetAvenue\Developify\ConfigScopeHints\Plugin\Framework\Data\Form\Element\Fieldset"
                sortOrder="100"/>
    </type>

    <!-- Cron Manager data source lives in ../di.xml — see the note there. -->

</config>
