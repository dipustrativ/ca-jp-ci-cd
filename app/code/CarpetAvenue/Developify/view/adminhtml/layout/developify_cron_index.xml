<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" layout="admin-1column"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <head>
        <!-- Cron Manager — status badges and summary tiles -->
        <css src="CarpetAvenue_Developify::css/cron.css"/>
    </head>
    <body>
        <referenceContainer name="content">
            <block class="CarpetAvenue\Developify\Block\Adminhtml\Cron\Summary"
                   name="developify_cron_summary"
                   template="CarpetAvenue_Developify::cron/summary.phtml"/>
