<script>
    require(['jquery'], function ($) {
        let originalLogContent = '';

        $('body').addClass('dark-mode');

        window.toggleFolder = function (el) {
            $(el).children('.children').slideToggle();
            event.stopPropagation();
        };

        function highlightLogContent(content) {
            const lines = content.split('\n');
            const highlightedLines = lines.map(line => {
                let className = '';
                const lowerLine = line.toLowerCase();

                if (lowerLine.includes('[error]') || lowerLine.includes('error:') || lowerLine.includes('fatal')) {
                    className = 'log-error';
                } else if (lowerLine.includes('[warning]') || lowerLine.includes('warning:') || lowerLine.includes('warn:')) {
                    className = 'log-warning';
                } else if (lowerLine.includes('[info]') || lowerLine.includes('info:')) {
                    className = 'log-info';
                } else if (lowerLine.includes('[debug]') || lowerLine.includes('debug:')) {
                    className = 'log-debug';
                } else if (lowerLine.includes('[critical]') || lowerLine.includes('critical:') || lowerLine.includes('emergency')) {
                    className = 'log-critical';
                }

                // Highlight timestamps
                const timestampRegex = /(\d{4}-\d{2}-\d{2}\s\d{2}:\d{2}:\d{2})/g;
                let processedLine = line.replace(timestampRegex, '<span class="log-timestamp">$1</span>');

                return className ? `<div class="log-line ${className}">${processedLine}</div>` : `<div class="log-line">${processedLine}</div>`;
            });

            return highlightedLines.join('');
        }

        let currentFilePath = null;
        let currentFileSize = 0;
        let currentOffset = 0;
        let hasMoreLines = false;
        let isLoading = false;

        // Helper function to escape HTML
        function escapeHtml(text) {
            const div = document.createElement('div');
            div.textContent = text;
            return div.innerHTML;
        }

        // Group multi-line log entries (stack traces, arrays, etc.)
        function groupLogLines(content) {
            const lines = content.split('\n');
            const groupedEntries = [];
            let currentEntry = '';
            let isMultiLine = false;

            // Regex to detect log entry start (timestamp patterns)
            const logStartPattern = /^\[(\d{4}-\d{2}-\d{2}[T\s]\d{2}:\d{2}:\d{2})/;

            lines.forEach((line, index) => {
                const trimmedLine = line.trim();

                // Skip empty lines
                if (!trimmedLine && !isMultiLine) {
                    if (currentEntry) {
                        groupedEntries.push(currentEntry);
                        currentEntry = '';
                    }
                    return;
                }

                // Check if this is a new log entry
                const isNewEntry = logStartPattern.test(line);

                if (isNewEntry) {
                    // Save previous entry if exists
                    if (currentEntry) {
                        groupedEntries.push(currentEntry);
                    }
                    // Start new entry
                    currentEntry = line;

                    // Check if this might be a multi-line entry (contains stack trace keywords)
                    isMultiLine = line.includes('Stack trace:') ||
                                 line.includes('exception') ||
                                 line.includes('Exception') ||
                                 line.includes('array (') ||
                                 line.includes('stdClass');
                } else if (currentEntry) {
                    // This is a continuation line
                    // Detect stack trace lines
                    const isStackTrace = /^#\d+\s/.test(trimmedLine) || // #0, #1, etc.
                                       /^\s+at\s/.test(line) ||        // at ...
                                       /^\s+in\s/.test(line) ||        // in ...
                                       /^Caused by:/.test(trimmedLine) ||
                                       /^\s+\[/.test(line) ||          // array elements
                                       /^\s+=>/.test(line) ||          // array arrows
                                       /^\s+\)/.test(line) ||          // closing parens
                                       /^\s+\(/.test(line) ||          // opening parens
                                       /^{/.test(trimmedLine) ||       // JSON start
                                       /^}/.test(trimmedLine) ||       // JSON end
                                       trimmedLine.startsWith("'") ||  // array values
                                       trimmedLine.startsWith('"');    // array values

                    // Append to current entry
                    currentEntry += '\n' + line;

                    // Update multi-line status
                    if (isStackTrace) {
                        isMultiLine = true;
                    }

                    // Check if multi-line entry might be ending
                    if (isMultiLine && !isStackTrace && trimmedLine && !trimmedLine.endsWith(',')) {
                        isMultiLine = false;
                    }
                } else {
                    // No current entry, start a new one with this line
                    currentEntry = line;
                }
            });

            // Don't forget the last entry
            if (currentEntry) {
                groupedEntries.push(currentEntry);
            }

            return groupedEntries;
        }

        // Toggle folder open/close with smooth animation
        window.toggleFolder = function(element) {
            const $folder = $(element);
            const $children = $folder.siblings('.folder-children');

            if ($children.length) {
                // Toggle folder state
                $folder.toggleClass('open');

                // Smooth slide animation
                $children.slideToggle(200);
            }
        };

        window.loadLog = function (path, fileSize, el) {
            if (isLoading) return;

            currentFilePath = path;
            currentFileSize = fileSize || 0;
            currentOffset = 0;
            hasMoreLines = false;

            $('.file').removeClass('active');
            $(el).addClass('active');
            $('#log-actions').show();

            const fileName = $(el).find('.file-name').text().trim();
            const sizeFormatted = $(el).find('.file-size').text().trim();
            const dateFormatted = $(el).find('.file-date').text().trim();

            // Build combined file info HTML
            window.currentFileInfo = {
                fileName: fileName,
                sizeFormatted: sizeFormatted,
                dateFormatted: dateFormatted
            };

            // Show combined view with just file info initially
            let combinedHtml = '';
            combinedHtml += '<span class="info-tag">📄 ' + escapeHtml(fileName) + '</span>';
            if (sizeFormatted) {
                combinedHtml += '<span class="info-tag">💾 ' + escapeHtml(sizeFormatted) + '</span>';
            }
            if (dateFormatted) {
                combinedHtml += '<span class="info-tag">🕒 ' + escapeHtml(dateFormatted) + '</span>';
            }
            $('#file-stats-combined').show().html(combinedHtml);

            // Check if file is larger than 20MB
            if (currentFileSize > 20 * 1024 * 1024) {
                let largeFileHtml = '<span class="info-tag">⚠️ ' + escapeHtml(fileName) + '</span>';
                largeFileHtml += '<span class="info-tag">💾 ' + escapeHtml(sizeFormatted) + '</span>';
                largeFileHtml += '<a href="<?= $block->getUrl("developify/logviewer/download") ?>?path=' + path + '" class="download-large-file" download>⬇ Download</a>';
                $('#file-stats-combined').html(largeFileHtml);
                $('#log-content').text('This file is too large to view directly. Please download it.');
                $('#log-actions').hide();
                $('#load-more-btn').hide();
                return;
            }

            $('#log-content').empty();
            $('#load-more-btn').hide();

            fetchLogContent(path, 0, 1000);
        };

        function fetchLogContent(path, offset, lines) {
            if (isLoading) return;

            isLoading = true;
            const $loadingOverlay = $('#loading-overlay');
            const $progressBar = $('#progress-bar');
            const $loadingText = $('#loading-text');
            const $logContent = $('#log-content');
            const $loadMoreBtn = $('#load-more-btn');

            // Show loading
            $loadingOverlay.show();
            $progressBar.css('width', '10%').text('10%');
            $loadingText.text('Fetching log content...');

            $.ajax({
                url: '<?= $block->getUrl("developify/logviewer/fetch") ?>',
                method: 'POST',
                data: {
                    path: path,
                    offset: offset,
                    lines: lines,
                    form_key: window.FORM_KEY
                },
                xhr: function() {
                    const xhr = new window.XMLHttpRequest();
                    xhr.addEventListener("progress", function(evt) {
                        if (evt.lengthComputable) {
                            const percentComplete = Math.min((evt.loaded / evt.total) * 100, 90);
                            $progressBar.css('width', percentComplete + '%').text(Math.round(percentComplete) + '%');
                        }
                    }, false);
                    return xhr;
                },
                success: function (response) {
                    try {
                        let data;
                        if (typeof response === 'string') {
                            data = JSON.parse(response);
                        } else {
                            data = response;
                        }

                        if (data.error) {
                            // Check if it's a permission error
                            if (data.error.includes('Permission denied') ||
                                data.error.includes('permission') ||
                                data.error.includes('not be opened')) {
                                $logContent.html(`
                                    <div class="permission-error-message">
                                        <strong>🔒 Permission Denied</strong>
                                        <p><strong>File:</strong> ${escapeHtml(fileName)}</p>
                                        <p>${escapeHtml(data.error)}</p>
                                        <p><strong>Possible solutions:</strong></p>
                                        <ul>
                                            <li>Check file permissions: <code>ls -la /var/log/</code></li>
                                            <li>Ensure web server user has read access</li>
                                            <li>Run: <code>chmod 644 ${escapeHtml(fileName)}</code></li>
                                            <li>Or: <code>chown www-data:www-data ${escapeHtml(fileName)}</code></li>
                                            <li>Contact your system administrator for assistance</li>
                                        </ul>
                                    </div>
                                `);
                            } else {
                                $logContent.html(`<div class="permission-error-message"><strong>Error:</strong> ${escapeHtml(data.error)}</div>`);
                            }
                            $loadingOverlay.hide();
                            isLoading = false;
                            return;
                        }

                        // Update progress
                        $progressBar.css('width', '100%').text('100%');
                        $loadingText.text('Processing content...');

                        setTimeout(() => {
                            originalLogContent = data.content;
                            hasMoreLines = data.hasMore || false;
                            currentOffset = data.offset || 0;

                            if (offset === 0) {
                                $logContent.empty();
                            }

                            // Process and display log entries (grouped for multi-line logs)
                            const logEntries = groupLogLines(data.content);
                            logEntries.forEach(entry => {
                                if (entry.trim()) {
                                    const $logLine = createLogLineElement(entry);
                                    $logContent.append($logLine);
                                }
                            });

                            // Show/hide load more button
                            if (hasMoreLines) {
                                $loadMoreBtn.show().prop('disabled', false);
                            } else {
                                $loadMoreBtn.hide();
                            }

                            $('#download-log').data('path', path);
                            $('#delete-log').data('path', path);
                            $('#search-input').val('');

                            // Update statistics
                            updateLogStats();

                            $loadingOverlay.hide();
                            isLoading = false;
                        }, 300);

                    } catch (e) {
                        // Fallback for non-JSON response (old format)
                        originalLogContent = response;
                        const highlightedContent = highlightLogContent(response);
                        $logContent.html(highlightedContent);
                        $('#download-log').data('path', path);
                        $('#delete-log').data('path', path);
                        $('#search-input').val('');
                        $loadingOverlay.hide();
                        isLoading = false;
                    }
                },
                error: function () {
                    alert('Failed to load file.');
                    $loadingOverlay.hide();
                    isLoading = false;
                }
            });
        }

        function createLogLineElement(entry) {
            const $div = $('<div>').addClass('log-line collapsed');

            // Split entry into first line and rest (for multi-line entries)
            const lines = entry.split('\n');
            const firstLine = lines[0];
            const hasMultipleLines = lines.length > 1;

            // Parse log level and timestamp from first line
            const logLevelMatch = firstLine.match(/\[(.*?)\]\s*(\w+)\.(ERROR|WARNING|INFO|DEBUG|CRITICAL)/i);
            let timestamp = '';
            let level = '';
            let message = firstLine;

            if (logLevelMatch) {
                timestamp = logLevelMatch[1];
                level = logLevelMatch[3].toUpperCase();
                message = firstLine.substring(logLevelMatch[0].length).trim();
            }


            // Determine border and background color
            let borderColor = 'transparent';
            let bgColor = 'transparent';

            if (level === 'ERROR') {
                borderColor = '#dc3545';
                bgColor = 'rgba(220, 53, 69, 0.05)';
            } else if (level === 'WARNING') {
                borderColor = '#ffc107';
                bgColor = 'rgba(255, 193, 7, 0.05)';
            } else if (level === 'INFO') {
                borderColor = '#17a2b8';
                bgColor = 'rgba(23, 162, 184, 0.05)';
            } else if (level === 'DEBUG') {
                borderColor = '#28a745';
                bgColor = 'rgba(40, 167, 69, 0.05)';
            } else if (level === 'CRITICAL') {
                borderColor = '#6f1616';
                bgColor = 'rgba(111, 22, 22, 0.1)';
            }

            $div.css({
                'border-left-color': borderColor,
                'background-color': bgColor
            });

            // Create compact summary - single line
            const $summary = $('<div>').addClass('log-summary');
            let summaryHtml = '<span class="collapse-icon">▶</span>';

            // Timestamp first
            if (timestamp) {
                summaryHtml += '<span class="log-timestamp-compact" title="' + $('<div>').text(timestamp).html() + '">' +
                              $('<div>').text(timestamp).html() + '</span>';
            }

            // Then log level badge
            if (level) {
                summaryHtml += '<span class="log-level-badge badge-' + level.toLowerCase() + '">' + level + '</span>';
            }

            // Show preview of first line message + indicator if multi-line
            let displayMessage = message.substring(0, 120);
            if (hasMultipleLines) {
                displayMessage += ' [+' + (lines.length - 1) + ' more lines]';
            } else if (message.length > 120) {
                displayMessage += '...';
            }
            summaryHtml += '<span class="log-message-preview">' + $('<div>').text(displayMessage).html() + '</span>';

            $summary.html(summaryHtml);

            // Create full details view with entire entry (including stack trace) and copy button
            const $details = $('<div>').addClass('log-details');
            const $copyBtn = $('<button>').addClass('log-copy-btn').text('📋 Copy');

            $details.text(entry);
            $details.append($copyBtn);

            // Copy button click handler
            $copyBtn.on('click', function(e) {
                e.stopPropagation(); // Prevent collapse toggle
                const textToCopy = entry;

                // Copy to clipboard
                if (navigator.clipboard && navigator.clipboard.writeText) {
                    navigator.clipboard.writeText(textToCopy).then(() => {
                        $copyBtn.text('✓ Copied!').addClass('copied');
                        setTimeout(() => {
                            $copyBtn.text('📋 Copy').removeClass('copied');
                        }, 2000);
                    }).catch(() => {
                        // Fallback for older browsers
                        fallbackCopy(textToCopy, $copyBtn);
                    });
                } else {
                    // Fallback for older browsers
                    fallbackCopy(textToCopy, $copyBtn);
                }
            });

            $div.append($summary).append($details);

            // Toggle collapse on click
            $div.on('click', function(e) {
                // Don't toggle if clicking the copy button
                if (!$(e.target).hasClass('log-copy-btn')) {
                    $(this).toggleClass('collapsed');
                }
            });

            return $div;
        }

        // Fallback copy function for older browsers
        function fallbackCopy(text, $btn) {
            const $temp = $('<textarea>').val(text).css({
                position: 'absolute',
                left: '-9999px'
            });
            $('body').append($temp);
            $temp.select();
            try {
                document.execCommand('copy');
                $btn.text('✓ Copied!').addClass('copied');
                setTimeout(() => {
                    $btn.text('📋 Copy').removeClass('copied');
                }, 2000);
            } catch (err) {
                $btn.text('✗ Failed');
                setTimeout(() => {
                    $btn.text('📋 Copy');
                }, 2000);
            }
            $temp.remove();
        }

        function updateLogStats() {
            const $logLines = $('#log-content .log-line');
            const stats = {
                total: $logLines.length,
                error: 0,
                warning: 0,
                info: 0,
                debug: 0,
                critical: 0
            };

            $logLines.each(function() {
                const text = $(this).text().toUpperCase();
                if (text.includes('CRITICAL')) stats.critical++;
                else if (text.includes('ERROR')) stats.error++;
                else if (text.includes('WARNING')) stats.warning++;
                else if (text.includes('INFO')) stats.info++;
                else if (text.includes('DEBUG')) stats.debug++;
            });

            // Build file info part
            let combinedHtml = '';
            if (window.currentFileInfo) {
                combinedHtml += '<span class="info-tag">📄 ' + escapeHtml(window.currentFileInfo.fileName) + '</span>';
                if (window.currentFileInfo.sizeFormatted) {
                    combinedHtml += '<span class="info-tag">💾 ' + escapeHtml(window.currentFileInfo.sizeFormatted) + '</span>';
                }
                if (window.currentFileInfo.dateFormatted) {
                    combinedHtml += '<span class="info-tag">🕒 ' + escapeHtml(window.currentFileInfo.dateFormatted) + '</span>';
                }
                combinedHtml += '<span class="separator"></span>';
            }

            // Append stats
            combinedHtml += `
                <span class="stat-card">
                    <span class="stat-number">${stats.total}</span>
                    <span class="stat-label">Lines</span>
                </span>
            `;

            if (stats.critical > 0) {
                combinedHtml += `
                    <span class="stat-card stat-critical">
                        <span class="stat-number">${stats.critical}</span>
                        <span class="stat-label">Critical</span>
                    </span>
                `;
            }

            if (stats.error > 0) {
                combinedHtml += `
                    <span class="stat-card stat-error">
                        <span class="stat-number">${stats.error}</span>
                        <span class="stat-label">Errors</span>
                    </span>
                `;
            }

            if (stats.warning > 0) {
                combinedHtml += `
                    <span class="stat-card stat-warning">
                        <span class="stat-number">${stats.warning}</span>
                        <span class="stat-label">Warnings</span>
                    </span>
                `;
            }

            if (stats.info > 0) {
                combinedHtml += `
                    <span class="stat-card stat-info">
                        <span class="stat-number">${stats.info}</span>
                        <span class="stat-label">Info</span>
                    </span>
                `;
            }

            if (stats.debug > 0) {
                combinedHtml += `
                    <span class="stat-card stat-debug">
                        <span class="stat-number">${stats.debug}</span>
                        <span class="stat-label">Debug</span>
                    </span>
                `;
            }

            $('#file-stats-combined').html(combinedHtml).show();
        }


        window.showPermissionError = function(element, fileName) {
            // Highlight the denied file
            $('.file').removeClass('active');
            $(element).addClass('active');

            // Show permission error message
            $('#log-content').html(`
                <div class="permission-error-message">
                    <strong>🔒 Permission Denied</strong>
                    <p><strong>File:</strong> ${$('<div>').text(fileName).html()}</p>
                    <p>This file cannot be accessed due to permission restrictions.</p>
                    <p><strong>Possible solutions:</strong></p>
                    <ul>
                        <li>Check file permissions: <code>ls -la /var/log/</code></li>
                        <li>Ensure web server user has read access</li>
                        <li>Run: <code>chmod 644 /var/log/${$('<div>').text(fileName).html()}</code></li>
                        <li>Or: <code>chown www-data:www-data /var/log/${$('<div>').text(fileName).html()}</code></li>
                        <li>Contact your system administrator for assistance</li>
                    </ul>
                </div>
            `);

            $('#log-actions').hide();
            $('#file-info').hide();
            $('#log-stats').hide();
            $('#load-more-btn').hide();
        };

        // Load more button handler
        $('#load-more-btn').on('click', function() {
            if (!isLoading && hasMoreLines && currentFilePath) {
                fetchLogContent(currentFilePath, currentOffset, 1000);
            }
        });


        function searchLogs() {
            const searchTerm = $('#search-input').val().toLowerCase();
            const levelFilter = $('#log-level-filter').val();
            const $logLines = $('#log-content .log-line');

            if (!searchTerm && levelFilter === 'all') {
                $logLines.show();
                $logLines.find('.highlight').contents().unwrap();
                return;
            }

            $logLines.each(function() {
                const $line = $(this);
                const text = $line.text().toLowerCase();
                let showLine = true;

                // Apply search filter
                if (searchTerm && !text.includes(searchTerm)) {
                    showLine = false;
                }

                // Apply level filter
                if (levelFilter !== 'all' && showLine) {
                    const hasLevel = text.includes(levelFilter);
                    if (!hasLevel) {
                        showLine = false;
                    }
                }

                if (showLine) {
                    $line.show();
                    // Highlight the search term
                    if (searchTerm) {
                        const html = $line.html();
                        const regex = new RegExp(`(${searchTerm})`, 'gi');
                        const highlighted = html.replace(regex, '<span class="highlight">$1</span>');
                        $line.html(highlighted);
                    }
                    // Auto-expand matching lines
                    $line.removeClass('collapsed');
                } else {
                    $line.hide();
                }
            });
        }

        $('#search-input').on('input', searchLogs);
        $('#log-level-filter').on('change', searchLogs);

        $('#clear-search').on('click', function() {
            $('#search-input').val('');
            $('#log-level-filter').val('all');
            const $logLines = $('#log-content .log-line');
            $logLines.show();
            $logLines.find('.highlight').contents().unwrap();
        });

        $('#expand-all').on('click', function() {
            $('#log-content .log-line').removeClass('collapsed');
        });

        $('#collapse-all').on('click', function() {
            $('#log-content .log-line').addClass('collapsed');
        });

        // Scroll to top button
        const $scrollBtn = $('#scroll-to-top');
        const $logContent = $('#log-content');

        $logContent.on('scroll', function() {
            if ($(this).scrollTop() > 300) {
                $scrollBtn.addClass('show');
            } else {
                $scrollBtn.removeClass('show');
            }
        });

        $scrollBtn.on('click', function() {
            $logContent.animate({ scrollTop: 0 }, 600);
        });

        // Smooth scroll for better UX
        $('#log-content').css('scroll-behavior', 'smooth');

        // Keyboard shortcuts
        $(document).on('keydown', function(e) {
            // Ctrl/Cmd + F for search
            if ((e.ctrlKey || e.metaKey) && e.key === 'f') {
                e.preventDefault();
                $('#search-input').focus();
            }

            // Ctrl/Cmd + E for expand all
            if ((e.ctrlKey || e.metaKey) && e.key === 'e') {
                e.preventDefault();
                $('#expand-all').click();
            }

            // Ctrl/Cmd + C for collapse all (when not selecting text)
            if ((e.ctrlKey || e.metaKey) && e.key === 'c' && !window.getSelection().toString()) {
                e.preventDefault();
                $('#collapse-all').click();
            }

            // Escape to clear search
            if (e.key === 'Escape') {
                $('#search-input').val('').trigger('input');
            }
        });

        // Theme Toggle
        $('#theme-toggle').on('click', function () {
            $('body').toggleClass('dark-mode');

            // Update icon based on mode
            const $icon = $(this).find('.theme-icon');
            if ($('body').hasClass('dark-mode')) {
                $icon.text('☀️'); // Sun icon for light mode switch
            } else {
                $icon.text('🌙'); // Moon icon for dark mode switch
            }
        });

        $('#download-log').on('click', function () {
            const path = $(this).data('path');
            window.location.href = '<?= $block->getUrl("developify/logviewer/download") ?>?path=' + path;
        });

        $('#delete-log').on('click', function () {
            if (!confirm('Delete this log file?')) return;
            const path = $(this).data('path');
            $.post('<?= $block->getUrl("developify/logviewer/delete") ?>', {
                path: path,
                form_key: window.FORM_KEY
            }, function () {
                alert('File deleted.');
                location.reload();
            });
        });
    });
</script>

