        <div id="log-tree">
            <?php
            function renderTree($tree, $level = 0): void
            {
                foreach ($tree as $node) {
                    if ($node['type'] === 'directory') {
                        $indent = $level * 12;
                        $modified = $node['modified'] ?? 0;
                        $modifiedStr = $modified > 0 ? date('M d, H:i', $modified) : '';

                        echo '<div class="folder-container" style="margin-left: ' . $indent . 'px;">';
                        echo '<div class="folder" onclick="toggleFolder(this)">';
                        echo '<span class="folder-header">';
                        echo '<span class="folder-toggle">▶</span>';
                        echo '<span class="folder-icon">📁</span>';
                        echo '<span class="folder-name">' . htmlspecialchars($node['name']) . '</span>';
                        if ($modifiedStr) {
                            echo '<span class="folder-date">' . htmlspecialchars($modifiedStr) . '</span>';
                        }
                        echo '</span>';
                        echo '</div>';
                        echo '<div class="folder-children" style="display:none;">';
                        renderTree($node['children'], $level + 1);
                        echo '</div>';
                        echo '</div>';
                    } elseif ($node['type'] === 'file') {
                        $path = base64_encode($node['path']);
                        $size = $node['size'] ?? 0;
                        $sizeFormatted = $node['size_formatted'] ?? '0 B';
                        $sizeClass = $size > 20 * 1024 * 1024 ? 'file-large' : '';
                        $isReadable = $node['readable'] ?? true;
                        $error = $node['error'] ?? null;
                        $modified = $node['modified'] ?? 0;
                        $modifiedStr = $modified > 0 ? date('M d, H:i', $modified) : '';

                        // Get file icon based on extension
                        $extension = pathinfo($node['name'], PATHINFO_EXTENSION);
                        $icon = match($extension) {
                            'log' => '📋',
                            'txt' => '📄',
                            'xml' => '📰',
                            'json' => '🗂️',
                            'csv' => '📊',
                            default => '📄'
                        };

                        // Add warning class if not readable
                        $fileClass = $isReadable ? 'file' : 'file file-permission-denied';
                        $onClickHandler = $isReadable
                            ? "event.stopPropagation();loadLog('$path', $size, this)"
                            : "event.stopPropagation();showPermissionError(this, '" . htmlspecialchars($node['name']) . "')";

                        $indent = $level * 12;
                        echo '<div class="file-container" style="margin-left: ' . $indent . 'px;">';
                        echo '<div class="' . $fileClass . '" onclick="' . $onClickHandler . '">';
                        echo '<span class="file-name-wrapper" data-fullname="' . htmlspecialchars($node['name']) . '">';
                        echo '<span class="file-icon">' . $icon . '</span>';
                        echo '<span class="file-name">' . htmlspecialchars($node['name']) . '</span>';
                        if (!$isReadable) {
                            echo '<span class="permission-warning-badge" title="Permission Denied">🔒</span>';
                        }
                        echo '</span>';
                        echo '<span class="file-size ' . $sizeClass . '">' . htmlspecialchars($sizeFormatted) . '</span>';
                        if ($modifiedStr) {
                            echo '<span class="file-date">' . htmlspecialchars($modifiedStr) . '</span>';
                        }
                        echo '</div>';
                        echo '</div>';
                    }
                }
            }

            foreach ($logTree as $dir => $tree) {
                echo '<div class="root-directory">';
                echo '<div class="root-header">';
                echo '<span class="folder-icon">📂</span>';
                echo '<span class="root-name">' . htmlspecialchars($dir) . '</span>';
                echo '</div>';
                renderTree($tree, 0);
                echo '</div>';
            }
            ?>
