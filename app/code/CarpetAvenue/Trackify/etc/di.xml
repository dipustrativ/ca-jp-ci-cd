 *
 * Mid-funnel checkout tracking: add_shipping_info, add_payment_info and select_promotion.
 *
 * GLOBAL on purpose, not etc/frontend. Every one of these is reached over the REST API by
 * the storefront's checkout JS (Mageplaza OSC included), and REST runs in the webapi_rest
 * area — a plugin declared under etc/frontend would simply never execute.
 *
 * Each target is the CONCRETE class rather than its interface, because the guest variants
 * (GuestShippingInformationManagement, GuestPaymentMethodManagement, GuestCouponManagement)
 * resolve the masked cart id and then delegate straight into these, so binding here covers
 * guests and logged-in customers with one plugin apiece.
 *
 * @category  Marketing
 * @package   CarpetAvenue_Trackify
 * @copyright Copyright (c) carpetavenue.com (https://carpetavenue.com)
 * @author    Strativ Magento Team
 */
-->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <!-- add_shipping_info. Mageplaza OSC calls this from CheckoutManagement::saveCheckoutInformation. -->
    <type name="Magento\Checkout\Model\ShippingInformationManagement">
        <plugin name="carpetavenue_trackify_add_shipping_info"
                type="CarpetAvenue\Trackify\Plugin\Checkout\ShippingInformation"
                sortOrder="100"/>
    </type>
    <!-- add_payment_info. Also reached a second time by savePaymentInformation() at
         place-order, which is why the plugin de-duplicates on the method code. -->
    <type name="Magento\Quote\Model\PaymentMethodManagement">
        <plugin name="carpetavenue_trackify_add_payment_info"
                type="CarpetAvenue\Trackify\Plugin\Checkout\PaymentMethod"
                sortOrder="100"/>
    </type>
    <!-- select_promotion, checkout side. The cart page uses a different path entirely and
         is handled by Observer\ApplyCouponCart in etc/frontend/events.xml. -->
    <type name="Magento\Quote\Model\CouponManagement">
        <plugin name="carpetavenue_trackify_select_promotion"
                type="CarpetAvenue\Trackify\Plugin\Quote\Coupon"
                sortOrder="100"/>
    </type>
</config>
