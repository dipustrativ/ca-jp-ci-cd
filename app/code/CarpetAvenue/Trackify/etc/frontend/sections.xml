<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Customer:etc/sections.xsd">
    <action name="checkout/cart/add">
        <section name="trackify"/>
    </action>
    <action name="checkout/cart/delete">
        <section name="trackify"/>
    </action>
    <action name="checkout/cart/updatePost">
        <section name="trackify"/>
    </action>
    <action name="checkout/sidebar/removeItem">
        <section name="trackify"/>
    </action>
    <action name="checkout/sidebar/updateItemQty">
        <section name="trackify"/>
    </action>
    <action name="wishlist/index/add">
        <section name="trackify"/>
    </action>
    <action name="guestwishlist/index/add">
        <section name="trackify"/>
    </action>
    <action name="wishlist/index/remove">
        <section name="trackify"/>
    </action>
    <action name="guestwishlist/index/remove">
        <section name="trackify"/>
    </action>
    <action name="guestwishlist/index/removeProduct">
        <section name="trackify"/>
    </action>
    <!-- Moving a wishlist item to the cart deletes the wishlist row, so these carry both
         a remove_from_wishlist and an add_to_cart. -->
    <action name="wishlist/index/cart">
        <section name="trackify"/>
    </action>
    <action name="wishlist/index/allcart">
        <section name="trackify"/>
    </action>
    <action name="guestwishlist/index/cart">
        <section name="trackify"/>
    </action>
    <action name="guestwishlist/index/allcart">
        <section name="trackify"/>
    </action>
    <!-- Cart-page coupon form (full POST + redirect). -->
    <action name="checkout/cart/couponPost">
        <section name="trackify"/>
    </action>
    <!-- Checkout is driven entirely over REST, so the mid-funnel steps have to invalidate
         on the REST routes rather than on controller actions. Wildcards are how Magento
         matches these client-side (Magento_Customer/js/section-config); Mageplaza OSC's
         own sections.xml uses the same form. -->
    <action name="rest/*/V1/carts/*/coupons/*">
        <section name="trackify"/>
    </action>
    <action name="rest/*/V1/guest-carts/*/coupons/*">
        <section name="trackify"/>
    </action>
    <action name="rest/*/V1/carts/*/shipping-information">
        <section name="trackify"/>
    </action>
    <action name="rest/*/V1/guest-carts/*/shipping-information">
        <section name="trackify"/>
    </action>
    <action name="rest/*/V1/carts/*/selected-payment-method">
        <section name="trackify"/>
    </action>
    <action name="rest/*/V1/guest-carts/*/selected-payment-method">
        <section name="trackify"/>
    </action>
    <!-- Mageplaza OSC's own route; it calls saveAddressInformation() internally. -->
    <action name="rest/*/V1/carts/*/checkout-information">
        <section name="trackify"/>
    </action>
    <action name="rest/*/V1/guest-carts/*/checkout-information">
        <section name="trackify"/>
    </action>
    <action name="customer/account/loginPost">
        <section name="trackify"/>
    </action>
    <action name="customer/account/logout">
        <section name="trackify"/>
    </action>
    <action name="customer/ajax/login">
        <section name="trackify"/>
    </action>
</config>
