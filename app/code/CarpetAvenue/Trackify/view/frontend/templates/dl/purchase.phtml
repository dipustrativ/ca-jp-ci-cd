/**
 * GA4 purchase. The blob re-renders on every success-page load, so datalayer.js keeps a
 * per-transaction sessionStorage guard — a reload must not book a second purchase.
 *
 * Mageplaza OSC delegates to this same stock checkout_onepage_success handle, so no
 * OSC-specific variant is needed.
 *
 * @var Magento\Framework\View\Element\Template $block
 * @var CarpetAvenue\Trackify\ViewModel\Checkout $viewModel
 */

$viewModel = $block->getData('trackify_view_model');
$payload = $viewModel->getPurchasePayload();

if (!$payload) {
    return;
}
?>
<script type="application/json" class="trackify-dl"><?= /* @noEscape */ $viewModel->toJson($payload) ?></script>
