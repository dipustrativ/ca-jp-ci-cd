<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceBlock name="search_result_list">
            <block class="Magento\Framework\View\Element\Template"
                   name="trackify.item.list.search"
                   as="trackify.item.list"
                   template="CarpetAvenue_Trackify::dl/item_list.phtml">
                <arguments>
                    <argument name="trackify_view_model" xsi:type="object">CarpetAvenue\Trackify\ViewModel\DataLayer</argument>
                    <argument name="list_id" xsi:type="string">search_results</argument>
                    <argument name="list_name" xsi:type="string" translate="true">Search Results</argument>
                </arguments>
            </block>
        </referenceBlock>
    </body>
</page>
