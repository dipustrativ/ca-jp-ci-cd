<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">

    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">carpetavenue_japan_price_action_listing.carpetavenue_japan_price_action_listing_data_source</item>
        </item>
    </argument>

    <settings>
        <deps>
            <dep>carpetavenue_japan_price_action_listing.carpetavenue_japan_price_action_listing_data_source</dep>
        </deps>
        <spinner>carpetavenue_japan_price_action_listing_columns</spinner>
    </settings>

    <dataSource name="carpetavenue_japan_price_action_listing_data_source" component="Magento_Ui/js/grid/provider">
        <settings>
            <updateUrl path="mui/index/render"/>
            <storageConfig>
                <param name="indexField" xsi:type="string">log_id</param>
            </storageConfig>
        </settings>
        <aclResource>CarpetAvenue_Japan::price_action_log</aclResource>
        <dataProvider name="carpetavenue_japan_price_action_listing_data_source"
                      class="Magento\Framework\View\Element\UiComponent\DataProvider\DataProvider">
            <settings>
                <requestFieldName>log_id</requestFieldName>
                <primaryFieldName>log_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>

    <listingToolbar name="listing_top">
        <settings>
            <sticky>true</sticky>
        </settings>
        <bookmark name="bookmarks"/>
        <columnsControls name="columns_controls"/>
        <filters name="listing_filters"/>
        <paging name="listing_paging"/>
        <exportButton name="export_button"/>
    </listingToolbar>

    <columns name="carpetavenue_japan_price_action_listing_columns">
        <column name="log_id">
            <settings>
                <label translate="true">ID</label>
                <filter>textRange</filter>
                <sorting>desc</sorting>
            </settings>
        </column>
        <column name="created_at" class="Magento\Ui\Component\Listing\Columns\Date" component="Magento_Ui/js/grid/columns/date">
            <settings>
                <label translate="true">When</label>
                <filter>dateRange</filter>
                <dataType>date</dataType>
            </settings>
        </column>
        <column name="rule_code" component="Magento_Ui/js/grid/columns/select">
            <argument name="data" xsi:type="array">
                <item name="options" xsi:type="object">CarpetAvenue\Japan\Model\Source\PriceAction\RuleCode</item>
            </argument>
            <settings>
                <label translate="true">Rule</label>
                <filter>select</filter>
                <dataType>select</dataType>
            </settings>
        </column>
        <column name="attribute_code">
            <settings>
                <label translate="true">Attribute</label>
                <filter>text</filter>
            </settings>
        </column>
        <column name="sku">
            <settings>
                <label translate="true">SKU</label>
                <filter>text</filter>
            </settings>
        </column>
        <column name="product_id">
            <settings>
                <label translate="true">Product ID</label>
                <filter>textRange</filter>
            </settings>
        </column>
        <column name="action" component="Magento_Ui/js/grid/columns/select">
            <argument name="data" xsi:type="array">
                <item name="options" xsi:type="object">CarpetAvenue\Japan\Model\Source\PriceAction\ActionType</item>
            </argument>
            <settings>
                <label translate="true">What Happened</label>
                <filter>select</filter>
                <dataType>select</dataType>
            </settings>
        </column>
        <column name="reason" component="Magento_Ui/js/grid/columns/select">
            <argument name="data" xsi:type="array">
                <item name="options" xsi:type="object">CarpetAvenue\Japan\Model\Source\PriceAction\ReasonCode</item>
            </argument>
            <settings>
                <label translate="true">Why</label>
                <filter>select</filter>
                <dataType>select</dataType>
            </settings>
        </column>
        <column name="old_value" class="Magento\Ui\Component\Listing\Columns\Column">
            <settings>
                <label translate="true">Special Price Before</label>
                <filter>textRange</filter>
            </settings>
        </column>
        <column name="new_value" class="Magento\Ui\Component\Listing\Columns\Column">
            <settings>
                <label translate="true">Special Price After</label>
                <filter>textRange</filter>
            </settings>
        </column>
        <column name="threshold_value" class="Magento\Ui\Component\Listing\Columns\Column">
            <settings>
                <label translate="true">Minimum Allowed</label>
                <filter>textRange</filter>
            </settings>
        </column>
        <column name="basis_value" class="Magento\Ui\Component\Listing\Columns\Column">
            <settings>
                <label translate="true">Cost Used</label>
                <filter>textRange</filter>
            </settings>
        </column>
        <column name="price" class="Magento\Ui\Component\Listing\Columns\Column">
            <settings>
                <label translate="true">Regular Price</label>
                <filter>textRange</filter>
            </settings>
        </column>
        <column name="owner">
            <settings>
                <label translate="true">Owner</label>
                <filter>text</filter>
            </settings>
        </column>
        <column name="dry_run" component="Magento_Ui/js/grid/columns/select">
            <argument name="data" xsi:type="array">
                <item name="options" xsi:type="object">Magento\Config\Model\Config\Source\Yesno</item>
            </argument>
            <settings>
                <label translate="true">Dry Run</label>
                <filter>select</filter>
                <dataType>select</dataType>
            </settings>
        </column>
        <column name="store_id">
            <settings>
                <label translate="true">Store ID</label>
                <filter>textRange</filter>
                <visible>false</visible>
            </settings>
        </column>
        <column name="run_id">
            <settings>
                <label translate="true">Run</label>
                <filter>text</filter>
                <visible>false</visible>
            </settings>
        </column>
        <column name="message">
            <settings>
                <label translate="true">Detail</label>
                <filter>text</filter>
                <visible>false</visible>
            </settings>
        </column>
    </columns>
</listing>
