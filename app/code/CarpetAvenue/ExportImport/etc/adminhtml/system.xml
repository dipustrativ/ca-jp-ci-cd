<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <section id="exportimport" translate="label" sortOrder="500" showInDefault="1"
                 showInWebsite="0" showInStore="0">
            <label>Order Export / Import</label>
            <tab>carpetavenue</tab>
            <resource>CarpetAvenue_ExportImport::exportimport</resource>
            <group id="general" translate="label" sortOrder="10" showInDefault="1"
                   showInWebsite="0" showInStore="0">
                <label>General</label>
                <field id="enabled" translate="label comment" type="select" sortOrder="10"
                       showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Enable Export / Import</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>Master switch. When off, admin pages and CLI commands refuse to run.</comment>
                </field>
                <field id="batch_size" translate="label comment" type="text" sortOrder="20"
                       showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Import Batch Size</label>
                    <comment>Number of orders committed per batch during import.</comment>
                    <validate>validate-digits validate-greater-than-zero</validate>
                </field>
                <field id="sync_order_totals" translate="label comment" type="select" sortOrder="30"
                       showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Sync Order Totals After Document Import</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment><![CDATA[After importing documents, recompute the figures the parent order derives
                        from them: Total Invoiced / Total Paid / Total Refunded and the per-item invoiced and
                        refunded quantities after invoices and credit memos, the per-item shipped quantities after
                        shipments. Leave on: with it off, an imported invoice leaves the order showing Total Paid 0
                        and an imported shipment leaves every item showing 0 shipped. Turn it off only when the
                        order CSV is the authority for those figures.]]></comment>
                </field>
            </group>
        </section>
    </system>
</config>
