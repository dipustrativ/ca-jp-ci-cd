<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">carpetavenue_feedexport_log_listing.carpetavenue_feedexport_log_listing_data_source</item>
        </item>
    </argument>
    <settings>
        <deps>
            <dep>carpetavenue_feedexport_log_listing.carpetavenue_feedexport_log_listing_data_source</dep>
        </deps>
        <spinner>carpetavenue_feedexport_log_columns</spinner>
    </settings>
    <dataSource name="carpetavenue_feedexport_log_listing_data_source" component="Magento_Ui/js/grid/provider">
        <settings>
            <updateUrl path="mui/index/render"/>
            <storageConfig>
                <param name="indexField" xsi:type="string">log_id</param>
            </storageConfig>
        </settings>
        <aclResource>CarpetAvenue_FeedExport::log</aclResource>
        <dataProvider name="carpetavenue_feedexport_log_listing_data_source"
                      class="Magento\Framework\View\Element\UiComponent\DataProvider\DataProvider">
            <settings>
                <requestFieldName>log_id</requestFieldName>
                <primaryFieldName>log_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>
    <listingToolbar name="listing_top">
        <settings>
            <sticky>true</sticky>
        </settings>
        <bookmark name="bookmarks"/>
        <columnsControls name="columns_controls"/>
        <filters name="listing_filters"/>
        <paging name="listing_paging"/>
    </listingToolbar>
    <columns name="carpetavenue_feedexport_log_columns">
        <column name="log_id">
            <settings>
                <label translate="true">ID</label>
                <filter>textRange</filter>
                <sorting>desc</sorting>
            </settings>
        </column>
        <column name="created_at" class="Magento\Ui\Component\Listing\Columns\Date"
                component="Magento_Ui/js/grid/columns/date">
            <settings>
                <label translate="true">Started</label>
                <filter>dateRange</filter>
                <dataType>date</dataType>
            </settings>
        </column>
        <column name="profile_id" component="Magento_Ui/js/grid/columns/select">
            <settings>
                <options class="CarpetAvenue\FeedExport\Model\Source\Profile"/>
                <label translate="true">Profile</label>
                <filter>select</filter>
                <dataType>select</dataType>
            </settings>
        </column>
        <column name="trigger_type" component="Magento_Ui/js/grid/columns/select">
            <settings>
                <options class="CarpetAvenue\FeedExport\Model\Source\Trigger"/>
                <label translate="true">Trigger</label>
                <filter>select</filter>
                <dataType>select</dataType>
            </settings>
        </column>
        <column name="status" component="Magento_Ui/js/grid/columns/select">
            <settings>
                <options class="CarpetAvenue\FeedExport\Model\Source\LogStatus"/>
                <label translate="true">Status</label>
                <filter>select</filter>
                <dataType>select</dataType>
            </settings>
        </column>
        <column name="records_exported">
            <settings>
                <label translate="true">Products</label>
                <filter>textRange</filter>
            </settings>
        </column>
        <column name="duration">
            <settings>
                <label translate="true">Duration (s)</label>
                <filter>textRange</filter>
            </settings>
        </column>
        <column name="files">
            <settings>
                <label translate="true">Files</label>
                <filter>text</filter>
            </settings>
        </column>
        <column name="message">
            <settings>
                <label translate="true">Message</label>
                <filter>text</filter>
            </settings>
        </column>
    </columns>
</listing>
