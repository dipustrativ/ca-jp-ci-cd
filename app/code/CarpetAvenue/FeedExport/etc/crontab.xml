<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Cron:etc/crontab.xsd">
    <group id="carpetavenue_feedexport">
        <!-- Ticks every minute; each profile's own cron expression decides if it runs. -->
        <job name="carpetavenue_feedexport_scheduler" instance="CarpetAvenue\FeedExport\Cron\RunScheduledProfiles"
             method="execute">
            <schedule>* * * * *</schedule>
        </job>
        <job name="carpetavenue_feedexport_log_cleanup" instance="CarpetAvenue\FeedExport\Cron\CleanLog"
             method="execute">
            <schedule>30 3 * * *</schedule>
        </job>
    </group>
</config>
