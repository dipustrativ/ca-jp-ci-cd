<?xml version="1.0"?>
<!--
/**
 * Copyright © CarpetAvenue. All rights reserved.
 *
 * Whitelist the Trustpilot widget bootstrap script + the review iframe/assets it
 * injects, so Magento CSP does not block the home-page and footer Trustpilot widgets.
 */
-->
<csp_whitelist xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Csp:etc/csp_whitelist.xsd">
    <policies>
        <policy id="script-src">
            <values>
                <value id="trustpilot-widget" type="host">*.trustpilot.com</value>
            </values>
        </policy>
        <policy id="frame-src">
            <values>
                <value id="trustpilot-widget" type="host">*.trustpilot.com</value>
            </values>
        </policy>
        <policy id="child-src">
            <values>
                <value id="trustpilot-widget" type="host">*.trustpilot.com</value>
            </values>
        </policy>
        <policy id="img-src">
            <values>
                <value id="trustpilot-widget" type="host">*.trustpilot.com</value>
            </values>
        </policy>
        <policy id="style-src">
            <values>
                <value id="trustpilot-widget" type="host">*.trustpilot.com</value>
            </values>
        </policy>
        <policy id="connect-src">
            <values>
                <value id="trustpilot-widget" type="host">*.trustpilot.com</value>
            </values>
        </policy>
    </policies>
</csp_whitelist>
