<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Module/etc/module.xsd">
    <module name="CarpetAvenue_Productify" setup_version="1.0.1">
        <sequence>
            <module name="CarpetAvenue_Core"/>
            <!-- Catalog surface for the merged EnhanceCategory / ProductStatus /
                 LayeredNavigation / AjaxScroll features. Every plugin, preference
                 and filter-list override below targets one of these. -->
            <module name="Magento_Catalog"/>
            <module name="Magento_CatalogSearch"/>
            <module name="Magento_LayeredNavigation"/>
            <module name="Magento_CatalogInventory"/>
            <module name="Magento_InventorySales"/>
            <module name="Magento_InventoryCatalog"/>
            <module name="Magento_InventoryIndexer"/>
        </sequence>
    </module>
</config>
