<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Cron:etc/crontab.xsd">
    <group id="default">
        <job name="productify_product_indexer_view" instance="CarpetAvenue\Productify\Cron\ProcessView" method="execute">
            <schedule>*/1 * * * *</schedule>
        </job>
        <job name="productify_product_indexer_queue_process" instance="CarpetAvenue\Productify\Cron\ProcessQueue" method="execute">
            <schedule>*/2 * * * *</schedule>
        </job>
        <job name="carpetavenue_productify_queue_maintenance" instance="CarpetAvenue\Productify\Cron\QueueMaintenance" method="execute">
            <schedule>*/15 * * * *</schedule>
        </job>
        <!-- Discounts can start or stop by date with nobody touching the
             product, so the on-sale flag is recomputed on a timer. -->
        <job name="carpetavenue_productify_update_on_sale_flag" instance="CarpetAvenue\Productify\Cron\UpdateOnSaleFlag" method="execute">
            <schedule>0 * * * *</schedule>
        </job>
        <job name="carpetavenue_productify_campaign_cache_clean" instance="CarpetAvenue\Productify\Cron\CampaignCacheClean" method="execute">
            <schedule>1 * * * *</schedule>
        </job>
        <!-- Campaigns roll over by date with nobody touching a widget, so the
             Google Sheet is re-read hourly. Runs after the cache-clean job. -->
        <job name="carpetavenue_productify_campaign_import" instance="CarpetAvenue\Productify\Cron\CampaignImport" method="execute">
            <schedule>5 * * * *</schedule>
        </job>
        <job name="carpetavenue_productify_generate_missing_urls" instance="CarpetAvenue\Productify\Cron\GenerateMissingUrls" method="execute">
            <schedule>*/10 * * * *</schedule>
        </job>
        <job name="carpetavenue_productify_assign_color_shape_category" instance="CarpetAvenue\Productify\Cron\AssignColorShapeCategories" method="execute">
            <schedule>30 3 * * *</schedule>
        </job>
    </group>

    <!-- TODO: both omnibus maintenance jobs are disabled — CarpetAvenue\Productify\Cron\PruneEvents
         and CarpetAvenue\Productify\Cron\RefreshAgedOut do not exist in Cron/, so cron logged
         "Class does not exist" on every run. The tables they maintain
         (carpetavenue_productify_omni_price_event, carpetavenue_productify_omni_lowest) and
         Model/ResourceModel/Lowest.php are present, so only the two cron classes are missing.
         Until they land, price events are never pruned and aged-out lowest snapshots are never
         refreshed.

    Prune old events (> 40 days) to keep the table tiny
    <group id="default">
        <job name="productify_omni_prune_events" instance="CarpetAvenue\Productify\Cron\PruneEvents" method="execute">
            <schedule>10 0 * * *</schedule>
        </job>

        Refresh snapshots whose minimum may have aged out of the 30d window
        <job name="productify_omni_refresh_aged_out" instance="CarpetAvenue\Productify\Cron\RefreshAgedOut" method="execute">
            <schedule>*/15 * * * *</schedule>
        </job>
    </group>
    -->
</config>