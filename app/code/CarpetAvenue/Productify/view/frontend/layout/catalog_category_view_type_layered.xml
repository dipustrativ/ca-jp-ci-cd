<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <!-- Quick-pick presets under the price and size sliders, rendered by the
             theme's layer/view.phtml. Ported from carpetavenue.jp's CarpetFinder. -->
        <referenceBlock name="catalog.leftnav">
            <arguments>
                <argument name="filter_presets_view_model" xsi:type="object">CarpetAvenue\Productify\LayeredNavigation\ViewModel\FilterPresets</argument>
            </arguments>
        </referenceBlock>
        <referenceBlock name="catalog.navigation.renderer" template="CarpetAvenue_Productify::layer/filter.phtml">
            <arguments>
                <argument name="category_image_view_model" xsi:type="object">CarpetAvenue\Productify\ViewModel\CategoryImages</argument>
            </arguments>
        </referenceBlock>
        <referenceBlock name="catalog.navigation.state" template="CarpetAvenue_Productify::layer/state.phtml">
            <arguments>
                <argument name="category_image_view_model" xsi:type="object">CarpetAvenue\Productify\ViewModel\CategoryImages</argument>
            </arguments>
        </referenceBlock>
        <!-- Applied-filter count for the mobile filter button's badge (see the
             theme's product/list/toolbar.phtml). Only wired on the layered
             handles, so listings without filters render no badge. -->
        <referenceBlock name="product_list_toolbar">
            <arguments>
                <argument name="filter_config" xsi:type="object">CarpetAvenue\Productify\LayeredNavigation\ViewModel\FilterConfig</argument>
            </arguments>
        </referenceBlock>
        <referenceContainer name="before.body.end">
            <block class="Magento\Framework\View\Element\Template" name="carpetavenue.layerednav.ajax" template="CarpetAvenue_Productify::ajax/init.phtml">
                <arguments>
                    <argument name="filter_config" xsi:type="object">CarpetAvenue\Productify\LayeredNavigation\ViewModel\FilterConfig</argument>
                </arguments>
            </block>
        </referenceContainer>
    </body>
</page>
