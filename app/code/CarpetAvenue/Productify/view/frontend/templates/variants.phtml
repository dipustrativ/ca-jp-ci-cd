<?php
use CarpetAvenue\Productify\Helper\Data;

/**
 * @var Magento\Catalog\Block\Product\View $block
 * @var CarpetAvenue\Productify\ViewModel\VariantCacheView $viewModel
 */

$product       = $block->getProduct();
$viewModel     = $block->getViewModel();
$designId      = $product->getData(Data::DESIGN_ID_GROUP_ATTRIBUTE_CODE);
$currentId     = $product->getId();
$currentColor  = $product->getAttributeText(Data::COLOR_ATTRIBUTE_CODE);
$currentSize   = $product->getAttributeText(Data::SIZE_ATTRIBUTE_CODE);
$currentShape  = $product->getData(Data::SHAPE_ATTRIBUTE_CODE);

$isGroup = $product->getData(Data::IS_GROUP_ATTRIBUTE_CODE);

if (empty($designId) || !$isGroup) {
    return;
}

$variants = $viewModel->getVariantsByDesignId($designId);
if (!$variants) return;

// Shape option ids are store data, not constants — read once per render.
$helper       = $this->helper(Data::class);
$primaryShape = $helper->getPrimaryShapeOptionId();

// Group variants by color
$groupedByColor = [];
foreach ($variants as $variant) {
    $groupedByColor[$variant[Data::COLOR_ATTRIBUTE_CODE]][] = $variant;
}
$currentGroup = $groupedByColor[$currentColor] ?? [];

// Group current color variants by shape and sort by size value
$groupedByShape = [];
$currentImageUrl = '';
foreach ($currentGroup as $variant) {
    // Match both size and shape to get the correct image
    // Use 'shape_key' for comparison since $currentShape contains the shape ID
    if ($variant[Data::SIZE_ATTRIBUTE_CODE] === $currentSize
        && $variant['shape_key'] == $currentShape) {
        $currentImageUrl = $variant['image'];
    }
    $shape = $variant[Data::SHAPE_ATTRIBUTE_CODE] ?? 'Other';
    $groupedByShape[$shape][] = $variant;
}
// Sort each shape group by size value
foreach ($groupedByShape as &$items) {
    usort($items, function($a, $b) {
        $sizeA = $a[Data::SIZE_ATTRIBUTE_CODE];
        $sizeB = $b[Data::SIZE_ATTRIBUTE_CODE];

        // Extract first number from each size string
        preg_match('/(\d+)/', $sizeA, $matchesA);
        preg_match('/(\d+)/', $sizeB, $matchesB);

        $numA = isset($matchesA[1]) ? (int)$matchesA[1] : 0;
        $numB = isset($matchesB[1]) ? (int)$matchesB[1] : 0;

        return $numA <=> $numB;
    });
}
unset($items);

// Helper: Find variant by color and size, fallback to first in color group
function getVariantByColorAndSize($group, $size) {
    foreach ($group as $v) {
        if ($v[Data::SIZE_ATTRIBUTE_CODE] === $size) {
            return $v;
        }
    }
    return $group[0];
}

// Helper: Find variant by size, color, and shape, fallback to first with that size and shape
function getVariantBySizeAndColorAndShape($variants, $color, $size, $shapeKey) {
    // First try: exact match with color, size, and shape
    foreach ($variants as $v) {
        if ($v[Data::COLOR_ATTRIBUTE_CODE] === $color
            && $v[Data::SIZE_ATTRIBUTE_CODE] === $size
            && $v['shape_key'] == $shapeKey) {
            return $v;
        }
    }
    // Second fallback: match size and shape (ignore color)
    foreach ($variants as $v) {
        if ($v[Data::SIZE_ATTRIBUTE_CODE] === $size && $v['shape_key'] == $shapeKey) {
            return $v;
        }
    }
    return null;
}
