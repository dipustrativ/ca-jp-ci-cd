<!-- ✅ JS BEHAVIOR -->
<script>
    function openSizeDrawer() {
        document.getElementById('productify-size-drawer').classList.add('open');
        document.getElementById('productify-overlay').classList.add('show');
        document.body.classList.add('drawer-open');
    }

    function closeSizeDrawer() {
        document.getElementById('productify-size-drawer').classList.remove('open');
        document.getElementById('productify-overlay').classList.remove('show');
        document.body.classList.remove('drawer-open');
    }

    document.addEventListener('keydown', function (e) {
        if (e.key === "Escape") {
            closeSizeDrawer();
        }
    });

    require(['jquery'], function ($) {
        $(document).ready(function () {
            const drawer = $('#productify-size-drawer');
            const overlay = $('#productify-overlay');
            const pageWrapper = '.page-wrapper';

            if ($(pageWrapper).length) {
                $(pageWrapper).after(drawer);
                $(pageWrapper).after(overlay);
            }
        });
    });
</script>
