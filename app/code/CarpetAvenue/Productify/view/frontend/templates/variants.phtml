    </div>

    <?php
        // Dynamically find and prioritize the primary shape (config: Productify >
        // Group Products > Primary Shape Option ID) using its actual name.
        $rectangularText = null;
        foreach ($groupedByShape as $shape => $items) {
            if ($items[0]['shape_key'] == $primaryShape) {
                $rectangularText = $shape;
                break;
            }
        }

        // from the array $groupedByShape make sure if array key Rectangular it will show first
        if ($rectangularText && isset($groupedByShape[$rectangularText])) {
            $rectangular = $groupedByShape[$rectangularText];
            unset($groupedByShape[$rectangularText]);
            $groupedByShape = array_merge([$rectangularText => $rectangular], $groupedByShape);
        }
    ?>

    <?php foreach ($groupedByShape as $shape => $items): ?>
        <?php if ($items[0]['shape_key'] != $primaryShape) :?>
            <div style="font-weight: bold; margin: 10px 0;"><?= $shape ?></div>
        <?php endif;?>
        <ul class="size-overlay-wrap" style="list-style: none; padding: 0;">
            <?php foreach ($items as $variant):
                $id = $variant['id'];
                $sku = $variant['sku'];
                $saleableStatus = $variant['is_salable'];
                $isCurrent = $variant['id'] == $currentId;
                // Find variant in current color with this size and shape, fallback to first with that size and shape
                $variantShapeKey = $variant['shape_key'] ?? '';
                $targetVariant = getVariantBySizeAndColorAndShape($variants, $currentColor, $variant[Data::SIZE_ATTRIBUTE_CODE], $variantShapeKey);
                $url = $saleableStatus && $targetVariant ? $targetVariant['url'] : 'javascript:void(0)';
                $img = $variant['image'];
                $size = $helper->formatSizeLabel((string)$variant[Data::SIZE_ATTRIBUTE_CODE], $variantShapeKey);
                $price = $variant['price'];
                $special = $variant['special_price'];
                $finalPrice = $variant['final_price_formatted'];
                ?>
                <li class="<?= ($isCurrent)? 'selected-variant':''?>">
                    <a href="<?= $url ?>" style="display: flex; align-items: center; gap: 10px; text-decoration: none;
                    color: <?= $isCurrent ? '#050505' : '#333333' ?>;
                    <?= !$saleableStatus ? 'text-decoration: line-through; color: #aaa;' : '' ?>
                    <?= $isCurrent ? 'font-weight: bold;' : '' ?>">
                        <img src="<?= $img ?>" width="30" height="30">
