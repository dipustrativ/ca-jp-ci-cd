        overflow: hidden;
        display: flex;
        justify-content: center;
        align-items: center;
        border: 1px solid #ddd;
    }
    .swatch-image-wrap img {
        width: 120px;
        height: 120px;
        object-fit: cover;
        object-position: center;
        transform: scale(1);
    }
</style>
