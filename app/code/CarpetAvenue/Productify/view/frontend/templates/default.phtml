<script type="text/javascript">
    require(['jquery'], function ($) {
        function updateProductifyMeta() {
            const productifyMetaEle = '.columns .productify-group-meta';
            if ($(productifyMetaEle).length) {
                $(productifyMetaEle + ' .size').each(function () {
                    let html = $(this).html();
                    $(this).closest('.product-item').find('.product-item-details .size').html(html);
                    $(this).remove();
                });
            }
        }

        // Exposed globally so Infinite Ajax Scroll can re-run it from its
        // 'rendered' event (see ajaxscroll/init.phtml) — appended tiles carry
        // both the theme .size and the group-meta .size until this dedupes them.
        window.updateProductifyMeta = updateProductifyMeta;

        jQuery(document).ready(function () {
            updateProductifyMeta();

            // Re-dedupe after any AJAX that adds/replaces tiles:
            //   - layered-nav filter swap fires 'collectionUpdated'
            //   - legacy Amasty content update fires 'contentUpdated'
            // IAS appends are handled via its own 'rendered' hook (init.phtml),
            // which is the only reliable post-append signal.
            $(document).on('contentUpdated collectionUpdated', function () {
                updateProductifyMeta();
            });
        });
    });
</script>

<style>
    .productify-group-meta {
        font-size: 13px;
        position: relative;
        text-align: center;
    }

    .carpient-tag ~ .productify-group-meta {
