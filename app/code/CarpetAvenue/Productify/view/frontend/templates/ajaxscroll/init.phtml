<?php
$helper = $this->helper('CarpetAvenue\Productify\AjaxScroll\Helper\Data');
$productListMode = $block->getProductListMode();
$enable = $block->isEnable();
$delay = $helper->getConfig('productify/ajaxscroll/instances/delay');
$delay = $delay?(int)$delay:600;
$toolbarAugment = true;
$toolbarShowOnlyTotal = true;

if($helper->isEnabled() && $enable) { ?>
<script>
	require(['jquery',
		'CarpetAvenue_Productify/js/ajaxscroll/script'
		], function ($) {

        var showProgressbar = "<?= $helper->getConfig('productify/ajaxscroll/design/show_progressbar') ? '1' : '0'; ?>";
        var elementAmount = null;

		$( window ).on('collectionUpdated', function() {

            if(jQuery().ias) {
                $.ias('destroy');
            }
			$('<?php echo $helper->getConfig('productify/ajaxscroll/selectors/toolbar') ?>').<?php echo $helper->getConfig('productify/ajaxscroll/design/hide_toolbar') ? 'hide' : 'show' ?>();

            windowLoadedFlag = false;
            elementAmount = $('<?php echo $helper->getConfig('productify/ajaxscroll/selectors/toolbar') ?>').find(".toolbar-amount");
            preved = false;
            nexed = false;
            amountSeen = 0;
            amountPrev = 0;

			window.onload = function () {
				windowLoadedFlag = true;
			};
			var jQueryWaiter = function () {
				var functions = [];
				var timer = function() {
					if( typeof window.jQuery != 'undefined') {
						while (functions.length) {
							functions.shift()(window.jQuery);
						}
					} else {
						window.setTimeout(timer, 100);
					}
				};
				timer();
				return {
					execute: function(onJQueryReady) {
						if (window.jQuery) {
							onJQueryReady(window.jQuery);
						} else {
							functions.push(onJQueryReady);
						}
					}
				};
			}();

			window.SgyIAS = {
				debug: false,
				_log: function(object) {
					//console.log(object);
				},
				init: function(){
					jQuery(function($) {
						var config = {
							item: (jQuery('<?php echo $helper->getConfig('productify/ajaxscroll/selectors/list_mode') ?>').length ? '<?php echo $helper->getConfig('productify/ajaxscroll/selectors/list_mode') ?>' : '<?php echo $helper->getConfig('productify/ajaxscroll/selectors/grid_mode') ?>'),
							container : '<?php echo $helper->getConfig('productify/ajaxscroll/selectors/content') ?>',
							next: '<?php echo $helper->getConfig('productify/ajaxscroll/selectors/next') ?>',
							pagination: '<?php echo $helper->getConfig('productify/ajaxscroll/selectors/pagination') ?>',
							parameter: <?php echo $helper->getConfig('productify/ajaxscroll/instances/enable_parameter') ? 'true' : 'false' ?>,
							delay: <?php echo $delay; ?>,
							negativeMargin: <?php echo (int) $helper->getConfig('productify/ajaxscroll/design/buffer') ?>,
							history: {
								prev: '.toolbar.toolbar-products:first-child .previous'
							},
							noneleft: {
								text: '<?php echo $helper->jsQuoteEscape(__($helper->getConfigData('productify/ajaxscroll/design/done_text'))) ?>',
								html: '<div class="ias-noneleft" style="text-align: center;">{text}</div>'
							},
							spinner: {
								<?php if($block->getLoaderImage() !== false): ?>
								src: '<?php echo $block->getLoaderImage(); ?>',
							<?php endif; ?>
							html: '<div class="ias-spinner" style="text-align: center;"><img style="display:inline" src="{src}"/> <?php echo $helper->jsQuoteEscape(__($helper->getConfigData('productify/ajaxscroll/design/loading_text'))); ?></div>'
						},
						trigger: {
							text: '<?php echo $helper->jsQuoteEscape(__($helper->getConfigData('productify/ajaxscroll/design/load_more_text'))) ?>',
							html: '<div class="ias-trigger ias-trigger-next" style="text-align: center; cursor: pointer;"><a>{text}</a></div>',
							textPrev: '<?php echo $helper->jsQuoteEscape(__($helper->getConfigData('productify/ajaxscroll/design/load_prev_text'))) ?>',
							htmlPrev: '<div class="ias-trigger ias-trigger-prev" style="text-align: center; cursor: pointer;"><a>{text}</a></div>',
							offset: <?php echo (int) $helper->getConfigData('productify/ajaxscroll/design/load_more') ?>
						}

					};

					if (window.ias_config){
						$.extend(config, window.ias_config);
					}

					SgyIAS._log({extension: 'ias', config: config});
					window.ias = $.ias(config);

					SgyIAS._log({extension: 'paging'});
					window.ias.extension(new IASPagingExtension());

					SgyIAS._log({extension: 'spinner'});
					if(typeof(IASSpinnerExtension) !== "undefined")
					window.ias.extension(new IASSpinnerExtension(config.spinner));

					SgyIAS._log({extension: 'noneleft'});
					window.ias.extension(new IASNoneLeftExtension(config.noneleft));

                    window.ias.extension(new IASHistoryExtension(config.history));

					SgyIAS._log({extension: 'trigger'});
					window.ias.extension(new IASTriggerExtension(config.trigger));
						// debug events
						window.ias.on('scroll', function(scrollOffset, scrollThreshold){
							SgyIAS._log({eventName: 'scroll', scrollOffset: scrollOffset, scrollThreshold: scrollThreshold});
						});
						window.ias.on('load', function(event){
							SgyIAS._log({eventName:'load', event: event});
						});
						window.ias.on('loaded', function(data, items){
							SgyIAS._log({eventName: 'loaded', data: data, items: items});

                            if(items.length > 0) {
                                let elementToolbar = items[0]["nextElementSibling"];
                                elementAmount = $(elementToolbar).find(".toolbar-amount");

                                <?php if($toolbarAugment): ?>

                                let amountFrom = parseInt($(elementAmount).find("span.amount-from").text());
                                let amountCurrent = parseInt($(elementAmount).find('span.amount-current').text());

                                if(preved) {
                                    amountPrev = amountFrom;
                                }

                                if(nexed) {
                                    amountSeen = amountCurrent;
                                }

                                $(elementAmount).find(".toolbar-number.amount-from").text(amountPrev);
                                // $(elementAmount).find(".toolbar-number.amount-current").text(amountSeen);
                                $('.toolbar-number.amount-current').text(amountSeen);
                                <?php endif; ?>
                            }
						});
						window.ias.on('rendered', function(items){
							SgyIAS._log({eventName: 'rendered', items: items});

							// Appended tiles carry both the theme .size and the
							// group-meta .size — de-duplicate (fn from default.phtml).
							if (typeof window.updateProductifyMeta === 'function') {
								window.updateProductifyMeta();
							}

							if(typeof(initLofLazyLoad) === 'function') {
								initLofLazyLoad();
							} else if (typeof($(items).find('.lof-lazy').lazy) === 'function') {
								$(items).find('.lof-lazy').lazy({
									bind: "event",
									delay: 0
								});
							} else if (typeof($(items).find('.lazy-load').lazyload) === 'function') {
                                $(items).find('.lazy-load').lazyload({
                                    effect : "fadeIn",
                                    threshold: 500
                                });
                            }

                            <?php if($toolbarShowOnlyTotal == false): ?>
                            if(elementAmount != null) {
                                setTopToolbarAmount();
                            }
                            <?php endif; ?>

						});
						window.ias.on('noneLeft', function(){
							SgyIAS._log({eventName: 'noneLeft'});
						});
						window.ias.on('next', function(url){
							SgyIAS._log({eventName: 'next', url: url});

                            nexed = true;
                            preved = false;
						});
                        window.ias.on('prev', function(url){
                            SgyIAS._log({eventName: 'prev', url: url});

                            nexed = false;
                            preved = true;
                        });
						window.ias.on('ready', function(){
							SgyIAS._log({eventName: 'ready'});

                            elementAmount = $('<?php echo $helper->getConfig('productify/ajaxscroll/selectors/toolbar') ?>').find(".toolbar-amount");
                            amountPrev = parseInt($(elementAmount).find(".toolbar-number.amount-from").text());
                            amountSeen = parseInt($(elementAmount).find(".toolbar-number.amount-current").text());

                            if(elementAmount != null) {
                                setTopToolbarAmount();
                            }

						});

                        //  Product count above the "See more" button. The old code
                        //  bound "onShowNextTrigger", an event IAS does not have,
                        //  so it only ever threw. IAS events are no good here
                        //  either: the trigger extension returns false from its
                        //  own "next" listener to stop the auto-load, which halts
                        //  the callback chain before anything bound after it runs.
                        //  Painting on DOM change sidesteps all of that and also
                        //  survives the AJAX filter swap.
                        var countTpl = '<?php echo $helper->jsQuoteEscape(__('Showing %1 - %2 of %3 products')) ?>';

                        function renderIasCount() {
                            //  Anchor everything on the first product list, so the
                            //  host element is whatever container IAS appends into
                            //  rather than an assumed `.column.main`.
                            var $first = $('.column.main').find('ol.products.product-items').first()
                                .closest('.products.wrapper');
                            if (!$first.length) {
                                return;
                            }
                            var $host = $first.parent();

                            //  Grand total is the largest toolbar-number — robust
                            //  against locale word-order (JP puts total first,
                            //  EN last). The old code took .last(), which is the
                            //  "to" value, so it read 50/100 instead of the total.
                            var total = 0;
                            $('.column.main .toolbar-amount .toolbar-number').each(function () {
                                var n = parseInt($(this).text().replace(/[^0-9]/g, ''), 10) || 0;
                                if (n > total) { total = n; }
                            });

                            //  Loaded = tiles in the category list only, never
                            //  upsell/related widgets. The IAS item selector is
                            //  .products-grid — the whole wrapper div — so each
                            //  load appends a *new* wrapper with its own <ol>
                            //  next to the previous one. Counting only the first
                            //  <ol> froze this at the first page size, which is
                            //  why the text and the bar never moved. Count tiles
                            //  across every sibling wrapper instead; widgets sit
                            //  nested in their own blocks, so they stay out.
                            var $wrappers = $host.children('.products.wrapper');
                            var loaded = $wrappers.find('ol.products.product-items > li.product-item').length;

                            if (!total || !loaded) {
                                return;
                            }

                            //  The box is ours and it persists. It used to be
                            //  painted *into* the trigger, but IAS removes that
                            //  node on every load and never brings it back once
                            //  the last page is in — so the count vanished at the
                            //  exact moment it read 100%.
                            var $box = $host.children('.ias-count-box');
                            if (!$box.length) {
                                $box = $('<div class="ias-count-box"><div class="ias-count"></div>'
                                    + (showProgressbar === "1"
                                        ? '<div class="progressbar"><span class="progressbar__fill"></span></div>'
                                        : '')
                                    + '</div>');
                            }

                            //  IAS parks the trigger, the spinner and the "none
                            //  left" message after the last grid with .after(),
                            //  which would land them above the box. Keep the box
                            //  directly in front of whichever one is present, and
                            //  only move it when it is actually out of place, so
                            //  repositioning cannot loop against the observer.
                            var $anchor = $host.children('.ias-trigger-next, .ias-spinner, .ias-noneleft').first();
                            if ($anchor.length) {
                                if ($anchor.prev()[0] !== $box[0]) {
                                    $box.insertBefore($anchor);
                                }
                            } else if ($wrappers.last().next()[0] !== $box[0]) {
                                $box.insertAfter($wrappers.last());
                            }

                            //  Signature guard: data() does not touch the DOM the
                            //  observer watches, so updating it cannot re-trigger us.
                            var sig = loaded + '/' + total;
                            if ($box.data('iasSig') === sig) {
                                return;
                            }
                            $box.data('iasSig', sig);

                            var text = countTpl.replace('%1', 1).replace('%2', loaded).replace('%3', total);
                            var pct = Math.min(100, Math.round((loaded / total) * 100));

                            $box.find('.ias-count').text(text);
                            $box.find('.progressbar__fill').css('width', pct + '%');
                        }

                        if (window.MutationObserver && !window.iasCountObserver) {
                            window.iasCountObserver = new MutationObserver(renderIasCount);
                            window.iasCountObserver.observe(
                                document.querySelector('.column.main') || document.body,
                                {childList: true, subtree: true}
                            );
                        }
                        renderIasCount();

						if(windowLoadedFlag){
							$(window).load();
						}

						SgyIAS._log('Done loading IAS.');

					});

				}
			};
			jQueryWaiter.execute(function(){
				SgyIAS.init();

			});

		});

        function setTopToolbarAmount() {
            let elAmountClone = $(elementAmount).clone();
            let elementAmountTop = $(".toolbar.toolbar-products").first().find(".toolbar-amount");
            let elementAmountTopEl = null;

            if(elAmountClone !== "undefined") {
                <?php if($toolbarShowOnlyTotal): ?>

                if($(elAmountClone).find(".amount-from").length > 0 && $(elAmountClone).find(".amount-current").length > 0) {
                    $(elAmountClone).find(".amount-from")[0].nextSibling.nodeValue = "";
                    $(elAmountClone).find(".amount-current")[0].nextSibling.nodeValue = "";
                    $(elAmountClone).find(".amount-total").after(" ");
                    $(elAmountClone).find(".amount-from").remove();
                    $(elAmountClone).find(".amount-current").remove();
                    $(elAmountClone).find(".amount-total").prependTo(elAmountClone);
                }

                <?php endif; ?>
            }

            if($(".toolbar.toolbar-products").first().find(".toolbar-amount")) {
                elementAmountTopEl = $(elementAmountTop).replaceWith(elAmountClone);
            } else {
                elementAmountTopEl = $(".toolbar.toolbar-products").first().find(".modes").after(elAmountClone);
            }

        }

        $(document).ready(function () {

            // Init on fresh loads too (history.state is null then) — otherwise
            // infinite scroll only starts after the first AJAX filter action.
            if(!window.history.state || !window.history.state.hasOwnProperty('html')) {

                $('body').trigger('collectionUpdated');

                if(elementAmount != null) {
                    setTopToolbarAmount();
                }
            }
        });

    });

//]]>
</script>
<?php } ?>
