<?php
/**
 * @var $block CarpetAvenue\Productify\Block\Product\Category\CategoryList
 */
$currentCategory = $block->getCurrentCategory();
if ($currentCategory->getData('level') != 3) return;
?>

<div class="container collection-subcategories">
    <?php foreach ($block->getSubcategories() as $category): ?>
        <?php $categoryUrl = !empty($category->getCustomUrl()) ? $category->getCustomUrl() : $category->getUrl(); ?>
        <a href="<?= $categoryUrl; ?>" class="subcategory-card">
            <?php if ($category->getThumbnail()): ?>
                <img src="<?= $block->getImageUrl($category->getThumbnail(), 200, 200) ?>"
                     alt="<?= $category->getName(); ?>" />
            <?php else: ?>
                <img src="" alt="<?= $category->getName(); ?>" />
            <?php endif;?>
            <span><?= $category->getName() ?></span>
        </a>
    <?php endforeach; ?>
</div>

