        }
    }
</style>
<div class="container category-heading category-heading-with-description">
    <h1><?= !empty($customCategoryTitle) ? $customCategoryTitle : $name ?></h1>
    <div class="category-description">
        <?php if ($showReadMore): ?>
            <div class="category-description-readmore" id="category-desc-readmore">
                <span class="desc-truncated"><?= $escaper->escapeHtml($truncatedText) ?></span>
                <span class="desc-full" style="display:none;"><?= $description ?></span>
                <a href="javascript:void(0)" class="read-more-toggle" id="desc-read-more-btn"><?= $escaper->escapeHtml(__("Read more")) ?>...</a>
            </div>
        <?php else: ?>
            <?= $description ?>
        <?php endif; ?>
    </div>
</div>
<?php else: ?>
    <div class="container category-heading<?= $showBottomPreview ? ' category-heading-with-description' : '' ?>">
        <h1><?= !empty($customCategoryTitle) ? $customCategoryTitle : $name ?></h1>
        <?php if ($showBottomPreview): ?>
            <div class="category-description category-description-preview">
                <span class="desc-first-sentence"><?= $escaper->escapeHtml($firstSentence) ?></span>
                <?php if ($hasMoreThanFirstSentence): ?>
                    <a href="javascript:void(0)" class="read-more-toggle" id="desc-jump-readmore"><strong> <?= $escaper->escapeHtml(__("Read more")) ?></strong></a>
                <?php endif; ?>
            </div>
        <?php endif; ?>
    </div>
<?php endif; ?>

<?php if ($customBottomBlock): ?>
