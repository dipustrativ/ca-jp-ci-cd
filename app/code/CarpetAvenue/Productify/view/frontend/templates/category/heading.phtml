        /*margin: 0 6%;*/
        margin-top: 10px;
        margin-bottom: 15px;
    }
    .category-heading-with-description h1 {
        font-size: 31px;
        font-family: Inter, sans-serif !important;
        color: #000000;
        font-weight: 300 !important;
    }
    .category-heading-with-description .category-description {
        font-size: 18px;
        color: #000000;
