<?php if ($showReadMore): ?>
<script>
(function() {
    var btn = document.getElementById('desc-read-more-btn');
    var truncated = document.querySelector('.desc-truncated');
    var full = document.querySelector('.desc-full');
    var expanded = false;
    if (btn && truncated && full) {
        btn.addEventListener('click', function() {
            expanded = !expanded;
            truncated.style.display = expanded ? 'none' : '';
            full.style.display = expanded ? '' : 'none';
            btn.textContent = expanded ? '<?= $escaper->escapeJs(__('Read less'))."..." ?>' : '<?= $escaper->escapeJs(__('Read more'))."..." ?>';
        });
    }
})();
</script>
<?php endif; ?>

<?php if ($showBottomPreview && $hasMoreThanFirstSentence): ?>
<script>
(function() {
    var jumpBtn = document.getElementById('desc-jump-readmore');
    if (!jumpBtn) { return; }
    jumpBtn.addEventListener('click', function() {
        var target = document.querySelector('.category-description.toggle-readmore')
            || document.querySelector('.category-description:not(.category-description-preview)');
        if (!target) { return; }
        target.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
})();
</script>
<?php endif; ?>

<?php if ($customCss): ?>
<style><?= $customCss /* Admin-authored content, trusted */ ?></style>
<?php endif; ?>
