<?php
/**
 * @var $block CarpetAvenue\Productify\Block\Product\Category\CategoryList
 */
$currentCategory = $block->getCurrentCategory();
$name = $currentCategory->getName();
$customCategoryTitle = $currentCategory->getCustomTitle();
$description = $currentCategory->getDescription();
$customBottomBlock = $currentCategory->getData("custom_bottom_block");
$isReadMoreEnabled = (bool) $currentCategory->getData('description_read_more');
$readMoreChars = (int) $currentCategory->getData('description_read_more_chars');
$showDescriptionTop = (bool) $currentCategory->getData('show_description_top');
$categoryDescriptionShowOnTop = $showDescriptionTop || $customBottomBlock;
$customCss = $currentCategory->getData('category_custom_css');
// Drop <style>/<script> blocks first — strip_tags keeps their inner text,
// and PageBuilder descriptions embed a <style> block whose CSS would otherwise
// leak into the plain text and break sentence extraction.
$descriptionNoEmbeds = preg_replace('#<(style|script)\b[^>]*>.*?</\1>#is', '', $description ?? '');
$descriptionPlain = trim(strip_tags($descriptionNoEmbeds));
// First complete sentence — used in bottom-description (else) branch preview
// Includes Japanese sentence terminators (。！？) alongside Latin (.!?) for ja_JP
preg_match('/[^.!?。！？]*[.!?。！？]+/u', $descriptionPlain, $firstSentenceMatch);
$firstSentence = trim($firstSentenceMatch[0] ?? '');
if ($firstSentence === '') {
    $firstSentence = trim($descriptionPlain);
}
$hasMoreThanFirstSentence = mb_strlen(trim($descriptionPlain)) > mb_strlen($firstSentence);
if ($readMoreChars > 0) {
    $hasMoreContent = mb_strlen($descriptionPlain) > $readMoreChars;
    $truncatedText  = $hasMoreContent
        ? mb_substr($descriptionPlain, 0, $readMoreChars)
        : $descriptionPlain;
} else {
    $sentenceLimit  = 2;
    preg_match_all('/[^.!?。！？]*[.!?。！？]+/u', $descriptionPlain, $matches);
    $sentences      = $matches[0] ?? [];
    $hasMoreContent = count($sentences) > $sentenceLimit;
    $truncatedText  = $hasMoreContent
        ? trim(implode('', array_slice($sentences, 0, $sentenceLimit)))
        : $descriptionPlain;
}
$showReadMore = $isReadMoreEnabled && $showDescriptionTop && $hasMoreContent;
// Bottom-description case: show 1st sentence under heading, jump+expand to bottom toggle-readmore
$showBottomPreview = $description && !$categoryDescriptionShowOnTop;
?>
<?php if ($description && $categoryDescriptionShowOnTop): ?>
<style>
