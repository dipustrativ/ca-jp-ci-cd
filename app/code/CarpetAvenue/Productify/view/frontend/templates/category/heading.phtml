        font-weight: inherit;
        display: inline;
    }
    .read-more-toggle:hover {
        opacity: 0.7;
    }
    .category-description-readmore .desc-truncated {
        display: inline;
    }
    .toolbar-products
    @media screen and (max-width:767px){
        .category-heading-with-description {
            margin: 0 0;
        }
        .category-heading-with-description .category-description {
            font-size: 12px;
        }
