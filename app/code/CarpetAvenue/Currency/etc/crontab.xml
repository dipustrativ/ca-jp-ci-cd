<?xml version="1.0" ?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Cron:etc/crontab.xsd">
	<group id="default">
        <job name="carpet_currency_insertcurrencyrows" instance="CarpetAvenue\Currency\Cron\InsertAverageCurrencyRows" method="execute">
            <schedule>45 5 1 * *</schedule>
        </job>
        <job name="carpet_currency_update_daily" instance="CarpetAvenue\Currency\Cron\UpdateDaily" method="execute">
            <schedule>15 2 * * *</schedule>
        </job>
        <job name="carpet_currency_update_all" instance="CarpetAvenue\Currency\Cron\UpdateAll" method="execute">
            <schedule>15 2 1 1 *</schedule>
        </job>
	</group>
</config>
