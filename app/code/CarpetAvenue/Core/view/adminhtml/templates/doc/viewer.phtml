<script>
/* ─────────────────────────────────────────────────────────────────
   caDocMd  —  Inline Markdown → HTML parser  (zero dependencies)
   Handles: headings, fenced code, tables, blockquotes, ul/ol,
            hr, bold, italic, inline-code, links, paragraphs.
   ───────────────────────────────────────────────────────────────── */
const caDocMd = (function () {

    /* HTML-escape a raw string */
    function esc(s) {
        return String(s)
            .replace(/&/g, '&amp;').replace(/</g, '&lt;')
            .replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }

    /* Minimal syntax colouring — operates on ALREADY html-escaped text.
       Uses a token-replace approach so spans are never double-processed. */
    function highlight(code) {
        /* Step 1: escape raw code to safe HTML text */
        var s = esc(code);

        /* Step 2: tokenise — pull out all patterns in ONE pass using a
           single replace so earlier replacements cannot match later ones.
           Order: block-comments → line-comments → double-quoted strings →
                  single-quoted strings → variables → keywords */
        s = s.replace(
            /(\/\*[\s\S]*?\*\/)|(\/\/[^\n]*)|(#[^\n]*)|(&quot;[^&\n]*&quot;)|('[^'\n]*')|(\$[a-zA-Z_]\w*)/g,
            function(m, blk, lc, sh, dq, sq, va) {
                if (blk || lc || sh) return '<span class="ca-c">'+m+'</span>';
                if (dq  || sq)       return '<span class="ca-s">'+m+'</span>';
                if (va)              return '<span class="ca-v">'+m+'</span>';
                return m;
            }
        );

        /* Step 3: keyword pass — only on plain text nodes (not inside spans).
           We process segment-by-segment to avoid touching span contents. */
        var kw = /\b(function|return|class|new|use|namespace|public|private|protected|static|readonly|declare|if|else|foreach|while|true|false|null|bin\/magento|composer)\b/g;
        s = s.replace(/(<[^>]+>)|([^<]+)/g, function(m, tag, txt) {
            if (tag) return tag;                          // inside tag → unchanged
            return txt.replace(kw, '<span class="ca-k">$1</span>');
        });

        return s;
    }

    /* Inline formatting: code spans, bold, italic, links */
    function inline(raw) {
        /* 1. protect inline code spans */
        const saved = [];
        let s = raw.replace(/`([^`\n]+)`/g, function (_, c) {
            saved.push('<code>' + esc(c) + '</code>');
            return '\x02' + (saved.length - 1) + '\x03';
        });
        /* 2. escape remaining HTML */
        s = esc(s);
        /* 3. formatting */
        s = s.replace(/\*\*\*(.+?)\*\*\*/g, '<strong><em>$1</em></strong>');
        s = s.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');
        s = s.replace(/\*([^*\n]+)\*/g, '<em>$1</em>');
        s = s.replace(/\[([^\]]+)\]\(([^)]+)\)/g,
            '<a href="$2" target="_blank" rel="noopener">$1</a>');
        /* 4. restore code spans */
        s = s.replace(/\x02(\d+)\x03/g, function (_, i) {
            return saved[+i];
        });
        return s;
    }

    /* Parse a GFM pipe table */
    function parseTable(rows) {
        const heads = rows[0].split('|').map(function (c) {
            return c.trim();
        }).filter(Boolean);
        let html = '<table><thead><tr>';
        heads.forEach(function (h) {
            html += '<th>' + inline(h) + '</th>';
        });
        html += '</tr></thead><tbody>';
        for (let r = 2; r < rows.length; r++) {
            var cells = rows[r].split('|').map(function (c) {
                return c.trim();
            }).filter(Boolean);
            html += '<tr>';
            cells.forEach(function (c) {
                html += '<td>' + inline(c) + '</td>';
            });
            html += '</tr>';
        }
        return html + '</tbody></table>';
    }

    /* Main block parser */
    function parse(md) {
        var lines = md.split('\n');
        var html = '';
        var i = 0;

        while (i < lines.length) {
            var line = lines[i];

            /* fenced code block */
            if (/^```/.test(line)) {
                var lang = line.replace(/^```/, '').trim() || 'text';
                var code = [];
                i++;
                while (i < lines.length && !/^```\s*$/.test(lines[i])) {
                    code.push(lines[i]);
                    i++;
                }
                var rawCode = code.join('\n');
                html += '<div class="ca-pre-wrap">'
                      + '<button class="ca-copy-btn" onclick="caDocCopy(this)">Copy</button>'
                      + '<pre><code>' + highlight(rawCode) + '</code></pre>'
                      + '</div>\n';
                i++;
                continue;
            }

            /* headings */
            var hm = line.match(/^(#{1,4})\s+(.+)/);
            if (hm) {
                var lvl = hm[1].length;
                html += '<h' + lvl + '>' + inline(hm[2]) + '</h' + lvl + '>\n';
                i++;
                continue;
            }

            /* horizontal rule */
            if (/^-{3,}\s*$/.test(line) || /^\*{3,}\s*$/.test(line)) {
                html += '<hr>\n';
                i++;
                continue;
            }

            /* blockquote */
            if (/^>\s?/.test(line)) {
                var bq = [];
                while (i < lines.length && /^>\s?/.test(lines[i])) {
                    bq.push(lines[i].replace(/^>\s?/, ''));
                    i++;
                }
                html += '<blockquote>' + parse(bq.join('\n')) + '</blockquote>\n';
                continue;
            }

            /* GFM table (row | … followed by separator |---|…) */
            if (/^\|/.test(line) && i + 1 < lines.length && /^\|[\s\-:|]+\|/.test(lines[i + 1])) {
                var tbl = [line];
                i++;
                while (i < lines.length && /^\|/.test(lines[i])) {
                    tbl.push(lines[i]);
                    i++;
                }
                html += parseTable(tbl) + '\n';
                continue;
            }

            /* unordered list */
            if (/^[\-\*\+]\s/.test(line)) {
                html += '<ul>\n';
                while (i < lines.length && /^[\-\*\+]\s/.test(lines[i])) {
                    html += '<li>' + inline(lines[i].replace(/^[\-\*\+]\s/, '')) + '</li>\n';
                    i++;
                }
                html += '</ul>\n';
                continue;
            }

            /* ordered list */
            if (/^\d+\.\s/.test(line)) {
                html += '<ol>\n';
                while (i < lines.length && /^\d+\.\s/.test(lines[i])) {
                    html += '<li>' + inline(lines[i].replace(/^\d+\.\s/, '')) + '</li>\n';
                    i++;
                }
                html += '</ol>\n';
                continue;
            }

            /* blank line */
            if (line.trim() === '') {
                i++;
                continue;
            }

            /* paragraph — collect until a block-level element or blank line */
            var pLines = [];
            while (i < lines.length) {
                var l = lines[i];
                if (l.trim() === '') break;
                /* NOTE: backtick (`) intentionally NOT in this break — it is inline, not block-level.
                   Only break on actual block starters: #headings, >blockquote, fenced ```, hr, lists, tables */
                if (/^#{1,4}\s/.test(l) || /^>/.test(l) || /^```/.test(l)) break;
                if (/^[\-\*\+]\s/.test(l) || /^\d+\.\s/.test(l)) break;
                if (/^-{3,}\s*$/.test(l) || /^\*{3,}\s*$/.test(l)) break;
                if (/^\|/.test(l)) break;
                pLines.push(l);
                i++;
            }
            /* Safety: if nothing was collected and i didn't move, force-advance to prevent infinite loop */
            if (!pLines.length) { i++; continue; }
            html += '<p>' + inline(pLines.join(' ').trim()) + '</p>\n';
        }
        return html;
    }

    return {parse: parse};
})();

