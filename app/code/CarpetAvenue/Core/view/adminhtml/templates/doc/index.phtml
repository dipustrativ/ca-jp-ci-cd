/**
 * CarpetAvenue Documentation Hub — Central Index
 *
 * @package   CarpetAvenue_Core
 * @author    Strativ Magento Team
 *
 * HOW TO ADD A CHAPTER:
 *   1. Create your .md file at:  app/code/{Vendor}/{Module}/docs/{doc-name}.md
 *   2. Follow the standard template (_template.md) with the 4 required sections.
 *   3. Append an entry to the $chapters array below — that's it.
 *
 * Uses the ca-doc-* CSS class system (inline, portable).
 */

/** @var \CarpetAvenue\Core\Block\Adminhtml\Doc\Index $block */

/**
 * ──────────────────────────────────────────────────────────────
 * CHAPTER REGISTRY
 * Each entry renders as a card on this hub page.
 *
 * Keys:
 *   chapter – sequential number
 *   module  – Magento module name  (e.g. CarpetAvenue_Core)
 *   title   – displayed chapter title
 *   desc    – short description shown on the card
 *   icon    – emoji icon
 *   badge   – short module label shown on the card
 *   color   – accent color (CSS hex)
 *
 * Viewer URL (auto-built):  carpetavenue/doc/view?module={module}
 * Deep-link tabs:           …&tab=manual  |  …&tab=developer
 * Source file:              app/code/{Vendor}/{Module}/README.md
 * ──────────────────────────────────────────────────────────────
 */
$chapters = [
    [
        'chapter' => 1,
        'module'  => 'CarpetAvenue_Core',
        'title'   => 'Core Module',
        'desc'    => 'Foundation module — shared admin tab, ACL resources, reusable helpers '
                   . '(Slack, URL, SysConfig, Product, UpsertBulk, Performance), and Slack Notification integration.',
        'icon'    => '🧱',
        'badge'   => 'Core',
        'color'   => '#1c2e45',
    ],
    [
        'chapter' => 2,
        'module'  => 'CarpetAvenue_Utilities',
        'title'   => 'Utilities Module',
        'desc'    => 'Region Manager admin CRUD and Media Cleanup & Backup CLI tools — '
                   . 'scan, archive, and remove orphaned/disabled product image cache files.',
        'icon'    => '🛠️',
        'badge'   => 'Utilities',
        'color'   => '#1c5e8e',
    ],
    [
        'chapter' => 3,
        'module'  => 'CarpetAvenue_Orderify',
        'title'   => 'Orderify Module',
        'desc'    => 'Order fraud prevention and regional address management — refund statistics, '
                   . 'customer blacklist (email/address/IP), and configurable state/region field behaviour for checkout.',
        'icon'    => '🛡️',
        'badge'   => 'Orderify',
        'color'   => '#5e3b1c',
    ],
    [
        'chapter' => 4,
        'module'  => 'Magegadgets_Renameimage',
        'title'   => 'Renameimage Module',
        'desc'    => 'Automatically renames product gallery images on upload and CSV import using configurable '
                   . 'product attribute combinations — supports prefix/postfix, collision handling, and skip flag (_aivz).',
        'icon'    => '🖼️',
        'badge'   => 'Renameimage',
        'color'   => '#3b5e1c',
    ],
];

// Build viewer URLs
foreach ($chapters as &$ch) {
    $modPath        = str_replace('_', '/', $ch['module']);
    $ch['filepath'] = 'app/code/' . $modPath . '/README.md';
    $ch['url']      = $block->getUrl('carpetavenue/doc/view', ['module' => $ch['module']]);
    $ch['urlDev']   = $block->getUrl('carpetavenue/doc/view', ['module' => $ch['module'], 'tab' => 'developer']);
}
unset($ch);
?>
