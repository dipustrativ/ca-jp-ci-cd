<?php
/** @var \CarpetAvenue\Widget\Block\Widget\CategoryList $block */
?>
<div class="block widget block-categories-list grid">
    <div class="block-title">
        <h2 class="widget_category-maincategory-name">
            <?php echo __($block->getMainCategory()->getName()) ?>
        </h2>
    </div>
    <div class="category-grid new-layout widget_category-grid">
        <?php foreach ($block->getSubCategories() as $category): ?>
            <?php $categoryUrl = !empty($category->getCustomUrl()) ? $category->getCustomUrl() : $category->getUrl(); ?>
            <div class="new-layout new-widget_category-item">
                <a href="<?= $categoryUrl ?>">
                    <div class="new-widget_category-image">
                        <img src="<?= $block->escapeUrl($block->getCategoryImageUrl($category)) ?>" alt="<?= $block->escapeHtmlAttr($category->getName()) ?>">
                    </div>

                    <span class="new-widget_category-title">
                        <?php echo $category->getName(); ?>
                    </span>
                </a>
            </div>
        <?php endforeach; ?>
    </div>
</div>
