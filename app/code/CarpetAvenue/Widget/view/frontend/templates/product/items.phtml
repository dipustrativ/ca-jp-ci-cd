// phpcs:disable Magento2.Templates.ThisInTemplate.FoundThis
// phpcs:disable Generic.WhiteSpace.ScopeIndent.Incorrect
?>

<?php
if ($exist = $block->getProductCollection()) {
    $type = 'block-products-list';
    $mode = 'grid';
    $type = $type . ' ' . $mode;

    $class = 'widget' . ' ' . $type;

    $image = 'category_page_grid'; // match category grid image (560x750) instead of low-res widget default
    $title = $block->getTitle();
    $items = $exist;

    $showAddTo = true;
    $showCart = false;
    $templateType = \Magento\Catalog\Block\Product\ReviewRendererInterface::SHORT_VIEW;
    $description = ($mode == 'list') ? true : false;
    $canItemsAddToCart = false;
} else {
    $exist = null;
}

$urlHelper = $this->helper(CarpetAvenue\Core\Helper\URL::class);
$baseUrl = $urlHelper->getBaseUrl();
// Slider
$_useSliderNav = false;
$_useSliderArrows = false;
$hoverImage = $this->helper(CarpetAvenue\Core\Helper\Product::class);
$productIds = [];
if ($exist) {
    foreach ($items as $_item) {
        $productIds[] = $_item->getId();
    }
}
$hoverImageMapper = [];
if ($hoverImage->isEnableHoverImage()) {
    $hoverImageMapper = $hoverImage->getProductSecondImage($productIds, false);
}
?>

<?php if ($exist) :?>
    <?php $randomId = rand(); ?>
    <?php $itemsCount = count($items); ?>

    <div class="block <?= $block->escapeHtmlAttr($class) ?>">
        <div class="block-title title">
            <strong class="category-product-list-widget-heading" id="block-<?= $block->escapeHtmlAttr($class) ?>-heading" role="heading" aria-level="2">
                <a href="<?= $block->getData('category_page_url'); ?>"><?= $block->escapeHtml($title) ?></a>
            </strong>
            <?php if ($block->getData('category_page_url')): ?>
                <div class="widget_category-btn-holder">
                    <a href="<?= $block->getData('category_page_url');?>" class="widget_category-show-all"><?= __("Show All")?></a>
                </div>
            <?php endif; ?>
        </div>
        <div class="block-content content elastyslider" aria-labelledby="block-<?= $block->escapeHtmlAttr($class) ?>-heading">
            <div class="products wrapper grid products-grid products-<?= $block->escapeHtmlAttr($type) ?> elastyslider__slider <?= $_useSliderArrows ? 'use-arrows' : '' ?>">
                <div id="elastyslider__slides-<?= $randomId ?>" class="products list items product-items row elastyslider__slides"> <!-- Edit by Evalent -->
                    <?php
                    $i = 0;
                    foreach ($items as $_item) :
                        ?>
                        <?php $available = ''; ?>
                        <?php if (!$_item->isComposite() && $_item->isSaleable() && $type == 'related') :?>
                        <?php if (!$_item->getRequiredOptions()) :?>
                            <?php $available = 'related-available'; ?>
                        <?php endif; ?>
                    <?php endif; ?>
                        <div id="product_slide__<?= $randomId . '_' . $i ?>" class="item product ev-product-item col-md-2 col-lg-2 col-xs-6 elastyslider__slide"> <!-- Edit by Evalent -->
                            <div class="product-item-info">
                                <?php
                                /* Determine if product is on sale */
                                $regularPrice = $_item->getPriceInfo()->getPrice(\Magento\Catalog\Pricing\Price\RegularPrice::PRICE_CODE)->getAmount()->getValue();
                                $finalPrice = $_item->getPriceInfo()->getPrice(\Magento\Catalog\Pricing\Price\FinalPrice::PRICE_CODE)->getAmount()->getValue();

                                if ($regularPrice !== $finalPrice) :
                                    $discountPercentage = round(100 * (1 - ($finalPrice / $regularPrice)), 0, PHP_ROUND_HALF_UP); ?>
                                    <div class="product-item__flag--discount"><?= '-' . $block->escapeHtml($discountPercentage) . '%'?></div>
                                <?php endif; ?>

                                <?= /* @noEscape */ '<!-- ' . $image . '-->' ?>
                                <?php $hoverSrc = $hoverImageMapper[$_item->getId()] ?? ''; ?>
                                <a href="<?= $block->escapeUrl($block->getProductUrl($_item)) ?>"
                                   class="product photo product-item-photo<?= $hoverSrc ? ' has-hover-image' : '' ?>"
                                >
                                    <?= $block->getImage($_item, $image)->toHtml() ?>
                                    <?php if ($hoverSrc) : ?>
                                        <img class="product-image-photo--hover"
                                             src="<?= $block->escapeUrl($hoverSrc) ?>"
                                             loading="lazy" decoding="async" alt="" aria-hidden="true">
                                    <?php endif; ?>
                                </a>
                                <div class="product details product-item-details">
                                    <strong class="product name product-item-name"><a class="product-item-link" title="<?= $block->escapeHtml($_item->getName()) ?>" href="<?= $block->escapeUrl($block->getProductUrl($_item)) ?>">
                                            <?= $block->escapeHtml($_item->getName()) ?></a>
                                    </strong>

                                    <div class="size">
                                        <?php
                                        $sizeValue = $this->helper(\CarpetAvenue\Productify\Helper\Data::class)->formatSize(
                                            $_item->getData('width'),
                                            $_item->getData('length'),
                                            $_item->getData('shape')
                                        );
                                        echo $block->escapeHtml($sizeValue);
                                        ?>
                                    </div>

                                    <?php // Check if item is 'sold' ?>
                                    <?php if ($_item->isSaleable()) : ?>
                                        <?= /* @noEscape */ $block->getProductPrice($_item) ?>
                                    <?php endif; ?>

                                    <?php if ($templateType) :?>
                                        <?= $block->getReviewsSummaryHtml($_item, $templateType) ?>
                                    <?php endif; ?>

                                    <?= $block->getLayout()->createBlock('Magento\Catalog\Block\Product\ProductList\Item\Block')->setProduct($_item)->setTemplate('Magento_Catalog::product/view/carpient-tag.phtml')->toHtml(); ?>

                                    <?= $block->getLayout()->createBlock('Magento\Catalog\Block\Product\ProductList\Item\Block')->setProduct($_item)->setTemplate('Magento_Catalog::product/view/collector-tag.phtml')->toHtml(); ?>

                                    <?php if ($canItemsAddToCart && !$_item->isComposite() && $_item->isSaleable() && $type == 'related') :?>
                                        <?php if (!$_item->getRequiredOptions()) :?>
                                            <div class="field choice related">
                                                <input type="checkbox" class="checkbox related" id="related-checkbox<?= $block->escapeHtmlAttr($_item->getId()) ?>" name="related_products[]" value="<?= $block->escapeHtmlAttr($_item->getId()) ?>" />
                                                <label class="label" for="related-checkbox<?= $block->escapeHtmlAttr($_item->getId()) ?>"><span><?= $block->escapeHtml(__('Add to Cart')) ?></span></label>
                                            </div>
                                        <?php endif; ?>
                                    <?php endif; ?>

                                    <?php if ($showAddTo || $showCart) :?>
                                        <div class="product actions product-item-inner">
                                            <div class="product-item-actions">
                                                <?php if ($showCart) : ?>
                                                    <div class="actions-primary">
                                                        <?php if ($_item->isSaleable()) :?>
                                                            <?php if ($_item->getTypeInstance()->hasRequiredOptions($_item)) :?>
                                                                <button class="action tocart primary" data-mage-init='{"redirectUrl": {"url": "<?= $block->escapeUrl($block->getAddToCartUrl($_item)) ?>"}}' type="button" title="<?= $block->escapeHtmlAttr(__('Add to Cart')) ?>">
                                                                    <span><?= $block->escapeHtml(__('Add to Cart')) ?></span>
                                                                </button>
                                                            <?php else :?>
                                                                <?php $postDataHelper = $this->helper(Magento\Framework\Data\Helper\PostHelper::class);
                                                                $postData = $postDataHelper->getPostData($block->escapeUrl($block->getAddToCartUrl($_item)), ['product' => $_item->getEntityId()])
                                                                ?>
                                                                <button class="action tocart primary"
                                                                        data-post='<?= /* @noEscape */ $postData ?>'
                                                                        type="button" title="<?= $block->escapeHtmlAttr(__('Add to Cart')) ?>">
                                                                    <span><?= $block->escapeHtml(__('Add to Cart')) ?></span>
                                                                </button>
                                                            <?php endif; ?>
                                                        <?php else :?>
                                                            <?php if ($_item->getIsSalable()) :?>
                                                                <div class="stock available"><span><?= $block->escapeHtml(__('In stock')) ?></span></div>
                                                            <?php else :?>
                                                                <div class="stock unavailable"><span><?= $block->escapeHtml(__('Out of stock')) ?></span></div>
                                                            <?php endif; ?>
                                                        <?php endif; ?>
                                                    </div>
                                                <?php endif; ?>

                                                <?php if ($showAddTo) :?>
                                                    <div class="secondary-addto-links actions-secondary" data-role="add-to-links">
                                                        <?php if ($addToBlock = $block->getChildBlock('addto')) :?>
                                                            <?= $addToBlock->setProduct($_item)->getChildHtml() ?>
                                                        <?php endif; ?>
                                                    </div>
                                                <?php endif; ?>
                                            </div>
                                        </div>
                                        <?php if(!$_item->isSaleable()): ?>
                                            <?php $similarToUrl = $baseUrl."productify/similarto?sku=".$_item->getSku() ?>
                                            <span class="sold-caption"><?= __("Sold") ?></span>
                                            <div class="product-item-similar">
                                                <a href="<?= $similarToUrl ?>" ><span><?= __('Similar Products') ?></span> </a>
                                            </div>
                                        <?php endif; ?>
                                    <?php endif; ?>
                                </div>
                            </div>

                            <?php if($_useSliderArrows): ?>
                                <?php $nexxtId = ($i + 1 < $itemsCount) ? $i+1 : 0; ?>
                                <?php $prevId = ($i - 1 > -1) ? $i-1 : $itemsCount - 1; ?>
                                <a class="slide__prev elastyslider__slide__prev" href="#product_slide__<?= $randomId . '_' . $prevId ?>" title="Prev"></a>
                                <a class="slide__next elastyslider__slide__next" href="#product_slide__<?= $randomId . '_' . $nexxtId ?>" title="Next"></a>
                            <?php endif; ?>

                        </div>
                        <?php $i++; endforeach ?>
                </div>

                <?php if($_useSliderNav): ?>
                    <div class="slider__nav elastyslider__slider__nav">
                        <?php for($nav = 0; $nav < $itemsCount; $nav++): ?>
                            <a class="slider__navlink elastyslider__slider__navlink" href="#product_slide__<?= $randomId . '_' . $nav ?>"></a>
                        <?php endfor; ?>
                    </div>
                <?php endif; ?>

            </div>
        </div>
    </div>
<?php endif;?>

<script>
    require([
        'jquery',
        'js/scrollbar'
    ], function($) {
        $('#elastyslider__slides-<?= $randomId ?>').scrollbar();
    })
</script>

<style>
    .block.widget.block-products-list.grid .block-title strong {
        font-size: 37px;
        font-weight: bold;
    }

    @media (max-width: 768px) {
        font-size: 22px;
        font-weight: bold;
    }


</style>
