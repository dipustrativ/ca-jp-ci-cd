                <description>E.g: 800 or bold</description>
            </parameter>
            <parameter name="textcolor" required="true" xsi:type="block" visible="true" sort_order="30">
                <label translate="true">Text Color</label>
                <block class="CarpetAvenue\Widget\Block\Adminhtml\Widget\Color"/>
            </parameter>
            <parameter name="closebtn" xsi:type="select" visible="true" sort_order="50">
                <label translate="true">Show Close Button</label>
