<?xml version="1.0"?>
<widgets xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Widget:etc/widget.xsd">

    <!-- ============================================================ -->
    <!-- Callout Widget                                                -->
    <!-- ============================================================ -->
    <widget class="CarpetAvenue\Widget\Block\Widget\CalloutWidget" id="evalent_callout_widget">
        <label>Callout widget</label>
        <description>Display a message with selected colors</description>
        <parameters>
            <parameter name="message" required="true" sort_order="10" visible="true" xsi:type="text">
                <label translate="true">Message</label>
                <description>The message text. Use %countdown to show countdown days.</description>
            </parameter>
            <parameter name="bgcolor" required="false" xsi:type="block" visible="true" sort_order="20">
                <label translate="true">Background Color</label>
                <block class="CarpetAvenue\Widget\Block\Adminhtml\Widget\Color"/>
            </parameter>
            <parameter name="fontsize" xsi:type="text" required="true" visible="true" sort_order="40">
                <label translate="true">Font Size</label>
                <description>E.g: 16px</description>
            </parameter>
            <parameter name="textcolor" required="false" xsi:type="block" visible="true" sort_order="30">
                <label translate="true">Text Color</label>
                <block class="CarpetAvenue\Widget\Block\Adminhtml\Widget\Color"/>
            </parameter>
            <parameter name="closebtn" required="false" xsi:type="select" visible="true" sort_order="50">
                <label translate="true">Show Close Button</label>
                <options>
                    <option name="yes" value="1"><label translate="true">Yes</label></option>
                    <option name="no" value="0" selected="true"><label translate="true">No</label></option>
                </options>
            </parameter>
            <parameter name="countdown" required="false" xsi:type="block" visible="true" sort_order="60">
                <label translate="true">Countdown to date</label>
                <description>If set, will show countdown to the given date</description>
                <block class="CarpetAvenue\Widget\Block\Adminhtml\Widget\DatePicker"/>
            </parameter>
            <parameter name="countdown_days_before" xsi:type="text" required="false" visible="true" sort_order="61">
                <label translate="true">Show Countdown X Days Before End</label>
                <description>Timer will only show when countdown reaches this limit (1 or more days, 0 to always show)</description>
                <value>0</value>
            </parameter>
            <parameter name="show_lastday" required="false" xsi:type="select" visible="true" sort_order="62">
                <label translate="true">Replace message with "Last Day" on the last day of countdown</label>
                <options>
                    <option name="yes" value="1"><label translate="true">Yes</label></option>
                    <option name="no" value="0" selected="true"><label translate="true">No</label></option>
                </options>
            </parameter>
            <parameter name="more_btn" required="false" xsi:type="select" visible="true" sort_order="70">
                <label translate="true">Show "More Information" Button</label>
                <description>Opens up a popup window</description>
                <options>
                    <option name="yes" value="1"><label translate="true">Yes</label></option>
                    <option name="no" value="0" selected="true"><label translate="true">No</label></option>
                </options>
            </parameter>
            <parameter name="moreinfo_label" required="false" sort_order="75" visible="true" xsi:type="text">
                <label translate="true">More Information Text</label>
                <description>Custom "More Information" Button Text</description>
                <depends>
                    <parameter name="more_btn" value="1"/>
                </depends>
                <value>More information</value>
            </parameter>
            <parameter name="moreinfo_content" required="false" sort_order="80" visible="true" xsi:type="block">
                <label translate="true">More Information Content</label>
                <description>More information to show in the popup window</description>
                <depends>
                    <parameter name="more_btn" value="1"/>
                </depends>
                <block class="CarpetAvenue\Widget\Block\Adminhtml\Widget\Editor"/>
            </parameter>
        </parameters>
    </widget>

    <!-- ============================================================ -->
