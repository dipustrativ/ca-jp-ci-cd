                    <option name="default" value="CarpetAvenue_Widget::widget/callout.phtml">
                        <label>Default</label>
                    </option>
                    <option name="callout_product" value="CarpetAvenue_Widget::widget/callout_product.phtml">
                        <label>Callout Product</label>
                    </option>
                </options>
            </parameter>
