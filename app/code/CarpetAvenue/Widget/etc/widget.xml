    <!-- ============================================================ -->
    <!-- Image Link Widget                                             -->
    <!-- ============================================================ -->
    <widget class="CarpetAvenue\Widget\Block\Widget\ImageLinkWidget" id="carpetavenue_imagelink_widget">
        <label>Image Link widget</label>
        <description>Display a linked image with specified url</description>
        <parameters>
            <parameter name="image" xsi:type="block" required="true" visible="true" sort_order="10">
                <label translate="true">Image</label>
                <block class="CarpetAvenue\Widget\Block\Adminhtml\Widget\ImageChooser">
                    <data>
                        <item name="button" xsi:type="array">
                            <item name="open" xsi:type="string">Choose Image...</item>
                        </item>
                    </data>
                </block>
            </parameter>
            <parameter name="titleurl" xsi:type="text" required="true" visible="true" sort_order="20">
                <label translate="true">Link URL</label>
                <description>The link URL for the image</description>
            </parameter>
        </parameters>
    </widget>

    <!-- ============================================================ -->
    <!-- Category List Widget                                         -->
    <!-- ============================================================ -->
    <widget class="CarpetAvenue\Widget\Block\Widget\CategoryList" id="carpetavenue_categorylist_widget">
        <label>Category List</label>
        <description>List Categories</description>
        <parameters>
            <parameter name="template" xsi:type="select" required="true" visible="true">
                <label translate="true">Template</label>
                <options>
                    <option name="default" value="CarpetAvenue_Widget::category/widget/grid.phtml" selected="true">
                        <label translate="true">Category List</label>
                    </option>
                    <option name="with_description" value="CarpetAvenue_Widget::category/widget/grid_description.phtml" selected="false">
                        <label translate="true">Category List with Description</label>
                    </option>
                </options>
            </parameter>
            <parameter name="cache_lifetime" xsi:type="text" visible="true">
                <label translate="true">Cache Lifetime (Seconds)</label>
                <description translate="true">
                    <![CDATA[Time in seconds between the widget updates.
                    <br/>If not set, equals to 86400 seconds (24 hours). To update widget instantly, go to Cache Management and clear Blocks HTML Output cache.
                    <br/>Widget will not show products that begin to match the specified conditions until cache is refreshed.]]>
                </description>
            </parameter>
            <parameter name="category_page_size" sort_order="10" visible="true" xsi:type="text" required="true">
                <label>Amount of subcategories</label>
            </parameter>
            <parameter name="category_id" sort_order="20" source_model="CarpetAvenue\Widget\Model\Config\Source\Category" visible="true" xsi:type="select">
                <label>Category Id which sub-categories will show</label>
            </parameter>
            <parameter name="category_depth" sort_order="30" visible="true" xsi:type="text" required="false">
                <label>Category level depth</label>
                <description translate="true">
                    <![CDATA[Default 1 level of sub-categories.]]>
                </description>
            </parameter>
        </parameters>
    </widget>

    <!-- ============================================================ -->
    <!-- Call To Action Banner Widget                                  -->
    <!-- ============================================================ -->
    <widget class="CarpetAvenue\Widget\Block\Widget\CtaWidget" id="evalent_cta_widget">
        <label>Call To Action Banner widget (OLD)</label>
        <description>Display a CTA banner with an image and background color in a 2 column layout</description>
        <parameters>
            <parameter name="title" required="false" sort_order="10" visible="true" xsi:type="text">
                <label translate="true">Title</label>
                <description>The heading text.</description>
            </parameter>
            <parameter name="description" required="false" sort_order="20" visible="true" xsi:type="block">
                <label translate="true">Description</label>
                <description>The description content text.</description>
                <block class="CarpetAvenue\Widget\Block\Adminhtml\Widget\Editor"/>
            </parameter>
            <parameter name="button_text" required="false" sort_order="30" visible="true" xsi:type="text">
                <label translate="true">Button text</label>
                <description>The button text. Leave empty to not show the button.</description>
            </parameter>
            <parameter name="button_link" required="true" sort_order="40" visible="true" xsi:type="text">
                <label translate="true">Button URL</label>
