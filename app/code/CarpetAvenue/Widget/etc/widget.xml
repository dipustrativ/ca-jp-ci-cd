            <parameter name="fontsize_timer" xsi:type="text" visible="true" sort_order="41">
                <label translate="true">Font Size of Timer (days/hours/minutes)</label>
                <description>E.g: 16px</description>
            </parameter>
            <parameter name="fontweight" xsi:type="text" visible="true" sort_order="45">
