            </parameter>
            <parameter name="countdown" required="true" xsi:type="block" visible="true" sort_order="60">
                <label translate="true">Countdown To Date</label>
                <description>If set, will show countdown to the given date</description>
                <block class="CarpetAvenue\Widget\Block\Adminhtml\Widget\DatePicker"/>
            </parameter>
            <parameter name="countdown_days_before" xsi:type="text" required="false" visible="true" sort_order="61">
                <label translate="true">Show Countdown X Days Before End</label>
                <description>Timer will only show when countdown reaches this limit (1 or more days, 0 to always show)</description>
