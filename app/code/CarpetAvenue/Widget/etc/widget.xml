            <parameter name="countdown_days_before" xsi:type="text" required="false" visible="true" sort_order="61">
                <label translate="true">Show Countdown X Days Before End</label>
                <description>Timer will only show when countdown reaches this limit (1 or more days, 0 to always show)</description>
                <value>0</value>
            </parameter>
            <parameter name="show_lastday" required="false" xsi:type="select" visible="true" sort_order="62">
                <label translate="true">Replace message with "Last Day" on the last day of countdown</label>
