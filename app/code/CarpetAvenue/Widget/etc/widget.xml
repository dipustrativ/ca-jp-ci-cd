    <!-- CMS Static Section Block (ported from Evalent_SectionBlock)  -->
    <!-- ============================================================ -->
    <widget id="cms_static_section" class="CarpetAvenue\Widget\Block\Widget\SectionBlock"
            placeholder_image="Magento_Cms::images/widget_block.png">
        <label translate="true">CMS Static Section Block</label>
        <description translate="true">Contents of a Static Section Block</description>
        <parameters>
            <parameter name="background_color" xsi:type="select" visible="true" required="true" sort_order="10">
                <label translate="true">Section Background Color</label>
                <options>
                    <option name="default" value="false" selected="true">
                        <label translate="true">No color</label>
                    </option>
                    <option name="background_color" value="background_color">
                        <label translate="true">Light color</label>
                    </option>
                    <option name="background_color_darker" value="background_color_darker">
                        <label translate="true">Darker color</label>
                    </option>
                    <option name="pattern" value="pattern">
                        <label translate="true">Use pattern</label>
                    </option>
                </options>
            </parameter>
            <parameter name="border" xsi:type="select" visible="true" required="true" sort_order="20">
                <label translate="true">Section Border</label>
                <options>
                    <option name="default" value="false" selected="true">
                        <label translate="true">None</label>
                    </option>
                    <option name="border" value="true">
                        <label translate="true">Use Border</label>
                    </option>
                </options>
            </parameter>
            <parameter name="block_id" xsi:type="block" visible="true" required="true" sort_order="30">
                <label translate="true">Block</label>
                <block class="Magento\Cms\Block\Adminhtml\Block\Widget\Chooser">
                    <data>
                        <item name="button" xsi:type="array">
                            <item name="open" xsi:type="string" translate="true">Select Block...</item>
                        </item>
                    </data>
                </block>
            </parameter>
            <parameter name="template" xsi:type="select" visible="true" required="true" sort_order="40">
                <label translate="true">Template</label>
                <options>
                    <option name="default" value="widget/static_block/default.phtml" selected="true">
                        <label translate="true">CMS Static Block Section Default Template</label>
                    </option>
                    <option name="no_padding" value="widget/static_block/default_nopadding.phtml">
                        <label translate="true">CMS Static Block Section (No padding) Template</label>
                    </option>
                </options>
            </parameter>
            <parameter name="mobile_hide" required="false" xsi:type="select" visible="true" sort_order="50">
                <label translate="true">Hide on mobile</label>
                <description>Hide this section on mobile</description>
                <options>
                    <option name="no" value="0" selected="true">
                        <label translate="true">No</label>
                    </option>
                    <option name="yes" value="1">
                        <label translate="true">Yes</label>
                    </option>
                </options>
            </parameter>
        </parameters>
    </widget>

    <!-- ============================================================ -->
    <!-- Product SKU Slider Widget                                     -->
    <!-- ============================================================ -->
    <widget class="CarpetAvenue\Widget\Block\Widget\ProductSkuSlider" id="carpetavenue_product_sku_slider_widget">
        <label>Product SKU Slider</label>
        <description>Show hand-picked products (by comma-separated SKUs) as a slider.</description>
        <parameters>
            <parameter name="title" xsi:type="text" required="false" visible="true" sort_order="5">
                <label translate="true">Title</label>
                <description>Optional heading above the slider. Leave empty for no title. For a per-store title, either assign this widget to a single store view, or translate the text via the theme/module i18n CSV.</description>
            </parameter>
            <parameter name="view_all_url" xsi:type="text" required="false" visible="true" sort_order="7">
                <label translate="true">"View all" link URL</label>
                <description>Optional. If set, a translatable "View all" link shows on the right of the title. Absolute (https://...) or store-relative (e.g. all-carpets).</description>
            </parameter>
            <parameter name="skus" xsi:type="text" required="true" visible="true" sort_order="10">
                <label translate="true">Product SKUs</label>
                <description>Comma-separated SKUs, in the order they should appear. E.g: SKU-1, SKU-2, SKU-3</description>
            </parameter>
            <parameter name="slides_to_show" xsi:type="text" required="true" visible="true" sort_order="20">
                <label translate="true">Products visible at once</label>
                <description>How many products show at a time; the rest become slides. Default 5.</description>
                <value>5</value>
            </parameter>
            <parameter name="cache_lifetime" xsi:type="text" visible="true" sort_order="30">
                <label translate="true">Cache Lifetime (Seconds)</label>
                <description translate="true">
                    <![CDATA[Time in seconds between the widget updates.
                    <br/>If not set, equals to 3600 seconds. To update widget instantly, go to Cache Management and clear Blocks HTML Output cache.]]>
                </description>
            </parameter>
        </parameters>
    </widget>

</widgets>
