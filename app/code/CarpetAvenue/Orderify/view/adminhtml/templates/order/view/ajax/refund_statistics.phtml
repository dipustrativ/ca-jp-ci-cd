<?php
/** @var CarpetAvenue\Orderify\Block\Adminhtml\Order\Ajax\RefundStatistic $block */
$order = $block->getOrder();
$refundOrderByEmail = $block->getRefundStatisticByEmail($order->getCustomerEmail());
$streetAddress = $order?->getShippingAddress()?->getData('street');
if (is_array($streetAddress)) {
    $streetAddress = implode(' ', $streetAddress);
}
$refundOrderByStreetAddress = $block->getRefundStatisticByStreetAddress($streetAddress);
if ($order->getData('x_forwarded_for')) {
    $remoteIP = explode(',', $order->getData('x_forwarded_for'))[0];
} else {
    $remoteIP = null;
}
$refundOrderByIP = $block->getRefundStatisticByIP($remoteIP);
$blackDetails = $block->getBlackList();

?>

<div class="admin__page-section-title">
    <span class="title"><?= __('Refund Statistics') ?></span>
</div>

<div class="admin__page-section-content overview-wrapper">

