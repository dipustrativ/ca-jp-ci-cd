<style>
    .small-modal .modal-inner-wrap {
        width: 400px !important;
        max-width: 90%;
    }
</style>

<script type="text/javascript">
    require([
        'jquery',
        'Magento_Ui/js/modal/modal'
    ], function ($, modal) {

        const options = {
            type: 'popup',
            modalClass: 'small-modal',
            buttons: [
                /*{
                    text: 'Close',
                    click: function () {
                        this.closeModal();
                    }
                }*/
            ]
        };

        modal(options, $('#modal-content'));

        $('.refund_statistic_orders_button').click(function () {
            $('#modal-content').modal('openModal');
            const title = $(this).data('refund_statistic_title');
            const details = $(this).data('refund_statistic_details');
            let contentHtml = '<h2>' + title + '</h2>';
            contentHtml += '<ul>';
            if (details.all_refund_orders) {
                let orders = details.all_refund_orders.split(",");
                if (orders.length > 0) {
                    orders.forEach(function(orderId) {
                        const order = orderId.split("--");
                        if (order.length === 2) {
                            contentHtml += '<li style="padding: 5px 5px">' +
                                '<a href="<?= $block->getOrderUrl('ORDER_ID_PLACEHOLDER') ?>'.replace('ORDER_ID_PLACEHOLDER', order[1]) + '" target="_blank">' +
                                order[0] +
                                '</a></li>';
                        }
                    });
                }
            } else {
                contentHtml += '<li>No orders found.</li>';
            }
            contentHtml += '</ul>';
            $('#modal_popup_content').html(contentHtml);
        });

        $('.add_in_black_list_button').click(function () {
            $('#modal-content').modal('openModal');
            let contentHtml = `
                <h2 style="margin-bottom:15px;"><?= __('Add to Black List') ?></h2>

                <form id="blacklist_form" style="font-size:14px;margin-top: 25px" action="<?= $block->getAddToBlackListUrl(); ?>" method="POST">
                    <input name="form_key" type="hidden" value="<?= $block->getFormKey() ?>" />
                    <input name="order_id" type="hidden" value="<?= $order->getEntityId() ?>" />

                    <label for="blacklist_type" style="font-weight:600; display:block; margin-bottom:5px;">
                        <?= __('Type:') ?> <span style="color:red;">*</span>
                    </label>

                    <select id="blacklist_type" name="blacklist_type" required="true" style="width:100%; padding:8px; border:1px solid #ccc; border-radius:4px;">
                        <option value="">-- Select --</option>
                        <option value="email">Email</option>
                        <option value="address">Address</option>
                        <option value="ip">IP</option>
                    </select>

                    <br><br>

                    <label for="blacklist_reason" style="font-weight:600; display:block; margin-bottom:5px;">
                        <?= __('Reason:') ?>
                    </label>

                    <textarea id="blacklist_reason" name="blacklist_reason" rows="5" cols="45"
                        style="width:100%; padding:8px; border:1px solid #ccc; border-radius:4px;"></textarea>

                    <br><br>

                    <button type="submit" id="submit_blacklist"
                        style="background:#1979c3; color:#fff; border:none; padding:10px 18px; border-radius:4px; cursor:pointer;">
                        <?= __('Submit') ?>
                    </button>

                </form>
            `;


            $('#modal_popup_content').html(contentHtml);
        })

        $('.remove_in_black_list_button').click(function () {
            let blacklistId = $(this).data('blacklist_id');
            if (confirm('Are you sure you want to remove this item from the blacklist?')) {
                window.location.href = "<?= $block->getBlackListRemoveUrl('ID_PLACEHOLDER') ?>".replace('ID_PLACEHOLDER', Number(blacklistId));
            }
        });

    });
</script>