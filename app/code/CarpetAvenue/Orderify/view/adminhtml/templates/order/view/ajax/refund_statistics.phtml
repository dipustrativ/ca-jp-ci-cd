        <div class="overview-text">
            <strong>Email: <?= $order->getCustomerEmail()?></strong> <br/>
            <strong>Total Refund: <?= $refundOrderByEmail['total_refund'] ?? 0?></strong> <br/>
            <?php if (isset($refundOrderByEmail['total_refund'])): ?>
