<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Event/etc/events.xsd">
    <event name="customer_register_success">
        <observer name="carpetavenue_b2b_set_pending" instance="CarpetAvenue\B2B\Observer\SetPendingOnRegister"/>
    </event>
    <event name="controller_action_predispatch_checkout_index_index">
        <observer name="carpetavenue_b2b_block_checkout" instance="CarpetAvenue\B2B\Observer\BlockCheckout"/>
    </event>
    <event name="controller_action_predispatch_onestepcheckout_index_index">
        <observer name="carpetavenue_b2b_block_osc" instance="CarpetAvenue\B2B\Observer\BlockCheckout"/>
    </event>
</config>
