<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="carpetavenue_b2b_reseller_application" resource="default" engine="innodb" comment="B2B Reseller Applications">
        <column xsi:type="int" name="application_id" unsigned="true" nullable="false" identity="true" comment="Application ID"/>
        <column xsi:type="varchar" name="name" nullable="false" length="255" comment="Applicant Name"/>
        <column xsi:type="varchar" name="email" nullable="false" length="255" comment="Applicant Email"/>
        <column xsi:type="varchar" name="company_name" nullable="false" length="255" comment="Company Name"/>
        <column xsi:type="varchar" name="homepage" nullable="true" length="255" comment="Homepage / Website"/>
        <column xsi:type="varchar" name="business_type" nullable="false" length="100" comment="Type of Business"/>
        <column xsi:type="varchar" name="sales_channels" nullable="false" length="100" comment="Sales Channels"/>
        <column xsi:type="text" name="message" nullable="false" comment="Message"/>
        <column xsi:type="varchar" name="status" nullable="false" length="32" default="new" comment="Application Status"/>
        <column xsi:type="smallint" name="store_id" unsigned="true" nullable="true" comment="Store ID"/>
        <column xsi:type="int" name="customer_id" unsigned="true" nullable="true" comment="Customer ID (if logged in)"/>
        <column xsi:type="timestamp" name="created_at" nullable="false" default="CURRENT_TIMESTAMP" on_update="false" comment="Submission Time"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="application_id"/>
        </constraint>
        <index referenceId="CARPETAVENUE_B2B_RESELLER_APPLICATION_EMAIL" indexType="btree">
            <column name="email"/>
        </index>
        <index referenceId="CARPETAVENUE_B2B_RESELLER_APPLICATION_STATUS" indexType="btree">
            <column name="status"/>
        </index>
        <index referenceId="CARPETAVENUE_B2B_RESELLER_APPLICATION_CREATED_AT" indexType="btree">
            <column name="created_at"/>
        </index>
    </table>
</schema>
