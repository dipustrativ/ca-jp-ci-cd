<script>
require(['jquery'], function ($) {
    'use strict';

    var MAX_UI_ROWS = 50;

    // Pre-validate row count using FileReader before submit
    $('#ca-mb-csv-file').on('change', function () {
        var file = this.files && this.files[0];
        if (!file) { return; }
        var reader = new FileReader();
        reader.onload = function (e) {
            var lines    = e.target.result.split('\n').filter(function (l) { return l.trim() !== ''; });
            var dataRows = lines.length - 1;
            if (dataRows > MAX_UI_ROWS) {
                alert(
                    '<?= $block->escapeJs(__('This CSV has ')) ?>' + dataRows +
                    '<?= $block->escapeJs(__(' rows — exceeds the UI limit of 50.')) ?>' +
                    '\n\n<?= $block->escapeJs(__('Use the CLI for large batches. Upload the CSV via the config panel to get the saved path, then run:')) ?>' +
                    '\nbin/magento carpetavenue:media:manual-backup --csv=...'
                );
                $('#ca-mb-csv-file').val('');
            }
        };
        reader.readAsText(file);
    });

    $('#ca-manualbackup-form').on('submit', function () {
        if (!$('#ca-mb-csv-file').val()) {
            alert('<?= $block->escapeJs(__('Please select a CSV file.')) ?>');
            return false;
        }
        $('#ca-mb-submit').prop('disabled', true);
        $('#ca-mb-spinner').show();
    });
});
</script>
