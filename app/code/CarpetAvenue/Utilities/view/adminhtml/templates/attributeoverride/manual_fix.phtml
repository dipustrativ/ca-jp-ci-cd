                    <th><?= $block->escapeHtml(__('Intended Value')) ?></th>
                </tr>
            </thead>
            <tbody id="ca-preview-body"></tbody>
        </table>
        <p id="ca-preview-empty" style="display:none;color:#2e7d32;"><?= $block->escapeHtml(__('✓ No changes needed — all values match intended.')) ?></p>
    </div>

    <!-- ── Fix result ───────────────────────────────────────────────── -->
    <div id="ca-fix-result" style="margin-top:20px;display:none;"></div>

</div>

<script>
(function () {
    'use strict';

    const form       = document.getElementById('ca-override-form');
    const btnDryRun  = document.getElementById('ca-btn-dryrun');
    const btnRunFix  = document.getElementById('ca-btn-runfix');
    const spinner    = document.getElementById('ca-spinner');
    const msgBox     = document.getElementById('ca-message');
    const previewWrap  = document.getElementById('ca-preview-wrap');
    const previewBody  = document.getElementById('ca-preview-body');
    const previewEmpty = document.getElementById('ca-preview-empty');
    const fixResult  = document.getElementById('ca-fix-result');

    // Track current form signature to reset Run Fix button when form changes
    let dryRunSignature = null;

    // ── Type → show/hide fields ──────────────────────────────────────
    document.getElementById('ca_type').addEventListener('change', function () {
        document.querySelectorAll('.ca-field-price, .ca-field-image, .ca-field-custom')
            .forEach(el => el.style.display = 'none');
        if (this.value === 'price')  document.querySelector('.ca-field-price').style.display  = '';
        if (this.value === 'image')  document.querySelector('.ca-field-image').style.display  = '';
        if (this.value === 'custom') document.querySelector('.ca-field-custom').style.display = '';
        resetDryRun();
    });

    // ── Scope → show/hide textarea ───────────────────────────────────
    document.querySelectorAll('input[name="scope"]').forEach(function (radio) {
        radio.addEventListener('change', function () {
            document.querySelector('.ca-scope-values').style.display = this.value !== 'all' ? '' : 'none';
            resetDryRun();
        });
    });

    // Any form change → reset dry-run unlock
    form.addEventListener('change', resetDryRun);

    function resetDryRun() {
        btnRunFix.disabled = true;
        btnRunFix.title    = '<?= $block->escapeJs(__('Run dry-run first to unlock')) ?>';
        dryRunSignature    = null;
        previewWrap.style.display = 'none';
        fixResult.style.display   = 'none';
        clearMessage();
    }

    // ── Dry-run ──────────────────────────────────────────────────────
    btnDryRun.addEventListener('click', function () {
        const params = collectParams();
        if (!params) return;

        setWorking(true);
        clearMessage();
        previewWrap.style.display = 'none';
        fixResult.style.display   = 'none';

        fetch('<?= $block->escapeJs($dryRunUrl) ?>', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: new URLSearchParams(params),
        })
        .then(r => r.json())
        .then(function (data) {
            if (!data.success) {
                showMessage(data.message, 'error');
                return;
            }

            renderPreview(data.preview || []);
            showMessage(data.message, data.total > 0 ? 'warning' : 'success');

            // Unlock Run Fix only if there are rows to fix
            if (data.total > 0) {
                dryRunSignature    = JSON.stringify(params);
                btnRunFix.disabled = false;
                btnRunFix.title    = '';
            }
        })
        .catch(function (err) { showMessage('Request failed: ' + err, 'error'); })
        .finally(function ()  { setWorking(false); });
    });

    // ── Run Fix ──────────────────────────────────────────────────────
    btnRunFix.addEventListener('click', function () {
        if (!confirm('<?= $block->escapeJs(__('This will write to the database and backup current values to CSV. Proceed?')) ?>')) {
            return;
        }

        const params = collectParams();
        if (!params) return;

        // Safety: re-check signature hasn't changed
        if (dryRunSignature !== JSON.stringify(params)) {
            showMessage('<?= $block->escapeJs(__('Form changed since last dry-run. Please run dry-run again.')) ?>', 'error');
            resetDryRun();
            return;
        }

        setWorking(true);
        clearMessage();
        fixResult.style.display = 'none';

        fetch('<?= $block->escapeJs($runFixUrl) ?>', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: new URLSearchParams(params),
        })
        .then(r => r.json())
        .then(function (data) {
            if (!data.success) {
                showMessage(data.message, 'error');
                return;
            }
            renderFixResult(data);
            showMessage(data.message, data.errors > 0 ? 'warning' : 'success');
            btnRunFix.disabled = true;
            dryRunSignature    = null;
        })
        .catch(function (err) { showMessage('Request failed: ' + err, 'error'); })
        .finally(function ()  { setWorking(false); });
    });

    // ── Helpers ──────────────────────────────────────────────────────

    function collectParams() {
        const type    = document.getElementById('ca_type').value;
        const storeId = document.getElementById('ca_store_id').value;

        if (!type) { showMessage('<?= $block->escapeJs(__('Please select a type.')) ?>', 'error'); return null; }
        if (!storeId) { showMessage('<?= $block->escapeJs(__('Please select a store view.')) ?>', 'error'); return null; }

        let attribute = '';
        if (type === 'price')  attribute = document.getElementById('ca_attr_price').value;
        if (type === 'custom') attribute = document.getElementById('ca_attr_custom').value;

        if (type !== 'image' && !attribute) {
            showMessage('<?= $block->escapeJs(__('Please select an attribute.')) ?>', 'error');
            return null;
        }

        const scope       = document.querySelector('input[name="scope"]:checked').value;
        const scopeValues = document.getElementById('ca_scope_values').value;
        const imageType   = document.getElementById('ca_image_type').value;

        if (scope !== 'all' && !scopeValues.trim()) {
            showMessage('<?= $block->escapeJs(__('Please enter SKUs or IDs.')) ?>', 'error');
            return null;
        }

        return {
            form_key:     '<?= $block->escapeJs($formKey) ?>',
            type:         type,
            attribute:    attribute,
            image_type:   imageType,
            scope:        scope,
            scope_values: scopeValues,
            store_id:     storeId,
        };
    }

    function renderPreview(rows) {
        previewBody.innerHTML = '';
        if (rows.length === 0) {
            previewEmpty.style.display = '';
            previewWrap.style.display  = '';
            return;
        }
        previewEmpty.style.display = 'none';
        rows.forEach(function (r) {
            const tr = document.createElement('tr');
            tr.innerHTML = [r.entity_id, esc(r.sku), r.store_id, esc(r.attribute_code), esc(r.current_value), esc(r.intended_value)]
                .map(v => '<td>' + v + '</td>').join('');
            previewBody.appendChild(tr);
        });
        previewWrap.style.display = '';
    }

    function renderFixResult(data) {
        fixResult.innerHTML =
            '<div style="background:#e8f5e9;border:1px solid #a5d6a7;padding:12px 16px;border-radius:4px;">' +
            '<strong><?= $block->escapeJs(__('Fix applied.')) ?></strong><br/>' +
            '<?= $block->escapeJs(__('Processed')) ?>: ' + data.processed + ' &nbsp;|&nbsp; ' +
            '<?= $block->escapeJs(__('Fixed')) ?>: ' + data.fixed + ' &nbsp;|&nbsp; ' +
            '<?= $block->escapeJs(__('Errors')) ?>: ' + data.errors +
            (data.csv_filename ? '<br/><?= $block->escapeJs(__('Backup CSV')) ?>: <code>' + esc(data.csv_filename) + '</code>' : '') +
            '</div>';
        fixResult.style.display = '';
    }

    function setWorking(on) {
        spinner.style.display   = on ? '' : 'none';
        btnDryRun.disabled      = on;
        if (!on && dryRunSignature) btnRunFix.disabled = false;
    }

    function showMessage(msg, type) {
        const colors = { success: '#d4edda', error: '#f8d7da', warning: '#fff3cd' };
        const borders = { success: '#c3e6cb', error: '#f5c6cb', warning: '#ffeeba' };
        msgBox.innerHTML = '<div style="background:' + (colors[type]||colors.warning) + ';border:1px solid ' + (borders[type]||borders.warning) + ';padding:10px 14px;border-radius:4px;">' + msg + '</div>';
        msgBox.style.display = '';
    }

    function clearMessage() {
        msgBox.innerHTML     = '';
        msgBox.style.display = 'none';
    }

    function esc(str) {
        if (str === null || str === undefined) return '<em style="color:#999">null</em>';
        return String(str).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
    }

}());
</script>
