<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <head>
        <css src="IXPF_Syncer::css/docs.css"/>
    </head>
    <body>
        <referenceContainer name="content">
            <block class="Magento\Framework\View\Element\Template"
                   name="ixpfsyncer.docs.list"
                   template="IXPF_Syncer::docs/list.phtml">
                <arguments>
                    <argument name="view_model" xsi:type="object">IXPF\Syncer\ViewModel\Docs\DocsList</argument>
                </arguments>
            </block>
        </referenceContainer>
    </body>
</page>
