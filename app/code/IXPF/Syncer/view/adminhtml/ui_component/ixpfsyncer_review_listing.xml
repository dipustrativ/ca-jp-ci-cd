<?xml version="1.0"?>
<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">

    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">ixpfsyncer_review_listing.ixpfsyncer_review_listing_data_source</item>
        </item>
    </argument>

    <settings>
        <deps>
            <dep>ixpfsyncer_review_listing.ixpfsyncer_review_listing_data_source</dep>
        </deps>
        <spinner>ixpfsyncer_review_columns</spinner>
    </settings>

    <dataSource name="ixpfsyncer_review_listing_data_source" component="Magento_Ui/js/grid/provider">
        <settings>
            <updateUrl path="mui/index/render"/>
            <storageConfig>
                <param name="indexField" xsi:type="string">entity_id</param>
            </storageConfig>
        </settings>
        <aclResource>IXPF_Syncer::product_reviews</aclResource>
        <dataProvider name="ixpfsyncer_review_listing_data_source"
                      class="Magento\Framework\View\Element\UiComponent\DataProvider\DataProvider">
            <settings>
                <requestFieldName>entity_id</requestFieldName>
                <primaryFieldName>entity_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>

    <listingToolbar name="listing_top">
        <settings>
            <sticky>true</sticky>
        </settings>
        <bookmark name="bookmarks"/>
        <columnsControls name="columns_controls"/>
        <filters name="listing_filters"/>
        <paging name="listing_paging"/>
    </listingToolbar>

    <columns name="ixpfsyncer_review_columns">
        <column name="entity_id" sortOrder="10">
            <settings>
                <label translate="true">ID</label>
                <filter>textRange</filter>
            </settings>
        </column>
        <column name="review_id" sortOrder="20">
            <settings>
                <label translate="true">IXPF Review ID</label>
                <filter>text</filter>
                <dataScope>review_id</dataScope>
            </settings>
        </column>
        <column name="review_group" sortOrder="30">
            <settings>
                <label translate="true">Review Group</label>
                <filter>text</filter>
                <dataScope>review_group</dataScope>
            </settings>
        </column>
        <column name="sku" sortOrder="40">
            <settings>
                <label translate="true">SKU</label>
                <filter>text</filter>
                <dataScope>sku</dataScope>
            </settings>
        </column>
        <column name="rating" sortOrder="50">
            <settings>
                <label translate="true">Rating</label>
                <filter>textRange</filter>
                <dataScope>rating</dataScope>
            </settings>
        </column>
        <column name="reviewer" sortOrder="60">
            <settings>
                <label translate="true">Reviewer</label>
                <filter>text</filter>
                <dataScope>reviewer</dataScope>
            </settings>
        </column>
        <column name="source_locale" sortOrder="70">
            <settings>
                <label translate="true">Source Locale</label>
                <filter>text</filter>
                <dataScope>source_locale</dataScope>
            </settings>
        </column>
        <column name="source_store_code" sortOrder="80">
            <settings>
                <label translate="true">Source Store</label>
                <filter>text</filter>
                <dataScope>source_store_code</dataScope>
            </settings>
        </column>
        <!-- Locale-keyed JSON shown as en_US; the filter searches every language. -->
        <column name="bought_variant_texts" class="IXPF\Syncer\Ui\Component\Listing\Column\ReviewGroupLabel" sortOrder="90">
            <settings>
                <label translate="true">Bought</label>
                <filter>text</filter>
                <dataScope>bought_variant_texts</dataScope>
                <sortable>false</sortable>
                <visible>false</visible>
            </settings>
        </column>
        <!-- Denormalised on ixpf_review by the upsert so the photo filter is one indexed column
             rather than a join against ixpf_review_photo. -->
        <column name="has_photos" component="Magento_Ui/js/grid/columns/select" sortOrder="100">
            <settings>
                <options class="IXPF\Syncer\Model\Source\ReviewHasPhotos"/>
                <label translate="true">Photos</label>
                <filter>select</filter>
                <dataType>select</dataType>
                <dataScope>has_photos</dataScope>
            </settings>
        </column>
        <column name="created_at" class="Magento\Ui\Component\Listing\Columns\Date" component="Magento_Ui/js/grid/columns/date" sortOrder="120">
            <settings>
                <label translate="true">Written At</label>
                <filter>dateRange</filter>
                <dataType>date</dataType>
                <dataScope>created_at</dataScope>
                <sorting>desc</sorting>
            </settings>
        </column>
        <column name="purchased_at" class="Magento\Ui\Component\Listing\Columns\Date" component="Magento_Ui/js/grid/columns/date" sortOrder="130">
            <settings>
                <label translate="true">Purchased At</label>
                <filter>dateRange</filter>
                <dataType>date</dataType>
                <dataScope>purchased_at</dataScope>
                <visible>false</visible>
            </settings>
        </column>
    </columns>
</listing>
