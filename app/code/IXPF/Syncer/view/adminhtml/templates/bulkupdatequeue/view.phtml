<script>
require([
    'jquery',
    'IXPF_Syncer/js/json-viewer'
], function($, jsonViewer) {
    'use strict';

    $(document).ready(function() {
        // Initialize JSON viewers
        jsonViewer.init();

        // Collapse all functionality
        $('.collapse-all').on('click', function() {
            var target = $(this).data('target');
            $('#' + target).find('.json-toggle-expanded').each(function() {
                $(this).click();
            });
        });

        // Expand all functionality
        $('.expand-all').on('click', function() {
            var target = $(this).data('target');
            $('#' + target).find('.json-toggle-collapsed').each(function() {
                $(this).click();
            });
        });
    });
});
</script>

