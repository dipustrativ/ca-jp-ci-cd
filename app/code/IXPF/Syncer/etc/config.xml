<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Store:etc/config.xsd">
    <default>
        <ixpfng_order>
            <order_create>
                <enabled>0</enabled>
                <allow_oversell>0</allow_oversell>
            </order_create>
        </ixpfng_order>
        <ixpfng_purchase>
            <purchase>
                <root_category_id>1</root_category_id>
            </purchase>
        </ixpfng_purchase>
        <!-- AttributeMassUpdate writes no stock/source data until this is turned on. -->
        <ixpfng_product>
            <product_update_config>
                <allow_stock_source>0</allow_stock_source>
            </product_update_config>
        </ixpfng_product>
        <!-- Both switches default off: nothing is sent to IXPF and no source item is
             written until each side is turned on deliberately. -->
        <ixpfng_reservation>
            <general>
                <enabled>1</enabled>
                <inbound_enabled>0</inbound_enabled>
                <auto_assign_source>1</auto_assign_source>
                <max_attempts>10</max_attempts>
                <dispatch_limit>50</dispatch_limit>
            </general>
        </ixpfng_reservation>
        <ixpf_reviews>
            <general>
                <enabled>0</enabled>
                <show_on_frontend>1</show_on_frontend>
                <per_page>10</per_page>
                <warn_threshold>2000</warn_threshold>
                <!-- Without a stored value every entry would count as a bare rating. -->
                <review_criteria>text,photo,sub_ratings</review_criteria>
                <count_display>split</count_display>
                <show_photo_filter>1</show_photo_filter>
                <show_text_filter>0</show_text_filter>
                <reply_name>Carpet Avenue Customer Service</reply_name>
            </general>
            <media>
                <enabled>1</enabled>
            </media>
            <!-- The invite form stays off until its host is configured. -->
            <form>
                <enabled>0</enabled>
                <base_url/>
            </form>
        </ixpf_reviews>
    </default>
</config>
