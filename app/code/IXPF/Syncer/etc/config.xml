<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Store:etc/config.xsd">
    <default>
        <ixpfng_order>
            <order_create>
                <enabled>0</enabled>
                <allow_oversell>0</allow_oversell>
            </order_create>
        </ixpfng_order>
        <ixpfng_purchase>
            <purchase>
                <root_category_id>1</root_category_id>
            </purchase>
        </ixpfng_purchase>
        <ixpf_reviews>
            <general>
                <enabled>0</enabled>
                <show_on_frontend>1</show_on_frontend>
                <per_page>10</per_page>
                <warn_threshold>2000</warn_threshold>
            </general>
            <media>
                <enabled>1</enabled>
            </media>
        </ixpf_reviews>
    </default>
</config>
