<?xml version="1.0" ?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">

    <!-- store api -->
    <preference for="IXPF\Syncer\Api\Store\StoreApi" type="IXPF\Syncer\Model\Api\Store\Store"/>
    <preference for="IXPF\Syncer\Api\Store\StoreInformationResponseApi" type="IXPF\Syncer\Model\Api\Store\StoreInformationResponse"/>

    <!-- products api -->
    <preference for="IXPF\Syncer\Api\Product\ProductApi" type="IXPF\Syncer\Model\Api\Product\Product"/>
    <preference for="IXPF\Syncer\Api\Product\ProductListResponseApi" type="IXPF\Syncer\Model\Api\Product\ProductListResponse"/>
    <preference for="IXPF\Syncer\Api\Product\ProductResponseApi" type="IXPF\Syncer\Model\Api\Product\ProductResponse"/>

    <!--
        Reviews read service — PARKED. The Api interfaces, Model\Reviews\* and Services\Reviews\*
        classes these preferences pointed at were never committed, so di:compile aborted on
        ReviewProviderInterface. Everything that survived (view model, admin listings, layouts,
        tests) sits under dev/parked/ixpf-syncer-reviews/ with its own README; the db_schema tables and the
        ixpf_reviews config section are untouched. Restore this block together with those files
        when the service layer lands.

        <preference for="IXPF\Syncer\Api\ReviewProviderInterface" type="IXPF\Syncer\Model\Reviews\ReviewProvider"/>
        <preference for="IXPF\Syncer\Api\Data\ReviewFilterInterface" type="IXPF\Syncer\Model\Reviews\ReviewFilter"/>
        <preference for="IXPF\Syncer\Api\Data\ReviewSummaryInterface" type="IXPF\Syncer\Model\Reviews\ReviewSummary"/>
        <preference for="IXPF\Syncer\Api\Data\ReviewListInterface" type="IXPF\Syncer\Model\Reviews\ReviewList"/>

        Reviews log through IXPF\Syncer\Helper\Logger\ReviewLogger, the same BaseLogger helper
        every other ixpf domain uses (photostudio, webhook, product, orders). No virtualType or
        Monolog handler needed: the helper is injected directly and picks its own folder, so
        activity lands in var/log/ixpf/review/review-[Y-m-d].log and Throwables in
        var/log/ixpf/exception/review-[Y-m-d].log.
    -->


    <type name="Magento\Sales\Api\OrderRepositoryInterface">
        <plugin name="carpetavenue_currency_order_extension" type="IXPF\Syncer\Plugin\OrderExtension" />
    </type>

    <type name="Magento\Sales\Api\Data\OrderInterface">
        <plugin name="add_default_name_to_order_items"
                type="IXPF\Syncer\Plugin\OrderItemDefaultName" />
    </type>

    <!--
        Comment-save webhooks. Adding a comment does not modify the parent row,
        so *_save_after never fires; hook the comment resource save instead and
        fire the parent webhook. One concrete subclass per parent type carries
        $type (virtualType as plugin type breaks di:compile — get_class_methods).
    -->
    <type name="Magento\Sales\Model\ResourceModel\Order\Status\History">
        <plugin name="ixpf_syncer_order_comment_webhook" type="IXPF\Syncer\Plugin\OrderCommentWebhook" />
    </type>
    <type name="Magento\Sales\Model\ResourceModel\Order\Invoice\Comment">
        <plugin name="ixpf_syncer_invoice_comment_webhook" type="IXPF\Syncer\Plugin\InvoiceCommentWebhook" />
    </type>
    <type name="Magento\Sales\Model\ResourceModel\Order\Shipment\Comment">
        <plugin name="ixpf_syncer_shipment_comment_webhook" type="IXPF\Syncer\Plugin\ShipmentCommentWebhook" />
    </type>
    <type name="Magento\Sales\Model\ResourceModel\Order\Creditmemo\Comment">
        <plugin name="ixpf_syncer_creditmemo_comment_webhook" type="IXPF\Syncer\Plugin\CreditmemoCommentWebhook" />
    </type>


    <!-- console commands -->
    <type name="Magento\Framework\Console\CommandList">
        <arguments>
            <argument name="commands" xsi:type="array">
                <item name="ixpf_syncer_purchase_command" xsi:type="object">IXPF\Syncer\Console\Commands\PurchaseCommand</item>
                <item name="ixpf_syncer_photostudio_command" xsi:type="object">IXPF\Syncer\Console\Commands\ProductGallerySync</item> <!-- legacy -->
                <item name="ixpf_syncer_photostudio_queue_command" xsi:type="object">IXPF\Syncer\Console\Commands\PhotoStudioQueueRun</item>
                <item name="ixpf_syncer_photostudio_image_download_command" xsi:type="object">IXPF\Syncer\Console\Commands\DownloadGoogleBucketImages</item>
            </argument>
        </arguments>
    </type>

    <virtualType name="IXPF\Syncer\Model\ResourceModel\IxpfWebhookJobs\Grid\Collection" type="Magento\Framework\View\Element\UiComponent\DataProvider\SearchResult">
        <arguments>
            <argument name="mainTable" xsi:type="string">ixpf_webhook_jobs</argument>
            <argument name="resourceModel" xsi:type="string">IXPF\Syncer\Model\ResourceModel\IxpfWebhookJobs</argument>
        </arguments>
    </virtualType>

    <virtualType name="IXPF\Syncer\Model\ResourceModel\IxpfPhotoStudioQueue\Grid\Collection" type="Magento\Framework\View\Element\UiComponent\DataProvider\SearchResult">
        <arguments>
            <argument name="mainTable" xsi:type="string">ixpf_photo_studio_queue</argument>
            <argument name="resourceModel" xsi:type="string">IXPF\Syncer\Model\ResourceModel\IxpfPhotoStudioQueue</argument>
        </arguments>
    </virtualType>
    <virtualType name="IXPF\Syncer\Model\ResourceModel\IxpfPurchaseOrder\Grid\Collection" type="Magento\Framework\View\Element\UiComponent\DataProvider\SearchResult">
        <arguments>
            <argument name="mainTable" xsi:type="string">ixpf_purchase_orders</argument>
            <argument name="resourceModel" xsi:type="string">IXPF\Syncer\Model\ResourceModel\IxpfPurchaseOrder</argument>
        </arguments>
    </virtualType>
    <virtualType name="IXPF\Syncer\Model\ResourceModel\IxpfPurchaseOrderProduct\Grid\Collection" type="Magento\Framework\View\Element\UiComponent\DataProvider\SearchResult">
        <arguments>
            <argument name="mainTable" xsi:type="string">ixpf_purchase_order_items</argument>
            <argument name="resourceModel" xsi:type="string">IXPF\Syncer\Model\ResourceModel\IxpfPurchaseOrderProduct</argument>
        </arguments>
    </virtualType>
    <virtualType name="IXPF\Syncer\Model\ResourceModel\IxpfProductBulkUpdateQueue\Grid\Collection" type="Magento\Framework\View\Element\UiComponent\DataProvider\SearchResult">
        <arguments>
            <argument name="mainTable" xsi:type="string">ixpf_product_bulk_update_queue</argument>
            <argument name="resourceModel" xsi:type="string">IXPF\Syncer\Model\ResourceModel\IxpfProductBulkUpdateQueue</argument>
        </arguments>
    </virtualType>


    <virtualType name="IXPF\Syncer\Model\ResourceModel\IxpfOrderApiActivity\Grid\Collection" type="Magento\Framework\View\Element\UiComponent\DataProvider\SearchResult">
        <arguments>
            <argument name="mainTable" xsi:type="string">ixpf_order_api_activity</argument>
            <argument name="resourceModel" xsi:type="string">IXPF\Syncer\Model\ResourceModel\IxpfOrderApiActivity</argument>
        </arguments>
    </virtualType>

    <virtualType name="IXPF\Syncer\Model\ResourceModel\IxpfReservation\Grid\Collection" type="Magento\Framework\View\Element\UiComponent\DataProvider\SearchResult">
        <arguments>
            <argument name="mainTable" xsi:type="string">ixpf_reservations</argument>
            <argument name="resourceModel" xsi:type="string">IXPF\Syncer\Model\ResourceModel\IxpfReservation</argument>
        </arguments>
    </virtualType>

    <!--
        PARKED with the reviews read service — the resource models these grid collections point at
        (IXPF\Syncer\Model\ResourceModel\IxpfReview, ...\IxpfReviewGroup) were never committed, and
        the listings that consumed them sit in dev/parked/ixpf-syncer-reviews/.

        <virtualType name="IXPF\Syncer\Model\ResourceModel\IxpfReview\Grid\Collection" type="Magento\Framework\View\Element\UiComponent\DataProvider\SearchResult">
            <arguments>
                <argument name="mainTable" xsi:type="string">ixpf_review</argument>
                <argument name="resourceModel" xsi:type="string">IXPF\Syncer\Model\ResourceModel\IxpfReview</argument>
            </arguments>
        </virtualType>

        identifierName is review_group, not entity_id: this table's primary key is the varchar
        join key itself and SearchResult otherwise assumes an "id" column that does not exist.
        <virtualType name="IXPF\Syncer\Model\ResourceModel\IxpfReviewGroup\Grid\Collection" type="Magento\Framework\View\Element\UiComponent\DataProvider\SearchResult">
            <arguments>
                <argument name="mainTable" xsi:type="string">ixpf_review_group</argument>
                <argument name="resourceModel" xsi:type="string">IXPF\Syncer\Model\ResourceModel\IxpfReviewGroup</argument>
                <argument name="identifierName" xsi:type="string">review_group</argument>
            </arguments>
        </virtualType>
    -->

    <type name="Magento\Framework\View\Element\UiComponent\DataProvider\CollectionFactory">
        <arguments>
            <argument name="collections" xsi:type="array">
                <item name="ixpfsyncer_webhook_listing_data_source" xsi:type="string">IXPF\Syncer\Model\ResourceModel\IxpfWebhookJobs\Grid\Collection</item>
                <item name="ixpfsyncer_productgallery_listing_data_source" xsi:type="string">IXPF\Syncer\Model\ResourceModel\IxpfPhotoStudioQueue\Grid\Collection</item>
                <item name="ixpfsyncer_purchaseorder_listing_data_source" xsi:type="string">IXPF\Syncer\Model\ResourceModel\IxpfPurchaseOrder\Grid\Collection</item>
                <item name="ixpfsyncer_purchaseorder_product_listing_data_source" xsi:type="string">IXPF\Syncer\Model\ResourceModel\IxpfPurchaseOrderProduct\Grid\Collection</item>
                <item name="ixpf_product_bulk_update_queue_listing_data_source" xsi:type="string">IXPF\Syncer\Model\ResourceModel\IxpfProductBulkUpdateQueue\Grid\Collection</item>
                <item name="ixpfsyncer_orderapiactivity_listing_data_source" xsi:type="string">IXPF\Syncer\Model\ResourceModel\IxpfOrderApiActivity\Grid\Collection</item>
                <item name="ixpfsyncer_reservations_listing_data_source" xsi:type="string">IXPF\Syncer\Model\ResourceModel\IxpfReservation\Grid\Collection</item>
                <!-- PARKED with the reviews read service:
                <item name="ixpfsyncer_review_listing_data_source" xsi:type="string">IXPF\Syncer\Model\ResourceModel\IxpfReview\Grid\Collection</item>
                <item name="ixpfsyncer_reviewgroup_listing_data_source" xsi:type="string">IXPF\Syncer\Model\ResourceModel\IxpfReviewGroup\Grid\Collection</item>
                -->
            </argument>
        </arguments>
    </type>


</config>
