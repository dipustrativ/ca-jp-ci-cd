<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Event/etc/events.xsd">
    <event name="sales_order_save_after">
        <observer name="ixpf_syncer_order_save_webhook" instance="IXPF\Syncer\Observer\OrderSaveWebhook" />
    </event>
    <event name="sales_order_invoice_save_after">
        <observer name="ixpf_syncer_invoice_save_webhook" instance="IXPF\Syncer\Observer\InvoiceSaveWebhook" />
    </event>
    <event name="sales_order_shipment_save_after">
        <observer name="ixpf_syncer_shipment_save_webhook" instance="IXPF\Syncer\Observer\ShipmentSaveWebhook" />
    </event>
    <event name="sales_order_creditmemo_save_after">
        <observer name="ixpf_syncer_creditmemo_save_webhook" instance="IXPF\Syncer\Observer\CreditmemoSaveWebhook" />
    </event>
    <event name="customer_save_after">
        <observer name="ixpf_syncer_customer_save_webhook" instance="IXPF\Syncer\Observer\CustomerSaveWebhook" />
    </event>
</config>
