+const none = "'none'"
+
+// frameAncestors builds the CSP source list from configuration, dropping anything that is not a
+// plain scheme://host[:port] origin.
+//
+// The values land verbatim in a response header, so a stray space or semicolon would let a bad
+// config value append directives to the policy. Rejecting instead of escaping keeps the failure
+// obvious: a malformed entry means that storefront cannot embed, never a weakened policy.
+func frameAncestors() string {
+	configured := config.SysConfig.GetReviewFrameAncestors()
+	valid := make([]string, 0, len(configured))
+	for _, origin := range configured {
+		if isFrameAncestor(origin) {
+			valid = append(valid, origin)
+		}
+	}
+	if len(valid) == 0 {
+		return none
+	}
+	return strings.Join(valid, " ")
+}
+
+// isFrameAncestor accepts http(s)://host, an optional :port, and a leading "*." wildcard label.
+func isFrameAncestor(origin string) bool {
+	host, ok := strings.CutPrefix(origin, "https://")
+	if !ok {
+		// http is allowed so a local storefront can be tested; production lists https only.
+		if host, ok = strings.CutPrefix(origin, "http://"); !ok {
+			return false
+		}
+	}
+	if host == "" || strings.ContainsAny(host, " \t;,'\"/\\") {
+		return false
+	}
+	if h, port, found := strings.Cut(host, ":"); found {
+		if n, err := strconv.Atoi(port); err != nil || n < 1 || n > 65535 {
+			return false
+		}
+		host = h
+	}
+	host = strings.TrimPrefix(host, "*.")
+	return host != "" && !strings.Contains(host, "*")
+}
+
+// allowedParent echoes back the ?parent= origin when it is one we allow to embed us.
+//
+// The form cannot discover its parent on its own: reading the parent's location is blocked
+// cross-origin, and the Referrer-Policy above deliberately strips the referrer. So the embedder
+// declares it and we check it, rather than trusting it - postMessage must target one origin, and
+// posting to a "*" or to an unverified value would hand the frame's messages to any page that
+// managed to embed it.
+func allowedParent(c *gin.Context) string {
+	parent := strings.TrimRight(strings.TrimSpace(c.Query("parent")), "/")
+	if parent == "" || !isFrameAncestor(parent) {
+		return ""
+	}
+	for _, allowed := range config.SysConfig.GetReviewFrameAncestors() {
+		if strings.EqualFold(allowed, parent) || matchesWildcard(allowed, parent) {
+			return parent
+		}
+	}
+	return ""
+}
+
+// matchesWildcard resolves a "https://*.example.com" entry against a concrete origin. One label
+// only, matching how CSP host wildcards behave: *.example.com covers a.example.com but not
+// a.b.example.com, and the scheme has to match too.
+func matchesWildcard(pattern, origin string) bool {
+	patternScheme, patternHost, ok := strings.Cut(pattern, "://")
+	if !ok || !strings.HasPrefix(patternHost, "*.") {
+		return false
+	}
+	originScheme, originHost, ok := strings.Cut(origin, "://")
+	if !ok || !strings.EqualFold(patternScheme, originScheme) {
+		return false
+	}
+	suffix := strings.ToLower(strings.TrimPrefix(patternHost, "*"))
+	originHost = strings.ToLower(originHost)
+	if !strings.HasSuffix(originHost, suffix) {
+		return false
+	}
+	label := strings.TrimSuffix(originHost, suffix)
+	return label != "" && !strings.Contains(label, ".")
+}
+
 func newNonce() string {
 	b := make([]byte, 16)
 	_, _ = rand.Read(b)
