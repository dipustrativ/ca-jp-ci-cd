diff --git a/internal/reviews/public/security_frame_test.go b/internal/reviews/public/security_frame_test.go
new file mode 100644
index 000000000..2e455078c
--- /dev/null
+++ b/internal/reviews/public/security_frame_test.go
@@ -0,0 +1,114 @@
+package public
+
+import (
+	"net/http/httptest"
+	"strings"
+	"testing"
+
+	"github.com/gin-gonic/gin"
+	"github.com/indexon/ixpf-ng/internal/config"
+)
+
+// The form is only embeddable because of these headers, and the failure mode is silent: a
+// storefront that is not on the list shows the customer a blank box, not an error. So the list
+// and the parent echo are worth pinning down.
+
+func TestIsFrameAncestor(t *testing.T) {
+	valid := []string{
+		"https://www.carpetavenue.de",
+		"http://de-m246.carpetavenue.devs",
+		"https://*.carpetavenue.net",
+		"https://localhost:8443",
+	}
+	for _, origin := range valid {
+		if !isFrameAncestor(origin) {
+			t.Errorf("expected %q to be a valid frame ancestor", origin)
+		}
+	}
+
+	invalid := []string{
+		"",
+		"carpetavenue.de",       // no scheme
+		"ftp://carpetavenue.de", // wrong scheme
+		"https://a.de; script-src 'unsafe-inline'", // header injection
+		"https://a.de/path",                        // path is not part of an origin
+		"https://a.de:notaport",
+		"https://*.*.carpetavenue.de",
+	}
+	for _, origin := range invalid {
+		if isFrameAncestor(origin) {
+			t.Errorf("expected %q to be rejected", origin)
+		}
+	}
+}
+
+func TestFrameAncestorsFallsBackToNone(t *testing.T) {
+	defer restoreConfig(config.SysConfig.ReviewFrameAncestors)
+
+	config.SysConfig.ReviewFrameAncestors = nil
+	if got := frameAncestors(); got != none {
+		t.Errorf("empty config: got %q, want %q", got, none)
+	}
+
+	// One bad entry must not weaken the policy for the rest, and an all-bad list must close.
+	config.SysConfig.ReviewFrameAncestors = []string{"https://a.de; frame-ancestors *", "https://b.de"}
+	if got := frameAncestors(); got != "https://b.de" {
+		t.Errorf("mixed config: got %q, want %q", got, "https://b.de")
+	}
+}
+
+func TestSecurityHeadersDropsXFrameOptionsWhenFramingAllowed(t *testing.T) {
+	defer restoreConfig(config.SysConfig.ReviewFrameAncestors)
+	gin.SetMode(gin.TestMode)
+
+	config.SysConfig.ReviewFrameAncestors = []string{"https://www.carpetavenue.de"}
+	rec := httptest.NewRecorder()
+	c, _ := gin.CreateTestContext(rec)
+	c.Request = httptest.NewRequest("GET", "/r/token", nil)
+	securityHeadersMW(c)
+
+	if xfo := rec.Header().Get("X-Frame-Options"); xfo != "" {
+		t.Errorf("X-Frame-Options must be absent when an allowlist exists, got %q", xfo)
+	}
+	if csp := rec.Header().Get("Content-Security-Policy"); !strings.Contains(csp, "frame-ancestors https://www.carpetavenue.de;") {
+		t.Errorf("allowlist missing from CSP: %s", csp)
+	}
+
+	config.SysConfig.ReviewFrameAncestors = nil
+	rec = httptest.NewRecorder()
+	c, _ = gin.CreateTestContext(rec)
+	c.Request = httptest.NewRequest("GET", "/r/token", nil)
+	securityHeadersMW(c)
+
+	if rec.Header().Get("X-Frame-Options") != "DENY" {
+		t.Error("X-Frame-Options must stay when nobody may embed")
+	}
+}
+
+func TestAllowedParent(t *testing.T) {
+	defer restoreConfig(config.SysConfig.ReviewFrameAncestors)
+	gin.SetMode(gin.TestMode)
+
+	config.SysConfig.ReviewFrameAncestors = []string{"https://www.carpetavenue.de", "http://*.carpetavenue.devs"}
+
+	cases := map[string]string{
+		"https://www.carpetavenue.de":          "https://www.carpetavenue.de",
+		"https://www.carpetavenue.de/":         "https://www.carpetavenue.de", // trailing slash tolerated
+		"http://de-m246.carpetavenue.devs":     "http://de-m246.carpetavenue.devs",
+		"https://evil.example":                 "", // not on the list
+		"http://a.b.carpetavenue.devs":         "", // wildcard is one label only
+		"https://www.carpetavenue.de.evil.tld": "", // suffix trick
+		"":                                     "",
+	}
+	for parent, want := range cases {
+		c, _ := gin.CreateTestContext(httptest.NewRecorder())
+		c.Request = httptest.NewRequest("GET", "/r/token?parent="+parent, nil)
+		if got := allowedParent(c); got != want {
+			t.Errorf("parent %q: got %q, want %q", parent, got, want)
+		}
+	}
+}
+
+func restoreConfig(previous []string) {
+	config.SysConfig.ReviewFrameAncestors = previous
+}
