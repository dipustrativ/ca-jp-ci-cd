@@ -1,3 +1,68 @@
+(function () {
+  'use strict';
+
+  /*
+   * Height reporting for the embedded form.
+   *
+   * Its own IIFE, first in the file: the form logic below returns early on every page that has
+   * no upload input, which is exactly the done and gone pages - the short ones the frame has to
+   * shrink for. Sharing a scope with it silently disabled resizing on those pages.
+   *
+   * The storefront frames this page on its own domain and cannot measure a cross-origin frame,
+   * so it sizes the frame from what we send here. With nothing sent the frame keeps whatever
+   * height the storefront guessed, which is a scrollbar inside a scrollbar on a phone.
+   *
+   * data-parent is only populated when the server recognised ?parent= as an origin allowed to
+   * embed us, so an arbitrary value in the link cannot make this page talk to a stranger. That
+   * check is the reason we post to a concrete origin instead of '*': a '*' target would hand
+   * these messages, and anything later added to them, to any page that managed to frame us.
+   */
+  var parentOrigin = document.body.dataset.parent;
+
+  if (parentOrigin && window.parent !== window) {
+    var lastHeight = 0;
+
+    var reportHeight = function () {
+      /*
+       * body's box, not documentElement.scrollHeight: the parent sets the frame's height, so
+       * documentElement is at least that tall and measuring it would report our own frame back
+       * to us - the frame could then only ever grow. The thank-you step is much shorter than
+       * the form, so shrinking has to work.
+       */
+      var height = Math.ceil(document.body.getBoundingClientRect().bottom);
+      if (height > 0 && height !== lastHeight) {
+        lastHeight = height;
+        window.parent.postMessage({ type: 'review-height', height: height }, parentOrigin);
+      }
+    };
+
+    window.addEventListener('load', reportHeight);
+    window.addEventListener('resize', reportHeight);
+
+    // Photo thumbnails, validation messages and step changes all resize the page after load.
+    if (window.ResizeObserver) {
+      new ResizeObserver(reportHeight).observe(document.body);
+    }
+
+    /*
+     * Answer the parent asking.
+     *
+     * The parent's listener is loaded asynchronously, so our load-time message usually arrives
+     * before anything over there is listening. Without this reply the first paint of every
+     * visit sits at the storefront's fallback height.
+     */
+    window.addEventListener('message', function (event) {
+      if (event.origin === parentOrigin && event.data && event.data.type === 'review-height-request') {
+        lastHeight = 0;
+        reportHeight();
+      }
+    });
+
+    reportHeight();
+  }
+
+})();
+
