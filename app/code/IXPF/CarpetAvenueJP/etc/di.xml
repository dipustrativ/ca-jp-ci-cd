<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">

<!--    <type name="Magento\Framework\DB\Adapter\Pdo\Mysql">-->
<!--        <plugin name="log_sql_queries" type="IXPF\Carpetavenue\Plugin\DbQueryLogger"/>-->
<!--    </type>-->

    <!-- Adds the CarpetAvenue 'ready_for_handling' action to the IXPF Syncer bulk-action endpoint -->
    <type name="IXPF\Syncer\Controller\V1\Orders\BulkAction">
        <plugin name="ixpf_carpetavenue_bulk_ready_for_handling"
                type="IXPF\CarpetAvenueJP\Plugin\Syncer\Orders\BulkActionReadyForHandling"/>
    </type>

    <!-- Cost written straight to EAV (IXPF bulk endpoints) fires no save event,
         so jpy_lowest_sale_price is recalculated here instead. -->
    <type name="Magento\Catalog\Model\ResourceModel\Product\Action">
        <plugin name="ixpf_carpetavenuejp_recalculate_jpy_lowest_sale_price"
                type="IXPF\CarpetAvenueJP\Plugin\Catalog\RecalculateJpyLowestSalePrice"/>
    </type>

</config>
