<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Event/etc/events.xsd">
    <event name="sales_model_service_quote_submit_before">
        <observer name="add_en_names_to_jp_order"
                  instance="Evalent\CheckoutModsJP\Observer\PlaceOrder"/>
    </event>

    <!-- Restrict payment methods to the cart button the customer picked -->
    <event name="payment_method_is_active">
        <observer name="jp_one_step_payment_restriction"
                  instance="Evalent\CheckoutModsJP\Observer\OneStepPaymentRestriction"/>
    </event>

    <!-- Fill missing shipping fields from billing, then strip HTML/script from address fields -->
    <event name="checkout_submit_before">
        <observer name="jp_shipping_address_validation"
                  instance="Evalent\CheckoutModsJP\Observer\ShippingAddressValidation"/>
        <observer name="jp_sanitize_address_fields"
                  instance="Evalent\CheckoutModsJP\Observer\SanitizeAddressFields"/>
    </event>
</config>
