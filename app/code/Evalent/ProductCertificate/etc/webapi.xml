<?xml version="1.0"?>

<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Webapi:etc/webapi.xsd">
    <route url="/V1/orders/:orderId/certificates" method="GET">
        <service class="Evalent\ProductCertificate\Api\CertificateGenerationInterface" method="execute"/>
        <resources>
            <resource ref="Magento_Sales::sales_operation" />
        </resources>
    </route>
</routes>
