if(!function_exists('scaledProductImage')){
  function scaledProductImage($imageUrl){
    $size = getimagesize($imageUrl);
    $width = $size[0];
    $heigth = $size[1];
    $ratio = $heigth / $width;
    if($ratio > 2) {
      $adjustedHeight = (round(200 * 2));
      $ratio = 2;
    } else {
      $adjustedHeight = (round(200 * $ratio));
    }
    $html = '<img src="'.$imageUrl.'" alt="Product Image" ';
    $offsetNeg = round((200*$ratio-200)/2);
    $imgHeight = 200;
    if($heigth > $width){
        $imgHeight = round(200 * $ratio);
        $html .= ' width="auto" height="'.($imgHeight).'" style="transform: rotate(90deg); margin-top:-'.$offsetNeg.'px; margin-bottom:-'.$offsetNeg.'px"';
    } else {
      $html .= ' width="auto" height="'.$imgHeight.'"';
    }
    $html .= '>';
    return $html;
  }
}

