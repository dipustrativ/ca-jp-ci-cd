<?xml version="1.0"?>
<page layout="1column" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
	<body>
		<referenceContainer name="content">
			<referenceBlock name="product.info.details">
				<block as="productcontactform" class="Evalent\ProductContactForm\Block\ProductContactForm" group="detailed_info" name="productcontactform" template="Evalent_ProductContactForm::productcontactform.phtml" ifconfig="catalog/contact_form/enabled">
					<arguments>
						<argument translate="true" name="title" xsi:type="string">Contact</argument>
						<argument name="sort_order" xsi:type="string">90</argument>
					</arguments>
					<container name="form.additional.info" as="form_additional_info">
                        <block class="Magento\Captcha\Block\Captcha" ifconfig="catalog/contact_form/recaptcha_enabled" name="captcha" after="-" cacheable="false">
                            <action method="setFormId">
                                <argument name="formId" xsi:type="string">user_productcontactform</argument>
                            </action>
                            <action method="setImgWidth">
                                <argument name="width" xsi:type="string">230</argument>
                            </action>
                            <action method="setImgHeight">
                                <argument name="width" xsi:type="string">50</argument>
                            </action>
                        </block>
                    </container>
				</block>
			</referenceBlock>
		</referenceContainer>
        <referenceBlock name="head.components">
            <block class="Magento\Framework\View\Element\Js\Components" name="captcha_page_head_components" template="Magento_Captcha::js/components.phtml"/>
        </referenceBlock>
	</body>
</page>
