$storeCode = $block->getStoreCode();
$dialCode = $storeCode;

switch ($storeCode) {
    case "en":
        $dialCode = "gb";
        break;

    case "ch_de":
    case "ch_fr":
        $dialCode = "ch";
        break;
}
?>

