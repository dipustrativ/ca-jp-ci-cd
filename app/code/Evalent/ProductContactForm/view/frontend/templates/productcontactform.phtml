    <script>

        require([
            'jquery'
        ], function ($) {

            $('form#contact-form').on("submit", function (e) {
                var dialCodeVal = $('#contact-form .iti__selected-dial-code').text();
                $("#product_contact_form_dialcode").val(dialCodeVal);


                // Validate reCaptcha
                if ($('form#contact-form').find('.field-recaptcha').length && window.grecaptcha && window.grecaptcha.render) {
