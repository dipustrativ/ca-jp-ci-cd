?>
<div class="design_theme_ua_regexp" id="grid<?= /* @escapeNotVerified */
$_htmlId ?>">
    <div class="custom_grid admin__control-table-wrapper" id="custom_grid<?php echo $_htmlId ?>">
        <table class="admin__control-table" id="<?= /* @escapeNotVerified */
        $block->getElement()->getId() ?>">
            <thead>
            <tr class="headings" id="headings<?php echo $_htmlId ?>">
                <?php foreach ($block->getColumns() as $columnName => $column): ?>
                    <th><?= /* @escapeNotVerified */
                        $column['label'] ?></th>
                <?php endforeach; ?>
                <th class="col-actions" colspan="<?= /* @escapeNotVerified */
                $_colspan ?>"><?= /* @escapeNotVerified */
                    __('Action') ?></th>
            </tr>
            </thead>
            <tbody id="addRow<?= /* @escapeNotVerified */
            $_htmlId ?>"></tbody>
            <tfoot>
            <tr>
                <td colspan="12"></td>
                <td <?php echo $_colspan ?> class="col-actions-add">
                    <button id="addToEndBtn<?= /* @escapeNotVerified */
                    $_htmlId ?>" class="action-add" title="<?= /* @escapeNotVerified */
                    __('Add') ?>" type="button">
                        <span><?= /* @escapeNotVerified */
                            $block->getAddButtonLabel() ?></span>
