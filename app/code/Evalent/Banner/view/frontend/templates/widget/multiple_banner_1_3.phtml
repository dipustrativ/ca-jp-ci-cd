<?php

use \Evalent\Banner\Api\Data\BannerInterface;

/** @var \Evalent\Banner\Block\Widget\MultipleBanner $block   */

/** @var \Evalent\Banner\Api\Data\BannerItemInterface[] $bannerItems */
$bannerItems = $block->getBanners();
$_bannerDisplayMode = $block->getDisplayMode();
$_bannerGutterDesktop = $block->getData('gutter_desktop');
$_bannerGutterMobile = $block->getData('gutter_mobile');
$_bannerMarginTopDesktop = $block->getData('margin_top_desktop');
$_bannerMarginBottomDesktop = $block->getData('margin_bottom_desktop');
$_bannerMarginTopMobile = $block->getData('margin_top_mobile');
$_bannerMarginBottomMobile = $block->getData('margin_bottom_mobile');

?>


<div class="ev-banners ev-banners--custom-multiple row ev-banners-display--<?= $_bannerDisplayMode ? $_bannerDisplayMode : 'default' ?> row-gutter--desktop--<?= $_bannerGutterDesktop ?> row-gutter--mobile--<?= $_bannerGutterMobile ?> margin-top--desktop--<?= $_bannerMarginTopDesktop ?> margin-bottom--desktop--<?= $_bannerMarginBottomDesktop ?> margin-top--mobile--<?= $_bannerMarginTopMobile ?> margin-bottom--mobile--<?= $_bannerMarginBottomMobile ?>">
    <?php foreach ($bannerItems as $bannerItem): ?>
        <?php
        /**
         * @var \Evalent\Banner\Api\Data\BannerItemInterface $bannerItem
         * @var \Evalent\Banner\Model\Data\Banner $banner
         */
        $banner = $bannerItem->getBanner();
        $_bannerButtonContentTheme = $banner->getButtonContentTheme();
        $_bannerButtonStyle = $banner->getButtonStyle();
        $_bannerHeading = $banner->getHeading();
        $_bannerDescription = $banner->getDescription();
        $_bannerButtonText = $banner->getButtonText();
        $_bannerLinkUrl = $banner->getBannerLinkUrl();
        $_bannerHeadingSecondary = $banner->getHeadingSecondary();
        $_bannerAnimation = $bannerItem->getAnimationEffect();
        $_bannerAlignDesktop = $banner->getContentAlignDesktop();
        $_bannerAlignMobile = $banner->getContentAlignMobile();
        $_bannerTextAlignDesktop = $banner->getTextAlignDesktop();
        $_bannerTextAlignMobile = $banner->getTextAlignMobile();
        $_bannerImageDesktop = $banner->getImageUrl(BannerInterface::DESKTOP_IMAGE);
        $_bannerImageMobile = $banner->getImageUrl(BannerInterface::MOBILE_IMAGE);
        $_bannerLinkNewWindow = $banner->getBannerLinkUrlNewWindow();
        $_bannerButtonEnabledDesktop = $banner->getButtonEnabledDesktop();
        $_bannerButtonEnabledMobile = $banner->getButtonEnabledMobile();
        $_bannerHeadingSizeDesktop = $banner->getHeadingSizeDesktop();
        $_bannerHeadingSizeMobile = $banner->getHeadingSizeMobile();
        $_bannerHeadingTag = $banner->getHeadingTag();
        $_bannerBottomColor = $banner->getContentCustomColor();
        // Set default heading tag if empty
        if(!isset($_bannerHeadingTag) || empty($_bannerHeadingTag)): $_bannerHeadingTag = "h2"; endif;
        ?>
        <div class="ev-banners--custom-multiple__banner col-xs-12 col-sm-<?= $bannerItem->getColumn() ?>" onclick="window.location='<?= $_bannerLinkUrl ?>';"
             style="cursor:pointer;">

            <div class="ev-banner__image-card">

                <picture>
                    <?php if($_bannerImageMobile !== null): ?>
                        <source media="(max-width: 768px)" srcset="<?= $_bannerImageMobile ?>">
                    <?php endif; ?>

                    <?php if($_bannerImageDesktop !== null): ?>
                        <source media="(min-width: 769px)" srcset="<?= $_bannerImageDesktop ?>">
                        <img src="<?= $_bannerImageDesktop ?>" alt="Banner image">
                    <?php endif; ?>
                </picture>

                <div class="ev-banner__overlay-content">
                    <div class="text-content">
                        <?php if($_bannerHeading): ?>
                            <<?= $_bannerHeadingTag ?> class="ev-banners__content__main-title size--desktop--<?= $_bannerHeadingSizeDesktop ?> size--mobile--<?= $_bannerHeadingSizeMobile ?>">
                            <?= $_bannerHeading ?>
                        </<?= $_bannerHeadingTag ?>>
                        <?php endif; ?>
                    </div>

                    <div class="bottom-banner" style="<?= !empty($_bannerBottomColor) ?  'background-color: '. $_bannerBottomColor: ''?>">
                        <div class="ev-banner__secondary-heading">
                            <strong><?= $_bannerHeadingSecondary ?></strong>
                        </div>

                        <div class="subtitle">
                            <?php if($_bannerDescription): ?>
                                <span class="ev-banners__content__description">
                                    <?= $_bannerDescription ?>
                                </span>
                            <?php endif; ?>

                            <?php if(!empty($_bannerButtonText)):?>
                                <a style="margin-right: 35px" class="ev-banners__content__button <?= !$_bannerButtonEnabledDesktop ? 'hidden-m' : '' ?> <?= !$_bannerButtonEnabledMobile ? 'hidden-xs' : '' ?>" href="<?= $_bannerLinkUrl ? $_bannerLinkUrl : '#' ?>" target="<?= $_bannerLinkNewWindow === '1' ? '_blank' : '_self' ?>">
                                    <span>
                                        <?= $_bannerButtonText ?>
                                    </span>
                                </a>
                            <?php endif; ?>
                        </div>
                    </div>

                </div>
            </div>

        </div>
    <?php endforeach;?>
</div>




