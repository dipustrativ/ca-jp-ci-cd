<script>
    require(['jquery'], function ($) {
        'use strict';

        function buildAivzGrid() {
            var $container = $('.mz-gallery-container').first();
            if (!$container.length) {
                console.log('[aivz-grid] no .mz-gallery-container yet');
                return false;
            }
            // already built? bail
            if ($container.next('.mz-aivz-grid').length) return true;

            var images = window.mzGalleryData || [];
            if (!images.length) {
                console.log('[aivz-grid] mzGalleryData empty');
                return false;
            }

            var picks = [];
            images.forEach(function (img) {
                var t = img.thumb || img.img || img.full || '';
                if (t.indexOf('_aivz') !== -1) picks.push(img);
            });

            console.log('[aivz-grid] picks found:', picks.length);
            if (!picks.length) return true; // nothing to show, but we're "done"

            var isMobileGrid = window.innerWidth <= 768;

            // If mobile and only 1 AIVZ image, fill second slot with a non-AIVZ image (exclude first image and AIVZ)
            if (isMobileGrid && picks.length === 1) {
                var aivzUrl = picks[0].full || picks[0].img || picks[0].thumb || '';
                for (var i = 1; i < images.length; i++) {
                    var t = images[i].thumb || images[i].img || images[i].full || '';
                    // Only add non-AIVZ images that don't match the AIVZ image URL
                    if (t.indexOf('_aivz') === -1 && t !== aivzUrl) {
                        picks.push(images[i]);
                        break;
                    }
                }
            }

            if (isMobileGrid) { picks = picks.slice(0, 2); }

            // Snapshot full gallery at build time — immune to later mzGalleryData changes
            var gallerySnapshot = images.slice();

            var $grid = $('<div class="mz-aivz-grid"></div>');
            // Store snapshot on grid element so click handler never needs window.mzGalleryData
            $grid.data('aivz-gallery', gallerySnapshot);

            $.each(picks, function (i, img) {
                var src     = img.thumb || img.img || img.full;
                var fullSrc = img.full  || img.img || img.thumb;

                // Resolve gallery index at build time — reliable, no race condition at click
                var imgKey = (fullSrc + '').split('/').pop().split('?')[0];
                var galleryIndex = -1;
                for (var j = 0; j < gallerySnapshot.length; j++) {
                    var s = (gallerySnapshot[j].full || gallerySnapshot[j].img || gallerySnapshot[j].thumb || '') + '';
                    if (s.indexOf(imgKey) !== -1) { galleryIndex = j; break; }
                }

                $('<a class="mz-aivz-grid__item" href="javascript:void(0)" role="button"></a>')
                    .attr('data-full', fullSrc)
                    .attr('data-index', galleryIndex)
                    .css('background-image', 'url("' + src + '")')
                    .appendTo($grid);
            });

            // IMPORTANT: insert AFTER the gallery container, not inside it.
            $container.after($grid);

            $grid.on('click', '.mz-aivz-grid__item', function () {
                var $item       = $(this);
                var $g          = $item.closest('.mz-aivz-grid');
                var gallery     = $g.data('aivz-gallery') || window.mzGalleryData || [];
                var targetIndex = parseInt($item.attr('data-index'), 10);

                if (isNaN(targetIndex) || targetIndex < 0) return;

                // Primary: open fancybox directly at targetIndex — no flash, works all devices
                if ($.fancybox && typeof $.fancybox.open === 'function') {
                    var items = [];
                    $.each(gallery, function (i, img) {
                        items.push({ src: img.full || img.img || img.thumb, type: 'image' });
                    });
                    $.fancybox.open(items, {
                        loop: false,
                        thumbs: {
                            autoStart: true,
                            axis: window.innerWidth <= 768 ? 'x' : 'y'
                        },
                        buttons: ['slideShow', 'fullScreen', 'close']
                    }, targetIndex);
                    return;
                }

                // Fallback: navigate slick to target slide instantly, then trigger click
                var $sliderD = $('[data-gallery-role="gallery-placeholder"] .slick-initialized').first();
                if ($sliderD.length) {
                    $sliderD.slick('slickGoTo', targetIndex, true);
                }
                $(document).one('afterShow.fb', function (e, instance) {
                    if (instance.current && instance.current.index !== targetIndex) {
                        instance.jumpTo(targetIndex, 0);
                    }
                });
                var $targetSlide = $('[data-gallery-role="gallery-placeholder"] .slick-slide:not(.slick-cloned)[data-slick-index="' + targetIndex + '"]');
                var $triggerEl = $targetSlide.find('a[data-fancybox]').first();
                if (!$triggerEl.length) {
                    $triggerEl = $('[data-gallery-role="gallery-placeholder"] .slick-slide:not(.slick-cloned) a[data-fancybox]').first();
                }
                if (!$triggerEl.length) {
                    $triggerEl = $('[data-gallery-role="gallery-placeholder"] a').first();
                }
                if ($triggerEl.length) {
                    $triggerEl[0].click();
                }
            });

            return true;
        }

        $(function () {
            var tries = 0;
            var t = setInterval(function () {
                if (buildAivzGrid() || tries++ > 30) clearInterval(t);
            }, 200);
        });

        // Rebuild only on meaningful width changes
        var lastWidth = window.innerWidth;
        $(window).on('resize', function () {
            if (Math.abs(window.innerWidth - lastWidth) > 80) {
                lastWidth = window.innerWidth;
                $('.mz-aivz-grid').remove();
                buildAivzGrid();
            }
        });
    });
</script>
