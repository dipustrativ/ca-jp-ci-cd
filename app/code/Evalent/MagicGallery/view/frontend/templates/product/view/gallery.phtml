<script>
    require(['jquery'], function ($) {
        'use strict';

        function initMobileCounter() {
            var $slider = $('.mz-gallery-container .slick-initialized').first();
            if (!$slider.length) return false;
            if ($slider.data('mob-counter-init')) return true;
            $slider.data('mob-counter-init', true);

            var total = $slider.find('.slick-slide:not(.slick-cloned)').length;
            if (total <= 1) return true;

            var $counter = $('<div class="mz-slide-counter">1 / ' + total + '</div>');
            // Overlay on the main image itself (not below the thumb strip).
            $slider.append($counter);

            $slider.on('afterChange.mobcounter', function (e, slick, current) {
                $counter.text((current + 1) + ' / ' + total);
            });

            return true;
        }

        $(function () {
            var tries = 0;
            var t = setInterval(function () {
                if (initMobileCounter() || tries++ > 40) clearInterval(t);
            }, 200);
        });
    });
</script>


