<script>
    require(['jquery'], function ($) {
        'use strict';

        var $aivz = null;
        var $aivzStyle = null; // track injected <style>

        function injectStyles() {
            if ($aivzStyle) return; // already injected
            $aivzStyle = $('<style id="fancybox-aivz-style">\
            @media (min-width: 769px) {\
                .fancybox-aivz-thumbs {\
                    position: absolute;\
                    top: 0;\
                    right: 3px;\
                    bottom: 0;\
                    background: #fff;\
                    z-index: 99995;\
                    margin: 0; padding: 0;\
                }\
                .fancybox-aivz-thumbs__list {\
                    display: flex;\
                    flex-direction: column;\
                    height: 100%;\
                    overflow-y: auto;\
                    overflow-x: hidden;\
                    margin: 0; padding: 0;\
                    list-style: none;\
                    scrollbar-width: none;\
                    -ms-overflow-style: none;\
                }\
                .fancybox-aivz-thumbs__list::-webkit-scrollbar { display: none; }\
                .fancybox-aivz-thumbs__list a {\
                    display: block;\
                    width: 160px;\
                    height: 160px;\
                    margin: 5px auto;\
                    background-size: cover;\
                    background-position: center;\
                    cursor: pointer;\
                    outline: 2px solid transparent;\
                    outline-offset: -2px;\
                    transition: opacity .2s, outline-color .2s;\
                }\
                .fancybox-aivz-thumbs__list a:hover { opacity: 1; }\
                .fancybox-aivz-thumbs__list a.fancybox-thumbs-active {\
                    opacity: 1;\
                    outline-color: #ff0066;\
                }\
                .fancybox-toolbar {\
                    right: 55px;\
                }\
                .fancybox-has-aivz-thumbs .fancybox-navigation .fancybox-button--arrow_right { right: 50px; }\
            }\
            @media (max-width: 768px) {\
                .fancybox-aivz-thumbs { display: none !important; }\
            }\
        </style>').appendTo('head');
        }
        function removeStyles() {
            if ($aivzStyle) { $aivzStyle.remove(); $aivzStyle = null; }
        }

        function getImages() {
            var data = window.mzGalleryData;
            if (!data || !data.length) return [];
            return $.map(data, function (item) {
                return { thumb: item.thumb || item.img || item.full };
            });
        }

        function build(instance) {
            if ($aivz || !instance) return;
            var images = getImages();
            if (!images.length) return;

            var $container = instance.$refs && instance.$refs.container;
            if (!$container || !$container.length) return;

            $aivz = $('<div class="fancybox-aivz-thumbs"><ul class="fancybox-aivz-thumbs__list"></ul></div>');
            var $list = $aivz.find('ul');

            $.each(images, function (i, img) {
                // check if thumb contains "_aivz"
                if (img.thumb && img.thumb.indexOf('_aivz') !== -1) {
                    $('<a href="javascript:;"></a>')
                        .attr('data-index', i)
                        .css('background-image', 'url("' + img.thumb + '")')
                        .appendTo($list);
                }
            });

            // ← NEW: if no _aivz thumbs exist, abort — don't mount the rail at all
            if (!$list.children().length) {
                $aivz = null;
                return;
            }

            // Only inject CSS when we know we actually need the rail
            injectStyles();

            $aivz.on('click', 'a', function () {
                var idx = parseInt($(this).attr('data-index'), 10);
                var inst = $.fancybox.getInstance();
                if (inst) inst.jumpTo(idx);
            });

            $container.append($aivz).addClass('fancybox-has-aivz-thumbs');
        }

        function setActive(index) {
            if (!$aivz) return;
            var $links = $aivz.find('a').removeClass('fancybox-thumbs-active');
            var $active = $links.filter('[data-index="' + index + '"]').addClass('fancybox-thumbs-active');
            if (!$active.length) return;

            var $list  = $aivz.find('ul');
            var listH  = $list.height();
            var itemTop = $active.position().top;
            var itemH  = $active.outerHeight();
            $list.stop().animate({
                scrollTop: $list.scrollTop() + itemTop - (listH / 2) + (itemH / 2)
            }, 200);
        }

        function destroy() {
            if ($aivz) { $aivz.remove(); $aivz = null; }
            $('.fancybox-container').removeClass('fancybox-has-aivz-thumbs');
            removeStyles(); // ← also pull the <style> out of <head>
        }

        $(document)
            .on('afterShow.fb', function (e, instance, current) {
                build(instance);
                setActive(current.index);
            })
            .on('beforeClose.fb', function () {
                destroy();
            });
    });
</script>
