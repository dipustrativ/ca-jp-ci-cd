    </type>

    <type name="Magento\Sales\Block\Adminhtml\Order\View">
        <plugin name="addButtonsToOrder" type="Evalent\OrderMods\Plugin\AddButtonsToOrder"/>
    </type>

    <type name="Magento\Sales\Model\Service\OrderService">
        <plugin name="evalent_order_mods_order_service" type="Evalent\OrderMods\Plugin\Model\Services\OrderService"/>
