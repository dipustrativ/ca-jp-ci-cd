<?php
 /** @var \Evalent\OrderMods\Block\Adminhtml\Items\Column\Thumbnail $block */
    $imageUrl = $block->getImageUrl();

    $_product = $block->getProduct();

    $sizeValue = '';

    if (isset($_product)) {
        // ∅ when w == l, else W x L cm — see Data::formatSize
        $sizeValue = $this->helper(\CarpetAvenue\Productify\Helper\Data::class)->formatSize(
            $_product->getData('width'),
            $_product->getData('length'),
            $_product->getData('shape')
        );
    }
?>

<?php if (isset($_product)): ?>
<img class="admin__control-thumbnail" src="<?= $imageUrl ?>" />
<div class="admin__control-thumbnail-additional">
    <span><?= $sizeValue ?></span>
</div>
<?php endif; ?>
