<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceBlock name="order_items">
            <arguments>
                <argument name="columns" xsi:type="array">
                    <item name="product_weight" xsi:type="string" translate="true">Weight</item>
                    <item name="product_thumbnail" xsi:type="string" translate="true">Thumbnail</item>
                    <item name="product_pallet" xsi:type="string" translate="true">Pallet</item>
                </argument>
            </arguments>
            <referenceBlock name="default_order_items_renderer">
                <arguments>
                    <argument name="columns" xsi:type="array">
                        <item name="product_weight" xsi:type="string" translate="true">col-product_wight</item>
                        <item name="product_thumbnail" xsi:type="string" translate="true">col-product_thumbnail</item>
                        <item name="product_pallet" xsi:type="string" translate="true">col-product_pallet</item>
                    </argument>
                </arguments>
            </referenceBlock>

            <block class="Evalent\OrderMods\Block\Adminhtml\Items\Column\Weight"
                   name="column_product_weight"
                   template="Evalent_OrderMods::order/item/weight.phtml" group="column" />
            <block class="Evalent\OrderMods\Block\Adminhtml\Items\Column\Thumbnail"
                   name="column_product_thumbnail"
                   template="Evalent_OrderMods::order/item/thumbnail.phtml" group="column" />
            <block class="Evalent\OrderMods\Block\Adminhtml\Items\Column\Pallet"
                   name="column_product_pallet"
                   template="Evalent_OrderMods::order/item/pallet.phtml" group="column" />
        </referenceBlock>

        <referenceBlock name="order_info" template="Evalent_OrderMods::order/view/info.phtml">

        </referenceBlock>
        <referenceBlock name="order_tab_info">
            <action method="setTemplate">
                <argument name="template" xsi:type="string">Evalent_OrderMods::view/tab/info.phtml</argument>
            </action>
        </referenceBlock>
    </body>
</page>
