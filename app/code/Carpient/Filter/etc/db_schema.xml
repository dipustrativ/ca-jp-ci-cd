<?xml version="1.0"?>
<!--
/**
 * Carpient_Filter — per-attribute-option image storage.
 * One image per eav attribute option; file lives under
 * pub/media/evattribute/option/, this table holds the pointer.
 */
-->
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="carpient_filter_option_image" resource="default" engine="innodb" comment="Attribute Option Image">
        <column xsi:type="int" name="entity_id" unsigned="true" nullable="false" identity="true" comment="Entity ID"/>
        <column xsi:type="int" name="option_id" unsigned="true" nullable="false" comment="EAV Attribute Option ID"/>
        <column xsi:type="varchar" name="image" nullable="true" length="255" comment="Image path relative to media"/>
        <column xsi:type="timestamp" name="created_at" on_update="false" nullable="false" default="CURRENT_TIMESTAMP" comment="Created At"/>
        <column xsi:type="timestamp" name="updated_at" on_update="true" nullable="false" default="CURRENT_TIMESTAMP" comment="Updated At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
        <constraint xsi:type="unique" referenceId="CARPIENT_FILTER_OPTION_IMAGE_OPTION_ID">
            <column name="option_id"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="CARPIENT_FILTER_OPTION_IMAGE_OPTION_ID_EAV_ATTR_OPT_OPTION_ID"
                    table="carpient_filter_option_image" column="option_id"
                    referenceTable="eav_attribute_option" referenceColumn="option_id" onDelete="CASCADE"/>
    </table>
</schema>
