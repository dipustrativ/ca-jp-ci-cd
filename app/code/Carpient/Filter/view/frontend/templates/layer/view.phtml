<?php
/**
 * Copyright © Carpient. All rights reserved.
 *
 * Horizontal filter bar with inline dropdown panels (carpient.com reference).
 * Each attribute renders as a toggle button; clicking it opens a panel below
 * holding that filter's options (reused CarpetAvenue_Productify renderer)
 * plus an Apply button. Multiselect staging, live count and Apply are driven by
 * the shared filter-ajax widget (batch mode) — this template is markup only.
 *
 * @var \Magento\LayeredNavigation\Block\Navigation $block
 * @var \Magento\Framework\Escaper $escaper
 */
?>
<?php if ($block->canShowBlock()): ?>
    <?php
    $filters = $block->getFilters();
    $activeFilters = $block->getLayer()->getState()->getFilters();
    $filtered = count($activeFilters);
    ?>
    <div class="block filter carpient-filter"
         id="layered-filter-block"
         data-mage-init='{"carpientFilterDropdown": {}}'>
        <?php /* Mobile only: opens the filter drawer. filter-dropdown.js relocates
                 this button into the product toolbar so it sits beside Magento's
                 Sort By select, matching the carpient.com mobile bar. It moves
                 because it is ours and its handler is delegated from document —
                 never move the core sorter, productListToolbarForm binds that one
                 by descending from .toolbar-products at init time. */ ?>
        <button type="button"
                class="carpient-filter__open"
                aria-expanded="false"
                aria-controls="layered-filter-bar">
            <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
                <path d="M2 5h8M15 5h1M2 13h2M9 13h7" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
                <circle cx="12.5" cy="5" r="2.2" stroke="currentColor" stroke-width="1.4"/>
                <circle cx="6.5" cy="13" r="2.2" stroke="currentColor" stroke-width="1.4"/>
            </svg>
            <span><?= $escaper->escapeHtml(__('Filter')) ?></span>
        </button>

        <div class="block-content filter-content carpient-filter__bar" id="layered-filter-bar">
            <div class="carpient-filter__drawerhead">
                <button type="button" class="carpient-filter__close"
                        aria-label="<?= $escaper->escapeHtmlAttr(__('Close')) ?>">
                    <svg width="10" height="16" viewBox="0 0 10 16" fill="none" aria-hidden="true">
                        <path d="M8.5 1L1.5 8l7 7" stroke="currentColor" stroke-width="1.6"
                              stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                </button>
                <span class="carpient-filter__drawertitle"><?= $escaper->escapeHtml(__('Filter')) ?></span>
                <?php if ($filtered): ?>
                    <?php /* .filter-clear is what filter-ajax binds its clear handler to. */ ?>
                    <a href="<?= $escaper->escapeUrl($block->getClearUrl()) ?>"
                       class="carpient-filter__clearall filter-clear"><?= $escaper->escapeHtml(__('Clear all')) ?></a>
                <?php endif; ?>
            </div>
            <?php $i = 0; ?>
            <?php foreach ($filters as $filter): ?>
                <?php if ($filter->getItemsCount()): ?>
                    <div class="carpient-filter__group" data-filter-group="<?= (int) $i ?>">
                        <button type="button"
                                class="carpient-filter__toggle"
                                aria-haspopup="true"
                                aria-expanded="false">
                            <span class="carpient-filter__toggle-label"><?= $escaper->escapeHtml(__($filter->getName())) ?></span>
                            <svg class="carpient-filter__caret" width="10" height="7" viewBox="0 0 10 7" fill="none" aria-hidden="true">
                                <path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                        </button>
                        <div class="carpient-filter__panel" data-role="content" hidden>
                            <div class="carpient-filter__options">
                                <?= /* @noEscape */ $block->getChildBlock('renderer')->render($filter) ?>
                            </div>
                            <div class="carpient-filter__apply-wrap">
                                <button type="button" class="carpient-filter__apply am-apply-filters">
                                    <span><?= $escaper->escapeHtml(__('Apply')) ?></span>
                                    <span class="am-items"></span>
                                </button>
                            </div>
                        </div>
                    </div>
                    <?php $i++; ?>
                <?php endif; ?>
            <?php endforeach; ?>

            <div class="carpient-filter__showwrap">
                <button type="button" class="carpient-filter__show am-apply-close">
                    <span><?= $escaper->escapeHtml(__('Show Rugs')) ?></span>
                    <span class="am-items"></span>
                </button>
            </div>
        </div>

        <?php if ($filtered): ?>
            <div class="carpient-filter__state filter-state-bar">
                <span class="carpient-filter__statelabel"><?= $escaper->escapeHtml(__('Filter')) ?></span>
                <?= $block->getChildHtml('state') ?>
                <a href="<?= $escaper->escapeUrl($block->getClearUrl()) ?>"
                   class="action clear filter-clear carpient-filter__clear">
                    <span><?= $escaper->escapeHtml(__('Clear all')) ?></span>
                </a>
            </div>
        <?php endif; ?>
    </div>
<?php endif; ?>
