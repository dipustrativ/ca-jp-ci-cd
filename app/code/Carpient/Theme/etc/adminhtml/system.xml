<?xml version="1.0"?>
<!--
/**
 * Carpient_Theme — storefront settings.
 */
-->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <section id="carpient" translate="label" type="text" sortOrder="900" showInDefault="1" showInWebsite="1" showInStore="1">
            <label>Carpient Theme</label>
            <tab>general</tab>
            <resource>Magento_Config::config</resource>
            <group id="cart" translate="label" type="text" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Cart</label>
                <field id="enable_drawer" translate="label comment" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Show cart in a slide-out drawer</label>
                    <comment>Yes: cart items open in a slide-out navigation drawer. No: keep the default dropdown minicart.</comment>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
            </group>
        </section>
    </system>
</config>
