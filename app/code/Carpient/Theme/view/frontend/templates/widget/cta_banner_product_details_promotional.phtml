    .ev-pdp-promo__grid--no-media .reading-width {
        margin-left: auto;
        margin-right: auto;
    }
    .ev-pdp-promo .section__block {
        margin: 0 0 22px;
    }
    .ev-pdp-promo .section__block:last-child {
        margin-bottom: 0;
    }
    .ev-pdp-promo .section__block--heading .h3 {
        margin: 0;
        font-weight: 600;
        line-height: 1.3;
        font-size: clamp(2rem, 0.83vw + 1.69rem, 2.96rem);
    }
    .ev-pdp-promo .reading-width {
        max-width: 48em;
    }
    .ev-pdp-promo .enlarge-text {
        font-size: 2.25rem;
        font-weight: 500;
        line-height: 1.5;
    }
    .ev-pdp-promo .reading-width p:last-child {
        margin-bottom: 0;
    }
    .ev-pdp-promo__btn {
        display: inline-block;
        margin: 0;
        padding: 12px 26px;
        border: 1px solid #000;
        border-radius: 5px;
        font-size: 1.4rem;
        font-weight: 700;
        line-height: 1.2;
        text-decoration: none;
        transition: opacity 0.15s ease;
    }
    .ev-pdp-promo__btn:hover {
        opacity: 0.88;
