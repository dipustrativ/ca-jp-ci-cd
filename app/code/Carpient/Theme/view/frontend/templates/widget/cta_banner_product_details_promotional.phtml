        aspect-ratio: 653 / 339;
    }
    .ev-pdp-promo__media picture {
        display: block;
        width: 100%;
        height: 100%;
    }
    .ev-pdp-promo__img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
    }
    .ev-pdp-promo__content {
        flex: 1 1 auto;
    }
