# CarpetAvenue JP — PRODUCTION environment: APP stack (docker-compose.dokploy.yml)
# Paste into Dokploy -> this stack -> Environment. DO NOT commit real values.
# The image reads these at runtime via getenv() -> app/etc/env.php; no rebuild to change one.
#
# mysql / opensearch / rabbitmq are SHARED stacks in Workspace/DOCKER-GLOBAL/.
# Deploy them first, and create this app's database + vhost. See docker/SHARED-INFRA.md.

# Image. NGINX_TAG is a SEPARATE sequence from IMAGE_TAG (nginx is rebuilt only when its
# config changes), so never assume they match. `latest` leaves it unrollbackable.
REGISTRY_HOST=registry.carpetavenue.net
IMAGE_TAG=latest
NGINX_TAG=latest

# Also set in Dokploy -> Domains (Traefik). Magento uses it for downloadable_domains.
DOMAIN=playground.carpetavenue.jp

# MySQL 8.4 — container name, NOT host port 3308. Every app connects as root, so
# DB_PASSWORD is exactly the mysql stack's MYSQL_ROOT_PASSWORD. `carpetavenue_jp` is created by
# hand, utf8mb4 (DOCKER-GLOBAL/README.md §4).
DB_HOST=mysql:3306
DB_NAME=carpetavenue_jp
DB_USER=root
DB_PASSWORD=CHANGE_ME_SAME_AS_MYSQL_ROOT_PASSWORD

# Valkey 9, in THIS stack. cache db0 + page_cache db1; sessions get their own instance
# so catalog churn can't evict a live cart. Switching to `sessions` signs everyone out
# ONCE. Both share VALKEY_PASSWORD. evicted_keys must stay 0 — raise with host RAM.
VALKEY_HOST=cache
VALKEY_PORT=6379
VALKEY_PASSWORD=
VALKEY_MAXMEMORY=512mb
VALKEY_SESSION_HOST=sessions
VALKEY_SESSION_PORT=6379
VALKEY_SESSION_MAXMEMORY=128mb

# RabbitMQ — SHARED broker, this app's own vhost + user, created by hand before the
# first deploy (DOCKER-GLOBAL/README.md §5). Named vhost, never `/`.
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=ca_jp
RABBITMQ_PASSWORD=CHANGE_ME_DIFFERENT_FROM_CARPIENT
RABBITMQ_VHOST=/ca_jp

# OpenSearch — SHARED cluster. `search` was the old in-stack name and resolves to nothing.
# INDEX_PREFIX must be UNIQUE per install: same prefix = the two installs overwrite each
# other's indices and each reindex wipes the other store. Was `ca_jp_stage` — on an existing
# install, reindex then drop the orphans:  curl -X DELETE opensearch:9200/ca_jp_stage_*
OPENSEARCH_HOST=opensearch
OPENSEARCH_PORT=9200
OPENSEARCH_INDEX_PREFIX=ca_jp

# MAGE_CRYPT_KEY MUST equal the crypt/key of the DB it decrypts, or config and payment
# data won't decrypt. Fresh DB => its own generated key.
MAGE_CRYPT_KEY=CHANGE_ME_PROD_CRYPT_KEY
MAGE_GRAPHQL_ID_SALT=CHANGE_ME_PROD_GRAPHQL_SALT
DEBUG_ENV=false

# Backups: the shared mysql stack dumps every database nightly — nothing to set here.
# Media is NOT backed up (full tar every run). Leave COMPOSE_PROFILES EMPTY; the value
# is `media-backup`, not `backup`, so pasting the mysql stack's value can't start a
# nightly full upload. Only set it for a deliberate one-off snapshot.
COMPOSE_PROFILES=
BACKUP_GCS_BUCKET=CHANGE_ME_GCS_BUCKET_NAME
BACKUP_GCS_HMAC_KEY=CHANGE_ME_GCS_HMAC_ACCESS_KEY
BACKUP_GCS_HMAC_SECRET=CHANGE_ME_GCS_HMAC_SECRET
BACKUP_RETENTION_DAYS=14
BACKUP_MEDIA_CRON=30 3 * * *
