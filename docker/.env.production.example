# CarpetAvenue JP — PRODUCTION environment: APP stack (docker-compose.dokploy.yml)
#
# Paste into Dokploy -> this stack -> Environment (bulk .env paste works), or copy to
# docker/.env for a plain server. DO NOT commit real values. The image reads these at
# runtime via getenv() -> app/etc/env.php, so changing one is a restart, not a rebuild.
#
# mysql / opensearch / rabbitmq are SHARED stacks in Workspace/DOCKER-GLOBAL/. Deploy
# them first and create this app's database + vhost. See docker/SHARED-INFRA.md.
#
# Every EXAMPLE_ONLY_ value below is deliberately non-working. Replace these five:
#   DB_PASSWORD  RABBITMQ_PASSWORD  MAGE_CRYPT_KEY  MAGE_GRAPHQL_ID_SALT  VALKEY_PASSWORD

# ── Image ─────────────────────────────────────────────────────────────────────
# NGINX_TAG is a SEPARATE sequence from IMAGE_TAG (nginx is rebuilt only when its own
# config changes), e.g. IMAGE_TAG=v13 with NGINX_TAG=v5. Never assume they match.
# `latest` deploys fine but cannot be rolled back — pin v<N> for anything you may revert.
REGISTRY_HOST=registry.carpetavenue.net
IMAGE_TAG=latest
NGINX_TAG=latest

# ── Domain ────────────────────────────────────────────────────────────────────
# Must match Dokploy -> Domains (Traefik). Magento uses it for downloadable_domains.
# No scheme, no trailing slash.
DOMAIN=playground.carpetavenue.jp

# Path A (plain server) only — host port nginx publishes. Path B publishes nothing;
# Traefik routes by domain. Co-hosting two Path A stacks: the second needs a different
# port, since both would want :80.
HTTP_PORT=80

# ── MySQL 8.4 — SHARED stack, container `mysql` ───────────────────────────────
# Container name over dokploy-network, NOT host port 3308 (that is for tunnelled
# clients). Every app connects as root, so DB_PASSWORD is exactly the mysql stack's
# MYSQL_ROOT_PASSWORD. `carpetavenue_jp` is created by hand, utf8mb4 (DOCKER-GLOBAL/README.md §4).
DB_HOST=mysql:3306
DB_NAME=carpetavenue_jp
DB_USER=root
DB_PASSWORD=EXAMPLE_ONLY_same_value_as_the_mysql_stacks_MYSQL_ROOT_PASSWORD

# ── Valkey 9 — in THIS stack ──────────────────────────────────────────────────
# `cache` holds cache db0 + page_cache db1; `sessions` is a second instance (db2) so
# catalog cache churn cannot evict a live cart. Both share VALKEY_PASSWORD — there is
# no VALKEY_SESSION_PASSWORD.
# Empty password = no AUTH. Fine while both stay on the private magento_net; set one if
# anything else can reach them:  openssl rand -base64 24 | tr -d '/+='
# Switching sessions from `cache` to `sessions` signs every customer out ONCE.
# `valkey-cli info stats | grep evicted_keys` must stay 0 — raise with host RAM only.
VALKEY_HOST=cache
VALKEY_PORT=6379
VALKEY_PASSWORD=
VALKEY_MAXMEMORY=512mb
VALKEY_SESSION_HOST=sessions
VALKEY_SESSION_PORT=6379
VALKEY_SESSION_MAXMEMORY=128mb

# ── RabbitMQ 4.2 — SHARED broker, container `rabbitmq` ────────────────────────
# This app's own vhost + user, created by hand before the first deploy
# (DOCKER-GLOBAL/README.md §5). A NAMED vhost, never `/`.
# The broker's RABBITMQ_DEFAULT_* only bootstrap an EMPTY volume, so on an existing
# broker this user exists only if you created it. Password must match exactly.
#   generate:  openssl rand -base64 24 | tr -d '/+='
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=ca_jp
RABBITMQ_PASSWORD=EXAMPLE_ONLY_Tk4pR9wZ2mQ7xB5nL8sVc3Hd
RABBITMQ_VHOST=/ca_jp

# ── OpenSearch 3 — SHARED cluster, container `opensearch` ─────────────────────
# `search` was the old in-stack name and now resolves to nothing. Heap is set in the
# opensearch stack, not here.
#
# INDEX_PREFIX must be UNIQUE per install: the same prefix on one cluster means the two
# installs overwrite each other's indices and each reindex wipes the other store.
# This app `ca_jp`, the other `carpient`. Was `ca_jp_stage` — on an existing
# install, reindex then drop the orphans:
#   docker exec opensearch curl -XDELETE "localhost:9200/ca_jp_stage_*"
OPENSEARCH_HOST=opensearch
OPENSEARCH_PORT=9200
OPENSEARCH_INDEX_PREFIX=ca_jp

# ── Magento secrets ───────────────────────────────────────────────────────────
# MAGE_CRYPT_KEY MUST equal the crypt/key of the database it decrypts — copy it from
# that install's app/etc/env.php before you retire the old host. Wrong key = config and
# payment credentials decrypt to garbage, silently. Format is the literal string
# "base64" followed by base64, no separator.
#   fresh DB:  php -r 'echo "base64", base64_encode(random_bytes(32)), PHP_EOL;'
MAGE_CRYPT_KEY=base64EXAMPLE_ONLY_replace_with_the_key_that_encrypted_this_db=

# Any long random string; changing it invalidates cached GraphQL ids.
#   generate:  openssl rand -base64 32 | tr -d '/+='
MAGE_GRAPHQL_ID_SALT=EXAMPLE_ONLY_aB3dE5gH7jK9mN1pQ3rS5tU7vW9xY1zA

# `true` dumps the resolved environment at container start. Never in production.
DEBUG_ENV=false

# ── Backups ───────────────────────────────────────────────────────────────────
# The DATABASE is backed up by the shared mysql stack (nightly --all-databases -> GCS).
# It covers this database automatically; nothing to set here.
#
# MEDIA is NOT backed up. Leave COMPOSE_PROFILES EMPTY. The value that would enable it
# is `media-backup`, not `backup`, precisely so pasting the mysql stack's value in here
# cannot start a nightly full upload. Only set it for a deliberate one-off snapshot;
# `offen/docker-volume-backup` writes a FULL tar every run, so it re-uploads every
# unchanged byte. Right tool is `gsutil -m rsync -r` (docker/README.md §11).
#
# The keys below are only read when the profile is on. GCS uses its S3-interoperability
# HMAC pair, NOT a service-account JSON:
#   GCS Console -> Cloud Storage -> Settings -> Interoperability -> Create a key
COMPOSE_PROFILES=
BACKUP_GCS_BUCKET=EXAMPLE_ONLY_carpetavenue-backups
BACKUP_GCS_HMAC_KEY=EXAMPLE_ONLY_GOOG1EEXAMPLEACCESSKEY
BACKUP_GCS_HMAC_SECRET=EXAMPLE_ONLY_gcs_hmac_secret_40_chars
BACKUP_RETENTION_DAYS=14
BACKUP_MEDIA_CRON=30 3 * * *
