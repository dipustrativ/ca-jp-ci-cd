# ──────────────────────────────────────────────────────────────────────────────
# CarpetAvenue JP — PRODUCTION environment: ca_jp APP stack (docker-compose.dokploy.yml)
#
# DO NOT commit real values. Copy these keys into Dokploy → App → Environment
# (bulk .env paste supported). Dokploy persists them per-app across redeploys.
# The image reads them at runtime via getenv() → app/etc/env.php. No rebuild
# needed to change any value here.
#
# MySQL, OpenSearch and RabbitMQ are SHARED with carpient and live in
# Workspace/DOCKER-GLOBAL/. Deploy those three first. See docker/SHARED-INFRA.md.
# Deploy order: mysql -> opensearch -> rabbitmq -> app stacks.
# ──────────────────────────────────────────────────────────────────────────────

# Image (external authed registry — Dokploy PULLS, never builds on server)
REGISTRY_HOST=registry.carpetavenue.net
IMAGE_TAG=latest

# nginx image tag. SEPARATE SEQUENCE from IMAGE_TAG — the nginx image is rebuilt
# only when nginx config changes, so its number lags far behind the app's
# (e.g. IMAGE_TAG=v13 alongside NGINX_TAG=v5). Never assume they match.
# Unset defaults to `latest`, which leaves nginx unpinned and unrollbackable.
NGINX_TAG=latest

# Public domain — also managed in Dokploy → Domains (Traefik). Used by Magento
# for downloadable_domains / base checks.
DOMAIN=playground.carpetavenue.jp

# ── MySQL 8.4 (SHARED stack, container mysql) ─────────────────────────────────
# Container name over dokploy-network. NOT host port 3308 (tunnelled clients only).
# Every app connects as root, so DB_PASSWORD is exactly the mysql stack's
# MYSQL_ROOT_PASSWORD. `carpetavenue_jp` is created BY HAND before the first deploy
# (DOCKER-GLOBAL/README.md §5) — utf8mb4, or the first Japanese character breaks it.
DB_HOST=mysql:3306
DB_NAME=carpetavenue_jp
DB_USER=root
DB_PASSWORD=CHANGE_ME_SAME_AS_MYSQL_ROOT_PASSWORD

# ── Valkey 9 (in-stack container `cache`) ─────────────────────────────────────
# Holds cache db0 + page_cache db1. Sized for an 8GB host; raise only with host
# RAM. `valkey-cli info stats | grep evicted_keys` must stay 0.
VALKEY_HOST=cache
VALKEY_PORT=6379
VALKEY_PASSWORD=
VALKEY_MAXMEMORY=512mb        # playground; 1gb+ when co-hosting stops being the constraint

# ── Valkey 9 sessions (in-stack container `sessions`) ─────────────────────────
# Separate instance so cache churn cannot evict a live cart. Leave unset to fall
# back to `cache`. Switching to `sessions` signs every customer out ONCE.
VALKEY_SESSION_HOST=sessions
VALKEY_SESSION_PORT=6379
VALKEY_SESSION_MAXMEMORY=128mb
# No VALKEY_SESSION_PASSWORD: both instances share VALKEY_PASSWORD.

# ── RabbitMQ 4.2 (SHARED stack, container rabbitmq) ───────────────────────────
# One broker, one vhost per application. Use a NAMED vhost, never `/` — `/` is the
# shared default and gives no isolation. Vhost + user are created by hand on the
# broker before the first deploy (DOCKER-GLOBAL/README.md §5); these must match.
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=ca_jp
RABBITMQ_PASSWORD=CHANGE_ME_DIFFERENT_FROM_CARPIENT
RABBITMQ_VHOST=/ca_jp

# ── OpenSearch 3 (SHARED stack, container opensearch) ─────────────────────────
# Container name. `search` was the old in-stack name and resolves to nothing.
# Heap is set in the opensearch stack, not here.
OPENSEARCH_HOST=opensearch
OPENSEARCH_PORT=9200

# UNIQUE PER APPLICATION. One cluster serves both Magento installs; identical
# prefixes mean they overwrite each other's indices and each reindex wipes the
# other store's catalog. carpient=carpient, ca_jp=ca_jp.
#
# WARNING on an EXISTING install: the old hardcoded value was `ca_jp_stage`, so
# switching to `ca_jp` abandons every ca_jp_stage_* index. Reindex right after
# deploying:  docker exec carpetavenue-jp-app php bin/magento indexer:reindex
# then drop the orphans:  curl -X DELETE opensearch:9200/ca_jp_stage_*
OPENSEARCH_INDEX_PREFIX=ca_jp

# ── Magento secrets ───────────────────────────────────────────────────────────
# MAGE_CRYPT_KEY MUST equal the key that encrypted the PRODUCTION DB
# (crypt/key in that DB's original env.php). Wrong key => config/payment data
# won't decrypt. Fresh DB => use its own generated key.
MAGE_CRYPT_KEY=CHANGE_ME_PROD_CRYPT_KEY
MAGE_GRAPHQL_ID_SALT=CHANGE_ME_PROD_GRAPHQL_SALT

# Never true in production
DEBUG_ENV=false

# ── Backups: media is EXCLUDED on purpose ─────────────────────────────────────
# Leave COMPOSE_PROFILES empty. The database IS backed up — by the shared mysql
# stack's --all-databases dump, which picks this database up automatically and
# needs nothing set here (DOCKER-GLOBAL/README.md §8).
#
# magento_media is not backed up: this tool writes a FULL tar every run, so it
# re-uploads every unchanged byte nightly. The answer is an incremental
# `rclone sync` / `gsutil -m rsync -r`, not this service. Until then media is
# unprotected — losing the volume means re-uploading every product image.
#
# Only set COMPOSE_PROFILES=media-backup for a deliberate one-off snapshot. The
# value is `media-backup`, NOT `backup`, precisely so pasting the mysql stack's
# value in here cannot silently start a nightly full upload.
COMPOSE_PROFILES=
BACKUP_GCS_BUCKET=CHANGE_ME_GCS_BUCKET_NAME
BACKUP_GCS_HMAC_KEY=CHANGE_ME_GCS_HMAC_ACCESS_KEY
BACKUP_GCS_HMAC_SECRET=CHANGE_ME_GCS_HMAC_SECRET
BACKUP_RETENTION_DAYS=14
BACKUP_MEDIA_CRON=30 3 * * *
