# NO static `upstream` block: with one, nginx resolves carpetavenue-jp-fpm AT STARTUP
# and EXITS if the app container isn't up yet ("host not found in upstream").
# Instead resolve fpm dynamically via Docker's embedded DNS (127.0.0.11) at
# request time — nginx always starts, and survives app restarts.

# SSL + domain routing handled upstream by Traefik (Dokploy Domain tab).
# Catch-all server_name — nginx serves whatever Host Traefik forwards.
server {
    listen 80 default_server;
    server_name _;

    resolver 127.0.0.11 valid=30s ipv6=off;
    set $fastcgi_backend "carpetavenue-jp-fpm:9000";

    client_max_body_size        100m;
    client_body_buffer_size     128k;
    client_header_buffer_size   1k;
    large_client_header_buffers 4 16k;

    set $MAGE_ROOT /var/www/html;
    set $MAGE_MODE production;

    # Must precede the include: prefix match beats the sample's `location /`.
    #
    # Rule: one client never holds more than HALF the pool. pm.max_children is 16
    # (docker/php/www.conf), so 8 here — the storefront always keeps 8 workers no
    # matter what an integration does. Re-derive this if max_children changes.
    #
    # Deliberately generous because IXPF Syncer is a heavy REST surface and bulk
    # calls legitimately run concurrently. This is not a throttle on normal use:
    # it only engages once ONE source has 8 requests in flight at the same instant,
    # which means responses are already overlapping — the exact failure it exists
    # for. Per-IP, so a real customer is never affected by the ERP's traffic.
    #
    # limit_conn works here despite the try_files hand-off: it runs in the
    # preaccess phase, before the internal redirect re-matches the .php location.
    # fastcgi_* would NOT — those are read in the final location, so a read_timeout
    # set here is silently dead. The hard bound on a stuck worker is
    # request_terminate_timeout in docker/php/www.conf, not anything in nginx.
    location /rest/ {
        limit_conn apiconn 8;
        try_files $uri $uri/ /index.php$is_args$args;
    }

    # Magento sample already sets `root $MAGE_ROOT/pub;` (document_root_is_pub=true)
    include /etc/nginx/magento.conf;
}
