<?php
/**
 * CarpetAvenue Magento env.php — runtime template.
 *
 * Baked into the image. entrypoint.sh copies this to app/etc/env.php on every
 * container start; it reads all config from env vars via getenv(), so no secrets
 * live in git or in an image layer. Change a value = change the env var + restart,
 * never a rebuild.
 *
 * Required env vars (Dokploy → App → Environment):
 *   DB_HOST DB_NAME DB_USER DB_PASSWORD              (MySQL 8.4 — external endpoint)
 *   VALKEY_HOST VALKEY_PORT VALKEY_PASSWORD          (Valkey 9)
 *   RABBITMQ_HOST RABBITMQ_PORT RABBITMQ_USER RABBITMQ_PASSWORD RABBITMQ_VHOST
 *   OPENSEARCH_HOST OPENSEARCH_PORT
 *   MAGE_CRYPT_KEY MAGE_GRAPHQL_ID_SALT
 *   DOMAIN
 */

$_db_host    = getenv('DB_HOST')             ?: 'db';
$_db_name    = getenv('DB_NAME')             ?: 'magento';
$_db_user    = getenv('DB_USER')             ?: 'magento';
$_db_pass    = getenv('DB_PASSWORD')         ?: '';
$_vk_host    = getenv('VALKEY_HOST')         ?: 'cache';
$_vk_port    = (int)(getenv('VALKEY_PORT')   ?: 6379);
$_vk_pass    = getenv('VALKEY_PASSWORD')     ?: '';
// Sessions have their own Valkey. Falls back to the cache instance when unset,
// so an older stack still boots. Password is deliberately shared with the cache
// instance: both sit on magento_net behind the same operator, and a separate
// session password could only ever desync from the --requirepass the sessions
// container actually enforces.
$_vks_host   = getenv('VALKEY_SESSION_HOST')     ?: $_vk_host;
$_vks_port   = (int)(getenv('VALKEY_SESSION_PORT') ?: $_vk_port);
$_mq_host    = getenv('RABBITMQ_HOST')       ?: 'queue';
$_mq_port    = (int)(getenv('RABBITMQ_PORT') ?: 5672);
$_mq_user    = getenv('RABBITMQ_USER')       ?: 'magento';
$_mq_pass    = getenv('RABBITMQ_PASSWORD')   ?: '';
$_mq_vhost   = getenv('RABBITMQ_VHOST')      ?: '/';
$_os_host    = getenv('OPENSEARCH_HOST')     ?: 'search';
$_os_port    = (int)(getenv('OPENSEARCH_PORT') ?: 9200);
$_crypt_key  = getenv('MAGE_CRYPT_KEY')      ?: 'base64B/lrHnrY8ffKPOv0jGTin1+Kv3pBjKsn08tB48Ym8uk=';
$_domain     = getenv('DOMAIN')              ?: 'carpetavenue.net';

return [
    'backend' => [
        'frontName' => 'admin',
    ],
    'remote_storage' => [
        'driver' => 'file',
    ],
    'crypt' => [
        'key' => $_crypt_key,
    ],
    'queue' => [
        'consumers_wait_for_messages' => 0,
        'amqp' => [
            'host'        => $_mq_host,
            'port'        => $_mq_port,
            'user'        => $_mq_user,
            'password'    => $_mq_pass,
            'virtualhost' => $_mq_vhost,
        ],
    ],
    // Message-queue consumers are started by the default cron group (`cron:run`),
    // so the single `cron` container drives them — no separate consumers service.
    // consumers => [] means "all consumers". Raise multiple_processes if async load grows.
    'cron_consumers_runner' => [
        'cron_run'            => true,
        'max_messages'        => 1000,
        'consumers'           => [],
        'multiple_processes'  => 1,
    ],
    'db' => [
        'table_prefix' => '',
        'connection' => [
            'default' => [
                'host'           => $_db_host,
                'dbname'         => $_db_name,
                'username'       => $_db_user,
                'password'       => $_db_pass,
                'model'          => 'mysql4',
                'engine'         => 'innodb',
                'initStatements' => 'SET NAMES utf8mb4;',
                'active'         => '1',
                'driver_options' => [1014 => false],
            ],
        ],
    ],
    'resource' => [
        'default_setup' => ['connection' => 'default'],
    ],
    'x-frame-options' => 'SAMEORIGIN',
    'MAGE_MODE' => 'production',
    'session' => [
        'save' => 'redis',
        'redis' => [
            'host'                  => $_vks_host,
            'port'                  => (string)$_vks_port,
            'password'              => $_vk_pass,
            'timeout'               => '2.5',
            'persistent_identifier' => '',
            'database'              => '2',
            'compression_threshold' => '2048',
            'compression_library'   => 'gzip',
            'log_level'             => '1',
            // Matches pm.max_children (docker/php/www.conf). At the Cm default
            // of 6, the 7th concurrent request for one session throws
            // ConcurrentConnectionsExceededException and the request dies —
            // seen in production with 20 FPM children. Raise both together.
            'max_concurrency'       => '20',
            'break_after_frontend'  => '5',
            'break_after_adminhtml' => '30',
            'first_lifetime'        => '600',
            'bot_first_lifetime'    => '60',
            'bot_lifetime'          => '7200',
            'disable_locking'       => '0',
            'min_lifetime'          => '60',
            'max_lifetime'          => '2592000',
        ],
    ],
    // 2.4.9: backend name must be one of SymfonyAdapterProvider::$adapterTypeMap
    // (redis, valkey, memcached, libmemcached, file, database, apc, apcu, two_levels,
    // twolevel). Anything else — 'Cm_Cache_Backend_Redis' included — silently becomes a
    // FILE cache in var/cache (SymfonyAdapterProvider.php:139); so does a failed
    // connection (:151). No error, no log. compress_data / compression_lib /
    // compress_threshold / use_lua are not read by this adapter.
    // Verify the live object after any change here — see docker/CACHE-RUNBOOK.md §0.
    'cache' => [
        'frontend' => [
            'default' => [
                'id_prefix'       => '69d_',
                'backend'         => 'redis',
                'backend_options' => [
                    'server'          => $_vk_host,
                    'port'            => $_vk_port,
                    'password'        => $_vk_pass,
                    'database'        => '0',
                    'serializer'      => 'igbinary',
                ],
            ],
            'page_cache' => [
                'id_prefix'       => '69d_',
                'backend'         => 'redis',
                'backend_options' => [
                    'server'          => $_vk_host,
                    'port'            => $_vk_port,
                    'password'        => $_vk_pass,
                    'database'        => '1',
                    'serializer'      => 'igbinary',
                ],
            ],
        ],
        'allow_parallel_generation' => false,
        'graphql' => [
            'id_salt' => getenv('MAGE_GRAPHQL_ID_SALT') ?: '32UGZGKwKzmYTR4BkZ2n78ecWnVejwwO',
        ],
    ],
    'search' => [
        'engine'                  => 'opensearch',
        'opensearch-host'         => $_os_host,
        'opensearch-port'         => $_os_port,
        'opensearch-enable-auth'  => '0',
        'opensearch-index-prefix' => 'magento2',
    ],
    // Lock search connection at the system level — OVERRIDES any stale
    // catalog/search/* rows in core_config_data (e.g. a host from another
    // environment). Guarantees the container's OPENSEARCH_HOST always wins.
    'system' => [
        'default' => [
            // Asset pipeline is a build concern, not a merchant setting — pinned
            // here so a DB restore can't switch minification back off. merge and
            // bundling stay OFF: both are a net loss over HTTP/2, and JS bundling
            // defeats the RequireJS lazy loading the theme relies on.
            'dev' => [
                'js' => [
                    'minify_files'       => '1',
                    'merge_files'        => '0',
                    'enable_js_bundling' => '0',
                ],
                'css' => [
                    'minify_files'    => '1',
                    'merge_css_files' => '0',
                ],
                // OFF, and it must stay off on this stack. With minify_html on,
                // production resolves every .phtml to
                // var/view_preprocessed/pub/static/<abs path> and only COMPUTES
                // that path — the minified copy is written by SCD, never on
                // demand (Magento generates it only in developer/default mode).
                // var/ is the persistent magento_var volume, which masks the
                // image's own var/, so the tree outlives every deploy: a new
                // image ships new templates that are never rendered (stale
                // markup against fresh CSS), and deleting the tree renders every
                // block empty — Template::fetchView() logs "Invalid template
                // file" and returns ''. Off, templates are read from the image
                // and are always the deployed ones. Gzip already recovers most
                // of what the minifier saved.
                'template' => [
                    'minify_html' => '0',
                ],
            ],
            'catalog' => [
                'search' => [
                    'engine'                      => 'opensearch',
                    'opensearch_server_hostname'  => $_os_host,
                    'opensearch_server_port'      => $_os_port,
                    'opensearch_index_prefix'     => 'magento2',
                    'opensearch_enable_auth'      => '0',
                    'opensearch_server_timeout'   => '15',
                ],
            ],
        ],
    ],
    'lock' => [
        'provider' => 'db',
        'config'   => ['prefix' => null],
    ],
    'directories' => [
        'document_root_is_pub' => true,
    ],
    // Only source of truth: State::isEnabled() reads `$statuses[$code] ?? false`, and
    // entrypoint.sh overwrites env.php on every container start, so an Admin toggle
    // survives neither a restart nor the other four containers. A cache.xml type missing
    // from this list shows DISABLED forever. Add new codes here — `cache:status` lists them.
    'cache_types' => [
        'config'                        => 1,
        'layout'                        => 1,
        'block_html'                    => 1,
        'collections'                   => 1,
        'reflection'                    => 1,
        'db_ddl'                        => 1,
        'compiled_config'               => 1,
        'eav'                           => 1,
        'customer_notification'         => 1,
        'config_integration'            => 1,
        'config_integration_api'        => 1,
        'graphql_query_resolver_result' => 1,
        'full_page'                     => 1,
        'config_webservice'             => 1,
        'translate'                     => 1,
        // Third-party / custom types (etc/cache.xml). Codes, not tags:
        'adyen'                         => 1, // Adyen\Payment  (tag ADYEN)
        'carpetavenue_top_menu_cache'   => 1, // Evalent\MegaMenu\Model\Cache\Type::TYPE_IDENTIFIER
    ],
    'downloadable_domains' => [$_domain],
    'install' => [
        'date' => 'Tue, 14 Jul 2026 06:16:07 +0000',
    ],
];
