# ──────────────────────────────────────────────────────────────────────────────
# CarpetAvenue Docker environment
# Copy to .env.local for local dev (gitignored).
# Production/staging: set these in Dokploy → App → Environment.
# ──────────────────────────────────────────────────────────────────────────────

# Registry + image (external, authed — run `docker login registry.carpetavenue.net` first)
REGISTRY_HOST=registry.carpetavenue.net
IMAGE_TAG=latest            # prod: latest | staging: staging | local: local

# nginx image tag. SEPARATE SEQUENCE from IMAGE_TAG — the nginx image is rebuilt
# only when nginx config changes, so its number lags far behind the app's
# (e.g. IMAGE_TAG=v13 alongside NGINX_TAG=v5). Never assume they match.
# Unset defaults to `latest`, which leaves nginx unpinned and unrollbackable.
NGINX_TAG=latest

# Domain
DOMAIN=carpetavenue.net     # staging: staging.carpetavenue.net | local: carpient.devs

# Database — MySQL 8.4 EXTERNAL endpoint (separate docker). Use its host/IP.
DB_HOST=mysql
DB_NAME=carpetavenue_prod
DB_USER=carpetavenue
DB_PASSWORD=change-me

# Valkey 9 (service name `cache`)
VALKEY_HOST=cache
VALKEY_PORT=6379
VALKEY_PASSWORD=

# RabbitMQ 4.2 (service name `queue`)
RABBITMQ_HOST=queue
RABBITMQ_PORT=5672
RABBITMQ_USER=magento
RABBITMQ_PASSWORD=change-me
RABBITMQ_VHOST=/

# OpenSearch 3 (service name `search`)
OPENSEARCH_HOST=search
OPENSEARCH_PORT=9200

# Magento secrets (must match the DB the image was built/installed against)
MAGE_CRYPT_KEY=base64B/lrHnrY8ffKPOv0jGTin1+Kv3pBjKsn08tB48Ym8uk=
MAGE_GRAPHQL_ID_SALT=32UGZGKwKzmYTR4BkZ2n78ecWnVejwwO

# Debug entrypoint env dump (never leave true in prod)
DEBUG_ENV=false

# ── Local-only (docker-compose.local.yml) ─────────────────────────────────────
MYSQL_ROOT_PASSWORD=change-me-root
